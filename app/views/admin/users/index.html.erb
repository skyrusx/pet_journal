<% content_for :title, "Пользователи — Управление PetJournal" %>
<% content_for :admin_title, "Пользователи" %>

<section class="admin-panel admin-catalog-panel">
  <%= form_with url: admin_users_path, method: :get, class: "admin-catalog-filter-form" do |form| %>
    <div class="admin-catalog-search-row">
      <%= form.label :q, "Поиск", class: "visually-hidden" %>
      <%= form.search_field :q, value: @query, placeholder: "Имя или email", autocomplete: "off" %>
      <%= form.submit "Найти", class: "admin-primary-button" %>
    </div>

    <div class="admin-catalog-filter-row">
      <%= form.select :role,
                      options_for_select([["Все роли", ""], ["Пользователи", "user"], ["Администраторы", "admin"]], @role_filter),
                      {}, class: "admin-filter-select" %>
      <%= form.select :activity,
                      options_for_select([["Любая активность", ""], ["За последние 7 дней", "7_days"], ["За последние 30 дней", "30_days"], ["Нет данных", "never"]], @activity_filter),
                      {}, class: "admin-filter-select" %>
      <% if @query.present? || @role_filter.present? || @activity_filter.present? %>
        <%= link_to "Сбросить", admin_users_path, class: "admin-secondary-button" %>
      <% end %>
      <span class="admin-catalog-count"><strong><%= number_with_delimiter(@total_users) %></strong> найдено</span>
    </div>
  <% end %>

  <%= render "list" %>
</section>
