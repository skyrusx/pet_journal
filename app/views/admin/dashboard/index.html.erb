<% content_for :title, "Обзор — Управление PetJournal" %>

<section class="admin-page admin-dashboard">
  <header class="admin-dashboard-hero">
    <div>
      <h1><%= admin_greeting %>, <%= admin_user_name(current_user) %>! <span aria-hidden="true">👋</span></h1>
      <p>Здесь главное о PetJournal и быстрый доступ к управлению сервисом.</p>
    </div>
    <time datetime="<%= Date.current.iso8601 %>"><%= admin_date_label %></time>
  </header>

  <div class="admin-stat-grid" aria-label="Основные показатели">
    <% [
      ["Пользователи", @stats[:users], :user],
      ["Питомцы", @stats[:pets], :paw],
      ["PetTag", @stats[:pet_tags], :tag]
    ].each do |label, metric, icon| %>
      <article class="admin-stat-card">
        <span class="admin-stat-icon"><%= pj_icon(icon) %></span>
        <div class="admin-stat-copy">
          <span class="admin-stat-label"><%= label %></span>
          <strong><%= number_with_delimiter(metric[:total], delimiter: " ") %></strong>
          <span class="admin-stat-trend admin-stat-trend--<%= admin_metric_change_tone(metric) %>">
            <b><%= admin_metric_change_label(metric) %></b>
            <small>за последние 7 дней</small>
          </span>
        </div>
      </article>
    <% end %>
  </div>

  <div class="admin-dashboard-grid">
    <section class="admin-panel admin-recent-panel">
      <div class="admin-panel-header">
        <div>
          <h2>Последние регистрации</h2>
        </div>
        <%= link_to admin_users_path, class: "admin-text-link" do %>
          <span>Все пользователи</span><span aria-hidden="true">→</span>
        <% end %>
      </div>

      <% if @recent_users.any? %>
        <div class="admin-recent-list">
          <% @recent_users.each do |user| %>
            <%= link_to admin_user_path(user), class: "admin-recent-user" do %>
              <%= render "admin/shared/avatar", user: user, size: :medium %>
              <span class="admin-recent-user-copy">
                <strong><%= admin_user_name(user) %></strong>
                <small><%= user.email %></small>
              </span>
              <time datetime="<%= user.created_at.iso8601 %>"><%= l(user.created_at, format: "%d.%m.%Y, %H:%M") %></time>
              <span class="admin-row-chevron" aria-hidden="true">›</span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="admin-empty-compact">Регистраций пока нет.</div>
      <% end %>
    </section>

    <section class="admin-panel admin-quick-panel">
      <div class="admin-panel-header">
        <div>
          <h2>Быстрые действия</h2>
        </div>
      </div>

      <div class="admin-quick-list">
        <%= link_to admin_users_path, class: "admin-quick-link" do %>
          <span class="admin-quick-icon"><%= pj_icon(:user) %></span>
          <span class="admin-quick-copy">
            <strong>Пользователи</strong>
            <small>Просмотр и поиск пользователей</small>
          </span>
          <span class="admin-row-chevron" aria-hidden="true">→</span>
        <% end %>

        <%= link_to root_path, class: "admin-quick-link" do %>
          <span class="admin-quick-icon"><%= pj_icon(:home) %></span>
          <span class="admin-quick-copy">
            <strong>PetJournal</strong>
            <small>Вернуться в пользовательскую часть</small>
          </span>
          <span class="admin-row-chevron" aria-hidden="true">→</span>
        <% end %>
      </div>
    </section>
  </div>
</section>
