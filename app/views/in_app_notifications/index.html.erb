<% content_for :title, "Уведомления — PetJournal" %>

<div class="pj-inbox-page">
  <header class="pj-workspace-topbar">
    <h1>Уведомления</h1>
    <%= render "shared/workspace_notification_link" %>
  </header>

  <div class="pj-inbox-content">
    <div class="pj-inbox-heading">
      <p>Напоминания и важные события остаются здесь, даже если внешний канал не смог их доставить.</p>

      <% if @unread_count.positive? %>
        <%= button_to mark_all_read_notifications_path,
                      method: :patch,
                      class: "pj-inbox-mark-all" do %>
          Отметить всё прочитанным
        <% end %>
      <% end %>
    </div>

    <div class="pj-inbox-toolbar">
      <span class="pj-inbox-unread-pill">
        <strong><%= @unread_count %></strong>
        <%= russian_plural(@unread_count, "непрочитанное", "непрочитанных", "непрочитанных") %>
      </span>

      <%= link_to notification_channels_path, class: "pj-inbox-settings-link" do %>
        <%= pj_icon(:settings) %>
        <span>Настройки уведомлений</span>
      <% end %>
    </div>

    <%= form_with url: notifications_path, method: :get, class: "pj-inbox-filters" do |form| %>
      <div class="pj-inbox-filter pj-inbox-filter--search">
        <span aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="5.75"/><path d="m15 15 4.25 4.25"/></svg>
        </span>
        <%= form.search_field :q,
                              value: @query,
                              placeholder: "Поиск по уведомлениям",
                              aria: { label: "Поиск по уведомлениям" } %>
      </div>

      <div class="pj-inbox-filter">
        <%= select_tag :status,
                       options_for_select(
                         [["Все статусы", "all"], ["Непрочитанные", "unread"], ["Прочитанные", "read"]],
                         @selected_status
                       ),
                       aria: { label: "Статус уведомления" } %>
      </div>

      <div class="pj-inbox-filter">
        <%= select_tag :type,
                       options_for_select(
                         [["Все типы", "all"], ["Напоминания", "reminder"], ["PetTag", "pet_tag"]],
                         @selected_type
                       ),
                       aria: { label: "Тип уведомления" } %>
      </div>

      <button type="submit" class="pj-inbox-filter-submit">
        <span>Применить</span>
      </button>

      <% if @has_filters %>
        <%= link_to "Сбросить", notifications_path, class: "pj-inbox-filter-reset" %>
      <% end %>
    <% end %>

    <% if @notifications.any? %>
      <div class="pj-inbox-table-wrap">
        <div class="pj-inbox-table-head">
          <span>Событие</span>
          <span>Детали</span>
          <span>Тип</span>
          <span>Дата и время</span>
          <span>Статус</span>
          <span></span>
        </div>

        <% @notifications.each do |notification| %>
          <% notification_type = notification.kind.start_with?("pet_tag") ? "PetTag" : "Напоминание" %>
          <%= link_to notification_path(notification),
                      class: class_names("pj-inbox-row", unread: !notification.read?) do %>
            <span class="pj-inbox-row__event">
              <span class="pj-inbox-row__icon" aria-hidden="true">
                <%= notification.kind.start_with?("pet_tag") ? pj_icon(:tag) : pj_icon(:alarm) %>
              </span>
              <span>
                <strong><%= notification.title %></strong>
                <% if notification.metadata["note"].present? %>
                  <small><%= truncate(notification.metadata["note"], length: 54) %></small>
                <% end %>
              </span>
            </span>

            <span class="pj-inbox-row__detail"><%= notification.body.presence || "—" %></span>
            <span><%= notification_type %></span>
            <time datetime="<%= notification.occurred_at.iso8601 %>"><%= in_app_notification_time_label(notification) %></time>
            <span>
              <em class="pj-inbox-status <%= notification.read? ? "is-read" : "is-unread" %>">
                <%= notification.read? ? "Прочитано" : "Новое" %>
              </em>
            </span>
            <span class="pj-inbox-row__chevron"><%= pj_icon(:chevron) %></span>
          <% end %>
        <% end %>
      </div>

      <div class="pj-inbox-mobile-list">
        <% @notifications.each do |notification| %>
          <% notification_type = notification.kind.start_with?("pet_tag") ? "PetTag" : "Напоминание" %>
          <%= link_to notification_path(notification),
                      class: class_names("pj-inbox-mobile-card", unread: !notification.read?) do %>
            <span class="pj-inbox-mobile-card__icon" aria-hidden="true">
              <%= notification.kind.start_with?("pet_tag") ? pj_icon(:tag) : pj_icon(:alarm) %>
            </span>
            <span class="pj-inbox-mobile-card__body">
              <small><%= notification_type %> · <%= in_app_notification_time_label(notification) %></small>
              <strong><%= notification.title %></strong>
              <% if notification.body.present? %><span><%= notification.body %></span><% end %>
              <em class="pj-inbox-status <%= notification.read? ? "is-read" : "is-unread" %>">
                <%= notification.read? ? "Прочитано" : "Новое" %>
              </em>
            </span>
            <span class="pj-inbox-mobile-card__chevron"><%= pj_icon(:chevron) %></span>
          <% end %>
        <% end %>
      </div>

      <% if @has_more %>
        <div class="pj-inbox-load-more">
          <%= link_to notifications_path(request.query_parameters.merge("page" => @page + 1)), class: "pj-inbox-load-more__button" do %>
            <span>Показать ещё</span>
            <small><%= [@total_count - @limit, InAppNotificationsController::PAGE_SIZE].min %> уведомлений</small>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <section class="pj-inbox-empty">
        <span><%= pj_icon(:bell) %></span>
        <h2><%= @has_filters ? "Ничего не найдено" : "Уведомлений пока нет" %></h2>
        <p><%= @has_filters ? "Попробуйте изменить параметры поиска или фильтры." : "Здесь появятся напоминания и важные события PetJournal." %></p>
      </section>
    <% end %>
  </div>
</div>
