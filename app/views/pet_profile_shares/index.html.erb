<% content_for :title, "Публичный доступ — PetJournal" %>

<div class="pj-public-access-page">
  <header class="pj-workspace-topbar">
    <h1>Публичный доступ</h1>
    <%= render "shared/workspace_notification_link" %>
  </header>

  <div class="pj-public-access-content">
    <div class="pj-public-access-intro">
      <div>
        <p>Безопасно делитесь выбранными данными питомца по отдельной ссылке.</p>
      </div>
      <%= link_to new_pet_profile_share_path(@pet), class: "pj-public-access-primary" do %>
        <%= pj_icon(:plus) %>
        <span>Создать доступ</span>
      <% end %>
    </div>

    <% if @pet_choices.many? %>
      <nav class="pj-public-access-pets" aria-label="Выбор питомца">
        <% @pet_choices.each do |pet| %>
          <%= link_to pet_profile_shares_path(pet),
                      class: class_names("pj-public-access-pet", "is-active": pet == @pet),
                      aria: { current: pet == @pet ? "page" : nil } do %>
            <span class="pj-public-access-pet__avatar">
              <% if pet.photo.attached? %>
                <%= image_tag pet.photo, alt: "" %>
              <% else %>
                <%= pet.name.to_s.first.to_s.upcase.presence || "P" %>
              <% end %>
            </span>
            <span><%= pet.name %></span>
          <% end %>
        <% end %>
      </nav>
    <% end %>

    <section class="pj-public-access-summary">
      <div class="pj-public-access-summary__pet">
        <span class="pj-public-access-summary__avatar">
          <% if @pet.photo.attached? %>
            <%= image_tag @pet.photo, alt: "" %>
          <% else %>
            <%= @pet.name.to_s.first.to_s.upcase.presence || "P" %>
          <% end %>
        </span>
        <div>
          <small>Публичные ссылки питомца</small>
          <h2><%= @pet.name %></h2>
          <p>Каждая ссылка имеет собственные настройки, срок действия и набор открытых разделов.</p>
        </div>
      </div>

      <div class="pj-public-access-summary__stats" aria-label="Статистика публичного доступа">
        <div><strong><%= @shares.size %></strong><span><%= russian_plural(@shares.size, "ссылка", "ссылки", "ссылок") %></span></div>
        <div><strong><%= @shares.count(&:active?) %></strong><span>активно</span></div>
      </div>
    </section>

    <% if @shares.any? %>
      <div class="pj-public-access-grid">
        <% @shares.each do |share| %>
          <article class="pj-public-access-card">
            <div class="pj-public-access-card__head">
              <div>
                <span class="pj-public-access-card__status <%= share.active? ? "is-active" : "is-muted" %>"><%= profile_share_status_label(share) %></span>
                <h2><%= link_to share.title, pet_profile_share_path(@pet, share) %></h2>
                <p><%= profile_share_expiry_label(share) %> · <%= share.detail_full? ? "полная детализация" : "краткая детализация" %></p>
              </div>
              <%= link_to pet_profile_share_path(@pet, share), class: "pj-public-access-card__arrow", aria: { label: "Открыть #{share.title}" } do %>
                <%= pj_icon(:chevron) %>
              <% end %>
            </div>

            <div class="pj-public-access-card__url-control">
              <input type="text" value="<%= profile_share_public_url(share) %>" readonly aria-label="Публичная ссылка <%= share.title %>">
              <button type="button"
                      class="pj-public-access-copy-icon"
                      data-copy-url="<%= profile_share_public_url(share) %>"
                      data-copy-icon="true"
                      aria-label="Скопировать ссылку <%= share.title %>"
                      title="Скопировать ссылку">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="8" y="8" width="11" height="11" rx="2"></rect>
                  <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
                </svg>
              </button>
            </div>

            <div class="pj-public-access-card__chips" aria-label="Открытые разделы">
              <% profile_share_section_rows(share).select { |_label, enabled| enabled }.first(5).each do |label, _enabled| %>
                <span><%= label %></span>
              <% end %>
            </div>

            <% if share.sensitive_sections? %>
              <p class="pj-public-access-card__warning">В этой ссылке открыты чувствительные данные — передавайте её адресно.</p>
            <% end %>

            <div class="pj-public-access-card__meta">
              <span><strong><%= share.pet_profile_share_views.size %></strong> <%= russian_plural(share.pet_profile_share_views.size, "просмотр", "просмотра", "просмотров") %></span>
              <span><%= share.last_viewed_at.present? ? "Последний #{share.last_viewed_at.strftime("%d.%m.%Y")}" : "Ещё не открывали" %></span>
            </div>

            <div class="pj-public-access-card__actions">
              <%= link_to "Управлять", pet_profile_share_path(@pet, share), class: "pj-public-access-secondary" %>
              <%= link_to "Открыть публично", public_pet_profile_share_path(share.public_token), class: "pj-public-access-quiet", target: "_blank", rel: "noopener" %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <section class="pj-public-access-empty">
        <%= image_tag "petjournal/new_design/empty-public-access.svg", alt: "", class: "pj-public-access-empty__illustration" %>
        <h2>Публичных ссылок пока нет</h2>
        <p>Создайте отдельный доступ для родственника, передержки, грумера или любой ситуации, когда нужно показать данные питомца без входа в аккаунт.</p>
        <%= link_to "Создать публичный доступ", new_pet_profile_share_path(@pet), class: "pj-public-access-primary" %>
        <span>Открывайте только те разделы, которые действительно нужны получателю.</span>
      </section>
    <% end %>
  </div>
</div>
