<% selected_expiration = @share.new_record? ? "seven_days" : (@share.expires_at.present? ? "custom" : "never") %>

<%= form_with model: @share,
              url: @share.persisted? ? pet_profile_share_path(@pet, @share) : pet_profile_shares_path(@pet),
              class: "pj-public-access-form" do |form| %>
  <% if @share.errors.any? %>
    <div class="pj-public-access-form__errors" role="alert">
      <strong>Проверьте настройки доступа</strong>
      <p><%= @share.errors.full_messages.to_sentence %></p>
    </div>
  <% end %>

  <section class="pj-public-access-form-section">
    <div class="pj-public-access-form-section__head">
      <span>01</span>
      <div>
        <h2>Основное</h2>
        <p>Название, детализация и срок действия ссылки.</p>
      </div>
    </div>

    <div class="pj-public-access-form-grid">
      <label class="pj-public-access-field pj-public-access-field--wide">
        <span>Название доступа</span>
        <%= form.text_field :title, placeholder: "Например: Для семьи или передержки", autocomplete: "off" %>
      </label>

      <label class="pj-public-access-field">
        <span>Детализация</span>
        <%= form.select :detail_level, profile_share_detail_options %>
        <small>Краткая показывает последние записи, полная — расширенную историю.</small>
      </label>

      <label class="pj-public-access-field">
        <span>Срок действия</span>
        <%= select_tag :expires_preset,
                       options_for_select(profile_share_expiration_options, selected_expiration) %>
        <small>После окончания срока ссылка перестанет открываться.</small>
      </label>

      <label class="pj-public-access-field pj-public-access-field--wide">
        <span>Своя дата окончания</span>
        <%= form.datetime_field :expires_at %>
        <small>Используется при выборе «Своя дата». Для доступа без срока оставьте управление пресетом выше.</small>
      </label>
    </div>

    <label class="pj-public-access-master-toggle">
      <%= form.check_box :enabled %>
      <span class="pj-public-access-toggle-mark" aria-hidden="true"></span>
      <span>
        <strong>Ссылка активна</strong>
        <small>Её можно отключить в любой момент без удаления настроек.</small>
      </span>
    </label>
  </section>

  <section class="pj-public-access-form-section">
    <div class="pj-public-access-form-section__head">
      <span>02</span>
      <div>
        <h2>Что будет видно</h2>
        <p>Откройте только те разделы, которые нужны получателю.</p>
      </div>
    </div>

    <div class="pj-public-access-toggle-grid">
      <label class="pj-public-access-toggle-card">
        <%= form.check_box :show_profile %>
        <span class="pj-public-access-toggle-mark" aria-hidden="true"></span>
        <span><strong>Профиль</strong><small>Фото, имя, возраст, порода, чип и основные данные.</small></span>
      </label>

      <label class="pj-public-access-toggle-card">
        <%= form.check_box :show_journal %>
        <span class="pj-public-access-toggle-mark" aria-hidden="true"></span>
        <span><strong>Журнал</strong><small>Последние или расширенные записи о здоровье и уходе.</small></span>
      </label>

      <label class="pj-public-access-toggle-card">
        <%= form.check_box :show_documents %>
        <span class="pj-public-access-toggle-mark" aria-hidden="true"></span>
        <span><strong>Документы</strong><small>Паспорт, справки, анализы и прикреплённые файлы.</small></span>
      </label>

      <label class="pj-public-access-toggle-card">
        <%= form.check_box :show_reminders %>
        <span class="pj-public-access-toggle-mark" aria-hidden="true"></span>
        <span><strong>Напоминания</strong><small>Активные задачи по уходу, лечению и расписанию.</small></span>
      </label>

      <label class="pj-public-access-toggle-card">
        <%= form.check_box :show_pet_tag %>
        <span class="pj-public-access-toggle-mark" aria-hidden="true"></span>
        <span><strong>PetTag</strong><small>Статус безопасности и публичные заметки жетона.</small></span>
      </label>
    </div>
  </section>

  <section class="pj-public-access-form-section">
    <div class="pj-public-access-form-section__head">
      <span>03</span>
      <div>
        <h2>Приватность</h2>
        <p>Чувствительные данные остаются закрытыми, пока вы явно их не разрешите.</p>
      </div>
    </div>

    <div class="pj-public-access-toggle-grid pj-public-access-toggle-grid--privacy">
      <label class="pj-public-access-toggle-card pj-public-access-toggle-card--sensitive">
        <%= form.check_box :show_owner_contact %>
        <span class="pj-public-access-toggle-mark" aria-hidden="true"></span>
        <span><strong>Контакт владельца</strong><small>На публичной странице будет доступна электронная почта аккаунта.</small></span>
      </label>

      <label class="pj-public-access-toggle-card pj-public-access-toggle-card--sensitive">
        <%= form.check_box :allow_file_downloads %>
        <span class="pj-public-access-toggle-mark" aria-hidden="true"></span>
        <span><strong>Скачивание файлов</strong><small>Если выключено, получатель увидит только названия вложений.</small></span>
      </label>
    </div>
  </section>

  <div class="pj-public-access-form-actions">
    <%= form.submit @share.persisted? ? "Сохранить изменения" : "Создать публичный доступ", class: "pj-public-access-primary" %>
    <%= link_to "Отмена", @share.persisted? ? pet_profile_share_path(@pet, @share) : pet_profile_shares_path(@pet), class: "pj-public-access-quiet" %>
  </div>
<% end %>
