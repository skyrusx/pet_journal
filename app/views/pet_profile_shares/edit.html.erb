<% content_for :title, "Настройки публичного доступа — PetJournal" %>

<div class="pj-public-access-page pj-public-access-form-page">
  <header class="pj-workspace-topbar">
    <h1>Публичный доступ</h1>
    <%= link_to notification_channels_path,
                class: "pj-workspace-icon",
                aria: { label: "Настройки уведомлений" },
                title: "Настройки уведомлений" do %>
      <%= pj_icon(:bell) %>
    <% end %>
  </header>

  <div class="pj-public-access-content">
    <div class="pj-mobile-detail-nav pj-mobile-form-nav pj-public-access-mobile-form-nav">
      <%= link_to pet_profile_share_path(@pet, @share), class: "pj-mobile-context-back" do %>
        <%= pj_icon(:chevron) %><span>К профилю</span>
      <% end %>
    </div>

    <div class="pj-public-access-form-title">
      <div>
        <p>Измените состав, срок действия и приватность ссылки «<%= @share.title %>» для <%= @pet.name %>.</p>
      </div>
      <%= link_to "Назад к ссылке", pet_profile_share_path(@pet, @share), class: "pj-public-access-quiet" %>
    </div>

    <%= render "form" %>
  </div>
</div>
