<% content_for :title, "#{@share.title} — PetJournal" %>

<div class="pj-public-access-page">
  <header class="pj-workspace-topbar">
    <h1>Публичный доступ</h1>
    <%= link_to notification_channels_path,
                class: "pj-workspace-icon",
                aria: { label: "Настройки уведомлений" },
                title: "Настройки уведомлений" do %>
      <%= pj_icon(:bell) %>
    <% end %>
  </header>

  <div class="pj-public-access-content">
    <div class="pj-mobile-detail-nav pj-public-access-mobile-nav">
      <%= link_to pet_profile_shares_path(@pet), class: "pj-mobile-context-back" do %>
        <%= pj_icon(:chevron) %><span>Доступы питомца</span>
      <% end %>

      <div class="pj-mobile-detail-actions" aria-label="Действия с публичным доступом">
        <%= link_to edit_pet_profile_share_path(@pet, @share),
                    class: "pj-mobile-detail-action",
                    aria: { label: "Редактировать публичный доступ" },
                    title: "Редактировать" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.5 19.5 5.7 15l9.9-9.9a2.15 2.15 0 0 1 3 0l.3.3a2.15 2.15 0 0 1 0 3L9 18.3l-4.5 1.2Z"/>
            <path d="m14.3 6.4 3.3 3.3"/>
          </svg>
        <% end %>
      </div>
    </div>

    <div class="pj-public-access-intro pj-public-access-intro--manager">
      <div>
        <p>Управление ссылкой «<%= @share.title %>» для <%= @pet.name %>.</p>
      </div>
      <div class="pj-public-access-intro__actions">
        <%= link_to "Все доступы", pet_profile_shares_path(@pet), class: "pj-public-access-quiet" %>
        <%= link_to edit_pet_profile_share_path(@pet, @share),
                    class: "pj-desktop-detail-action pj-public-access-edit-action",
                    aria: { label: "Редактировать публичный доступ" },
                    title: "Редактировать" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.5 19.5 5.7 15l9.9-9.9a2.15 2.15 0 0 1 3 0l.3.3a2.15 2.15 0 0 1 0 3L9 18.3l-4.5 1.2Z"/>
            <path d="m14.3 6.4 3.3 3.3"/>
          </svg>
        <% end %>
      </div>
    </div>

    <section class="pj-public-access-manager-hero">
      <div class="pj-public-access-manager-hero__copy">
        <span class="pj-public-access-card__status <%= @share.active? ? "is-active" : "is-muted" %>"><%= profile_share_status_label(@share) %></span>
        <h2><%= @share.title %></h2>
        <p><%= profile_share_expiry_label(@share) %> · <%= @share.detail_full? ? "полная детализация" : "краткая детализация" %></p>
        <% if @share.sensitive_sections? %>
          <div class="pj-public-access-sensitive">В доступе открыты чувствительные данные. Передавайте ссылку только тем, кому доверяете.</div>
        <% end %>
      </div>

      <div class="pj-public-access-manager-hero__stats">
        <div><strong><%= @share.pet_profile_share_views.count %></strong><span><%= russian_plural(@share.pet_profile_share_views.count, "просмотр", "просмотра", "просмотров") %></span></div>
        <div><strong><%= @share.last_viewed_at.present? ? @share.last_viewed_at.strftime("%d.%m") : "—" %></strong><span>последний просмотр</span></div>
      </div>
    </section>

    <section class="pj-public-access-link-card">
      <div>
        <small>Публичная ссылка</small>
        <strong>Адрес доступа</strong>
      </div>
      <div class="pj-public-access-link-card__field">
        <input type="text" value="<%= profile_share_public_url(@share) %>" readonly aria-label="Публичная ссылка">
        <button type="button"
                class="pj-public-access-copy-icon"
                data-copy-url="<%= profile_share_public_url(@share) %>"
                data-copy-icon="true"
                aria-label="Скопировать публичную ссылку"
                title="Скопировать ссылку">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="8" y="8" width="11" height="11" rx="2"></rect>
            <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
          </svg>
        </button>
      </div>
      <div class="pj-public-access-link-card__actions">
        <%= link_to "Открыть", public_pet_profile_share_path(@share.public_token), class: "pj-public-access-primary", target: "_blank", rel: "noopener" %>
      </div>
    </section>

    <div class="pj-public-access-manager-grid">
      <section class="pj-public-access-panel">
        <div class="pj-public-access-panel__head">
          <div>
            <small>История</small>
            <h2>Последние просмотры</h2>
          </div>
          <span><%= @views.size %> из последних 40</span>
        </div>

        <% if @views.any? %>
          <div class="pj-public-access-view-list">
            <% @views.each do |view| %>
              <article class="pj-public-access-view">
                <span class="pj-public-access-view__icon"><%= pj_icon(:user) %></span>
                <div>
                  <strong><%= view.created_at.strftime("%d.%m.%Y · %H:%M") %></strong>
                  <small><%= view.ip_address.present? ? "IP #{view.ip_address}" : "IP не определён" %></small>
                  <p><%= view.user_agent.presence || "Браузер не определён" %></p>
                </div>
                <span class="pj-public-access-view__status">Открыт</span>
              </article>
            <% end %>
          </div>
        <% else %>
          <div class="pj-public-access-panel__empty">
            <span><%= pj_icon(:user) %></span>
            <strong>Просмотров пока нет</strong>
            <p>После первого открытия здесь появятся дата, браузер и маскированный IP посетителя.</p>
          </div>
        <% end %>
      </section>

      <aside class="pj-public-access-manager-aside">
        <section class="pj-public-access-panel pj-public-access-qr-panel">
          <div class="pj-public-access-panel__head">
            <div>
              <small>QR-код</small>
              <h2>Для быстрой передачи</h2>
            </div>
          </div>

          <div class="pj-public-access-qr">
            <%= image_tag qr_pet_profile_share_path(@pet, @share, format: :svg), alt: "QR-код публичного доступа для #{@pet.name}" %>
          </div>

          <div class="pj-public-access-downloads">
            <%= link_to "Скачать SVG", qr_pet_profile_share_path(@pet, @share, format: :svg), class: "pj-public-access-quiet" %>
            <%= link_to "Скачать PNG", qr_pet_profile_share_path(@pet, @share, format: :png), class: "pj-public-access-quiet" %>
          </div>
        </section>

        <section class="pj-public-access-panel">
          <div class="pj-public-access-panel__head">
            <div>
              <small>Состав доступа</small>
              <h2>Что видно по ссылке</h2>
            </div>
          </div>

          <div class="pj-public-access-scope">
            <% profile_share_section_rows(@share).each do |label, enabled| %>
              <div class="<%= enabled ? "is-visible" : "" %>">
                <span><%= label %></span>
                <strong><%= enabled ? "Видно" : "Скрыто" %></strong>
              </div>
            <% end %>
          </div>
        </section>
      </aside>
    </div>

    <section class="pj-public-access-danger-panel">
      <div>
        <small>Управление доступом</small>
        <h2>Статус и безопасность ссылки</h2>
        <p>Отключение можно отменить. Обновление ссылки создаст новый адрес и QR-код, а старые перестанут работать.</p>
      </div>
      <div class="pj-public-access-danger-panel__actions">
        <% if @share.enabled? %>
          <%= button_to "Отключить доступ", disable_pet_profile_share_path(@pet, @share), method: :patch, class: "pj-public-access-danger-outline" %>
        <% else %>
          <%= button_to "Включить доступ", enable_pet_profile_share_path(@pet, @share), method: :patch, class: "pj-public-access-secondary" %>
        <% end %>
        <%= button_to "Обновить ссылку",
                      rotate_token_pet_profile_share_path(@pet, @share),
                      method: :patch,
                      class: "pj-public-access-danger-outline",
                      form: { onsubmit: "return confirm('Обновить публичную ссылку? Старый адрес и QR-код перестанут работать.')" } %>
        <%= button_to "Удалить доступ",
                      pet_profile_share_path(@pet, @share),
                      method: :delete,
                      class: "pj-public-access-danger-outline",
                      form: { onsubmit: "return confirm('Удалить публичный доступ?')" } %>
      </div>
    </section>
  </div>
</div>
