<% content_for :title, "Новый публичный доступ — PetJournal" %>

<div class="pj-public-access-page pj-public-access-form-page">
  <%= render "shared/topbar",
             back_path: pet_profile_shares_path(@pet),
             back_label: "Назад к доступам",
             class_name: "pj-workspace-topbar--form",
             notifications: false %>

  <div class="pj-public-access-content">
    <div class="pj-mobile-detail-nav pj-mobile-form-nav pj-public-access-mobile-form-nav">
      <%= link_to pet_profile_shares_path(@pet), class: "pj-mobile-context-back" do %>
        <%= pj_icon(:chevron) %><span>Доступы питомца</span>
      <% end %>
    </div>

    <div class="pj-public-access-form-title">
      <div>
        <h1>Создать публичный доступ</h1>
        <p>Настройте отдельную ссылку для <%= @pet.name %> и выберите, какие данные будут доступны без входа в аккаунт.</p>
      </div>
    </div>

    <%= render "form" %>
  </div>
</div>