<% content_for :title, "Новый публичный доступ — PetJournal" %>

<div class="pj-public-access-page">
  <header class="pj-workspace-topbar">
    <h1>Публичный доступ</h1>
    <%= link_to notification_channels_path,
                class: "pj-workspace-icon",
                aria: { label: "Настройки уведомлений" },
                title: "Настройки уведомлений" do %>
      <%= pj_icon(:bell) %>
    <% end %>
  </header>

  <div class="pj-public-access-content">
    <div class="pj-public-access-form-title">
      <div>
        <p>Настройте отдельную ссылку для <%= @pet.name %> и выберите, какие данные будут доступны без входа в аккаунт.</p>
      </div>
      <%= link_to "Назад к доступам", pet_profile_shares_path(@pet), class: "pj-public-access-quiet" %>
    </div>

    <%= render "form" %>
  </div>
</div>
