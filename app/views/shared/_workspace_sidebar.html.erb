<% workspace_pet = defined?(@pet) && @pet&.persisted? ? @pet : current_user.pets.order(created_at: :desc).first %>
<% workspace_journal_path = workspace_pet ? pet_pet_events_path(workspace_pet) : pets_path %>
<% workspace_reminders_path = workspace_pet ? pet_reminders_path(workspace_pet) : pets_path %>
<% workspace_documents_path = workspace_pet ? pet_pet_documents_path(workspace_pet) : pets_path %>
<% workspace_pettag_path = workspace_pet ? pet_pet_tag_path(workspace_pet) : pets_path %>
<% display_name = current_user.name.presence || current_user.email.to_s.split("@").first.presence || "Аккаунт" %>
<% avatar_letter = display_name.to_s.first.to_s.upcase.presence || current_user.email.to_s.first.to_s.upcase %>

<aside class="pj-dash-sidebar" aria-label="Навигация PetJournal" data-dashboard-sidebar>
  <div class="pj-dash-sidebar__top">
    <%= link_to root_path, class: "pj-dash-brand", aria: { label: "PetJournal — главная" } do %>
      <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", class: "pj-dash-brand__full" %>
      <%= image_tag "petjournal/logo-symbol.png", alt: "", class: "pj-dash-brand__compact" %>
    <% end %>

    <button type="button"
            class="pj-dash-sidebar-toggle"
            aria-label="Свернуть боковое меню"
            aria-expanded="true"
            data-dashboard-sidebar-toggle>
      <%= pj_icon(:chevron) %>
    </button>
  </div>

  <nav class="pj-dash-nav">
    <%= link_to root_path, class: class_names("pj-dash-nav__item", active: controller_name == "pages"), aria: { label: "Главная" }, title: "Главная" do %>
      <%= pj_icon(:home) %><span>Главная</span>
    <% end %>
    <%= link_to pets_path, class: class_names("pj-dash-nav__item", active: controller_name == "pets"), aria: { label: "Питомцы" }, title: "Питомцы" do %>
      <%= pj_icon(:paw) %><span>Питомцы</span>
    <% end %>
    <%= link_to workspace_journal_path, class: class_names("pj-dash-nav__item", active: controller_name == "pet_events"), aria: { label: "Журнал" }, title: "Журнал" do %>
      <%= pj_icon(:journal) %><span>Журнал</span>
    <% end %>
    <%= link_to workspace_reminders_path, class: class_names("pj-dash-nav__item", active: controller_name == "reminders"), aria: { label: "Напоминания" }, title: "Напоминания" do %>
      <%= pj_icon(:bell) %><span>Напоминания</span>
    <% end %>
    <%= link_to workspace_documents_path, class: class_names("pj-dash-nav__item", active: controller_name == "pet_documents"), aria: { label: "Документы" }, title: "Документы" do %>
      <%= pj_icon(:file) %><span>Документы</span>
    <% end %>
    <%= link_to workspace_pettag_path, class: class_names("pj-dash-nav__item", active: controller_name == "pet_tags"), aria: { label: "PetTag" }, title: "PetTag" do %>
      <%= pj_icon(:tag) %><span>PetTag</span>
    <% end %>
  </nav>

  <div class="pj-dash-sidebar__footer">
    <details class="pj-dash-profile-menu" data-dashboard-profile-menu>
      <summary class="pj-dash-account" title="Меню профиля">
        <span class="pj-dash-account__avatar"><%= avatar_letter %></span>
        <span class="pj-dash-account__copy">
          <strong><%= display_name %></strong>
          <small><%= current_user.email %></small>
        </span>
        <%= pj_icon(:chevron) %>
      </summary>

      <div class="pj-dash-profile-popover">
        <div class="pj-dash-profile-popover__identity">
          <strong><%= display_name %></strong>
          <small><%= current_user.email %></small>
        </div>

        <%= link_to edit_user_registration_path, class: "pj-dash-profile-popover__item" do %>
          <%= pj_icon(:user) %>
          <span>Профиль</span>
        <% end %>

        <div class="pj-dash-profile-popover__separator" aria-hidden="true"></div>

        <%= button_to destroy_user_session_path,
                      method: :delete,
                      class: "pj-dash-profile-popover__item pj-dash-profile-popover__logout",
                      form_class: "pj-dash-profile-popover__form" do %>
          <%= pj_icon(:logout) %>
          <span>Выйти</span>
        <% end %>
      </div>
    </details>
  </div>
</aside>
