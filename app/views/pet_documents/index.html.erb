<% content_for :title, "Документы — PetJournal" %>
<% document_filter_params = request.query_parameters.except("pet_id", "page") %>
<% has_document_filters = @selected_type.present? || @selected_status != "all" || @selected_scope != "all" || @query.present? %>

<div class="pj-documents-page pj-documents-index">
  <header class="pj-workspace-topbar">
    <h1>Документы</h1>
    <%= render "shared/workspace_notification_link" %>
  </header>

  <div class="pj-documents-content">
    <div class="pj-documents-heading">
      <div>
        <h1>Документы</h1>
        <p>Паспорта, анализы, справки и другие важные документы всех питомцев.</p>
      </div>
    </div>

    <div class="pj-documents-toolbar">
      <details class="pj-documents-pet-switcher pj-journal-pet-switcher">
        <summary>
          <span class="pj-documents-pet-avatar pj-journal-pet-avatar <%= "is-all" if @selected_pet.blank? %>">
            <% if @selected_pet&.photo&.attached? %>
              <%= image_tag @selected_pet.photo, alt: "" %>
            <% elsif @selected_pet.present? %>
              <%= @selected_pet.name.to_s.first.to_s.upcase.presence || "P" %>
            <% else %>
              <%= pj_icon(:paw) %>
            <% end %>
          </span>
          <span><%= @selected_pet&.name || "Все питомцы" %></span>
          <%= pj_icon(:chevron) %>
        </summary>

        <div class="pj-documents-pet-menu pj-journal-pet-menu">
          <%= link_to documents_overview_path(document_filter_params),
                      class: class_names("pj-documents-pet-option", "pj-journal-pet-option", active: @selected_pet.blank?) do %>
            <span class="pj-documents-pet-avatar pj-journal-pet-avatar is-all"><%= pj_icon(:paw) %></span>
            <span><strong>Все питомцы</strong><small>Общая библиотека</small></span>
          <% end %>

          <% @document_pets.each do |pet| %>
            <%= link_to documents_overview_path(document_filter_params.merge("pet_id" => pet.id)),
                        class: class_names("pj-documents-pet-option", "pj-journal-pet-option", active: pet == @selected_pet) do %>
              <span class="pj-documents-pet-avatar pj-journal-pet-avatar">
                <% if pet.photo.attached? %>
                  <%= image_tag pet.photo, alt: "" %>
                <% else %>
                  <%= pet.name.to_s.first.to_s.upcase.presence || "P" %>
                <% end %>
              </span>
              <span><strong><%= pet.name %></strong><small><%= pet.breed.presence || pet.species.presence || "Питомец" %></small></span>
            <% end %>
          <% end %>
        </div>
      </details>

      <% if @selected_pet.present? || @document_pets.one? %>
        <% add_pet = @selected_pet || @document_pets.first %>
        <%= link_to new_pet_pet_document_path(add_pet), class: "pj-documents-primary-button" do %>
          <%= pj_icon(:plus) %><span>Добавить документ</span>
        <% end if add_pet %>
      <% elsif @document_pets.many? %>
        <details class="pj-documents-add-picker pj-journal-add-picker">
          <summary class="pj-documents-primary-button">
            <%= pj_icon(:plus) %><span>Добавить документ</span>
          </summary>
          <div class="pj-journal-add-picker__menu">
            <small>Для какого питомца?</small>
            <% @document_pets.each do |pet| %>
              <%= link_to new_pet_pet_document_path(pet), class: "pj-journal-add-picker__item" do %>
                <span class="pj-documents-pet-avatar pj-journal-pet-avatar">
                  <% if pet.photo.attached? %>
                    <%= image_tag pet.photo, alt: "" %>
                  <% else %>
                    <%= pet.name.to_s.first.to_s.upcase.presence || "P" %>
                  <% end %>
                </span>
                <span><strong><%= pet.name %></strong><small><%= pet.breed.presence || pet.species.presence || "Питомец" %></small></span>
              <% end %>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>

    <%= form_with url: documents_overview_path, method: :get, class: "pj-documents-filters" do |form| %>
      <%= hidden_field_tag :pet_id, @selected_pet.id if @selected_pet.present? %>

      <div class="pj-documents-filter pj-documents-filter--search">
        <span aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="5.75"/><path d="m15 15 4.25 4.25"/></svg>
        </span>
        <%= form.search_field :q,
                              value: @query,
                              placeholder: "Поиск по документам",
                              aria: { label: "Поиск по документам" } %>
      </div>

      <div class="pj-documents-filter">
        <%= select_tag :status,
                       options_for_select(
                         [["Все статусы", "all"], ["Актуальные", "active"], ["Скоро истекают", "expiring"], ["Просрочены", "expired"], ["Без срока", "no_expiry"]],
                         @selected_status
                       ),
                       aria: { label: "Статус документа" } %>
      </div>

      <div class="pj-documents-filter">
        <%= select_tag :type,
                       options_for_select([["Все типы", ""]] + document_type_options, @selected_type),
                       aria: { label: "Тип документа" } %>
      </div>

      <div class="pj-documents-filter">
        <%= select_tag :scope,
                       options_for_select([["Все документы", "all"], ["С файлами", "with_files"], ["С напоминанием", "with_reminder"]], @selected_scope),
                       aria: { label: "Состав документов" } %>
      </div>

      <button type="submit" class="pj-documents-filter-submit" aria-label="Применить фильтры">
        <span>Применить</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="5.75"/><path d="m15 15 4.25 4.25"/></svg>
      </button>

      <% if has_document_filters %>
        <%= link_to "Сбросить", documents_overview_path(pet_id: @selected_pet&.id), class: "pj-documents-filter-reset" %>
      <% end %>
    <% end %>

    <%= render "mobile_filters" %>

    <% if @highlight_documents.any? %>
      <div class="pj-documents-deadline-strip">
        <% @highlight_documents.uniq.first(3).each do |document| %>
          <%= link_to pet_pet_document_path(document.pet, document), class: class_names("pj-documents-deadline", "is-danger": document.expired?) do %>
            <span><%= document.expired? ? "Истёк срок" : "Скоро истекает" %></span>
            <strong><%= document.title %></strong>
            <small><%= document.pet.name %> · <%= document.expires_on&.strftime("%d.%m.%Y") %></small>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @documents.any? %>
      <div class="pj-documents-table-wrap">
        <div class="pj-documents-table-head">
          <span>Название</span><span>Тип</span><span>Питомец</span><span>Дата выдачи</span><span>Срок действия</span><span>Статус</span><span></span>
        </div>

        <% @documents.each do |document| %>
          <article class="pj-documents-row-wrap">
            <%= link_to pet_pet_document_path(document.pet, document), class: "pj-documents-row" do %>
              <span class="pj-documents-row__title">
                <span class="pj-documents-row__icon"><%= pj_icon(:file) %></span>
                <span>
                  <strong><%= document.title %></strong>
                  <small><%= document.files.attached? ? document_file_label(document) : ([document.issuer.presence, document.number.presence].compact.join(" · ").presence || "Без файла") %></small>
                </span>
              </span>
              <span><%= document.document_type_label %></span>
              <span class="pj-documents-row__pet"><%= document.pet.name %></span>
              <span><%= document.issued_on&.strftime("%d.%m.%Y") || "—" %></span>
              <span><%= document.expires_on&.strftime("%d.%m.%Y") || "—" %></span>
              <span><em class="pj-document-status is-<%= document.status_tone %>"><%= document.status_label %></em></span>
              <span class="pj-documents-row__chevron"><%= pj_icon(:chevron) %></span>
            <% end %>

            <%= link_to edit_pet_pet_document_path(document.pet, document), class: "pj-documents-row__edit", aria: { label: "Редактировать #{document.title}" }, title: "Редактировать" do %>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l4.1-1 10.8-10.8a2.1 2.1 0 0 0-3-3L5.1 16 4 20z"/><path d="m14.6 6.5 3 3"/></svg>
            <% end %>
          </article>
        <% end %>
      </div>

      <div class="pj-documents-mobile-list">
        <% @documents.each do |document| %>
          <article class="pj-documents-mobile-card-wrap">
            <%= link_to pet_pet_document_path(document.pet, document), class: "pj-documents-mobile-card" do %>
              <span class="pj-documents-row__icon"><%= pj_icon(:file) %></span>
              <span class="pj-documents-mobile-card__body">
                <small><%= document.document_type_label %><%= " · #{document.pet.name}" if @selected_pet.blank? %></small>
                <strong><%= document.title %></strong>
                <span><%= document.issued_on&.strftime("%d.%m.%Y") || "Дата не указана" %><%= " · до #{document.expires_on.strftime("%d.%m.%Y")}" if document.expires_on.present? %></span>
                <em class="pj-document-status is-<%= document.status_tone %>"><%= document.status_label %></em>
              </span>
            <% end %>

            <%= link_to edit_pet_pet_document_path(document.pet, document), class: "pj-documents-row__edit", aria: { label: "Редактировать #{document.title}" }, title: "Редактировать" do %>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l4.1-1 10.8-10.8a2.1 2.1 0 0 0-3-3L5.1 16 4 20z"/><path d="m14.6 6.5 3 3"/></svg>
            <% end %>
          </article>
        <% end %>
      </div>

      <% if @has_more_documents %>
        <div class="pj-journal-load-more pj-documents-load-more">
          <%= link_to documents_overview_path(request.query_parameters.merge("page" => @page + 1)), class: "pj-journal-load-more__button" do %>
            <span>Показать ещё</span>
            <% remaining = [@matching_documents_count - @documents_limit, PetDocumentsController::PAGE_SIZE].min %>
            <small><%= remaining %> <%= russian_plural(remaining, "документ", "документа", "документов") %></small>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <section class="pj-documents-empty">
        <span><%= pj_icon(:file) %></span>
        <h2><%= has_document_filters ? "Ничего не найдено" : "Документов пока нет" %></h2>
        <p>
          <% if @document_pets.empty? %>
            Добавьте питомца, чтобы хранить его паспорт, анализы, справки и другие документы.
          <% elsif @selected_pet.present? %>
            Добавьте ветеринарный паспорт, анализ, справку или другой важный документ для <%= @selected_pet.name %>.
          <% else %>
            Здесь будет храниться общая библиотека документов ваших питомцев.
          <% end %>
        </p>
        <% if @selected_pet.present? || @document_pets.one? %>
          <% empty_add_pet = @selected_pet || @document_pets.first %>
          <%= link_to "Добавить документ", new_pet_pet_document_path(empty_add_pet), class: "pj-documents-primary-button" if empty_add_pet %>
        <% end %>
      </section>
    <% end %>

    <% if @event_file_events.any? %>
      <section class="pj-documents-legacy">
        <div class="pj-documents-section-heading">
          <div>
            <h2>Файлы из журнала</h2>
            <p>Вложения, которые были добавлены к событиям до появления библиотеки документов.</p>
          </div>
          <span><%= @document_counts[:legacy_files] %> <%= russian_plural(@document_counts[:legacy_files], "файл", "файла", "файлов") %></span>
        </div>

        <div class="pj-documents-legacy-list">
          <% @event_file_events.each do |event| %>
            <%= link_to pet_pet_event_path(event.pet, event), class: "pj-documents-legacy-row" do %>
              <span class="pj-documents-row__icon"><%= pj_icon(:journal) %></span>
              <span><strong><%= event.title.presence || event.event_type_label %></strong><small><%= event.event_date.strftime("%d.%m.%Y") %> · <%= event.pet.name %> · <%= event.files.count %> <%= russian_plural(event.files.count, "файл", "файла", "файлов") %></small></span>
              <%= pj_icon(:chevron) %>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>
