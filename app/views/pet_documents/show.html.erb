<% content_for :title, "#{@document.title} — PetJournal" %>

<div class="pj-documents-page pj-document-detail-page">
  <header class="pj-workspace-topbar pj-document-detail-topbar">
    <%= link_to pet_pet_documents_path(@pet), class: "pj-workspace-back" do %>
      <%= pj_icon(:chevron) %><span>Назад к документам</span>
    <% end %>

    <div class="pj-desktop-detail-actions" aria-label="Действия с документом">
      <%= link_to edit_pet_pet_document_path(@pet, @document),
                  class: "pj-desktop-detail-action",
                  aria: { label: "Редактировать документ" },
                  title: "Редактировать" do %>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4.5 19.5 5.7 15l9.9-9.9a2.15 2.15 0 0 1 3 0l.3.3a2.15 2.15 0 0 1 0 3L9 18.3l-4.5 1.2Z"/>
          <path d="m14.3 6.4 3.3 3.3"/>
        </svg>
      <% end %>

      <%= button_to pet_pet_document_path(@pet, @document),
                    method: :delete,
                    class: "pj-desktop-detail-action pj-desktop-detail-action--danger",
                    form_class: "pj-desktop-detail-action-form",
                    form: { onsubmit: "return confirm('Удалить документ?')" },
                    aria: { label: "Удалить документ" },
                    title: "Удалить" do %>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/>
        </svg>
      <% end %>
    </div>
  </header>

  <div class="pj-documents-content pj-document-detail-content">
    <div class="pj-mobile-detail-nav pj-document-mobile-nav">
      <%= link_to pet_pet_documents_path(@pet), class: "pj-mobile-context-back" do %>
        <%= pj_icon(:chevron) %><span>К документам</span>
      <% end %>

      <div class="pj-mobile-detail-actions" aria-label="Действия с документом">
        <%= link_to edit_pet_pet_document_path(@pet, @document),
                    class: "pj-mobile-detail-action",
                    aria: { label: "Редактировать документ" },
                    title: "Редактировать" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.5 19.5 5.7 15l9.9-9.9a2.15 2.15 0 0 1 3 0l.3.3a2.15 2.15 0 0 1 0 3L9 18.3l-4.5 1.2Z"/>
            <path d="m14.3 6.4 3.3 3.3"/>
          </svg>
        <% end %>

        <%= button_to pet_pet_document_path(@pet, @document),
                      method: :delete,
                      class: "pj-mobile-detail-action pj-mobile-detail-action--danger",
                      form_class: "pj-mobile-detail-action-form",
                      form: { onsubmit: "return confirm('Удалить документ?')" },
                      aria: { label: "Удалить документ" },
                      title: "Удалить" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/>
          </svg>
        <% end %>
      </div>
    </div>

    <div class="pj-document-detail-heading">
      <div>
        <div class="pj-document-detail-title-row">
          <h1><%= @document.title %></h1>
          <em class="pj-document-type-pill"><%= @document.document_type_label %></em>
        </div>
        <p><%= @document.issuer.presence || "Реквизиты можно заполнить позже" %></p>
      </div>
    </div>

    <div class="pj-document-detail-grid">
      <section class="pj-document-info-card">
        <div class="pj-document-info-card__heading">
          <span class="pj-documents-row__icon"><%= pj_icon(:file) %></span>
          <div>
            <small>Питомец</small>
            <strong><%= @pet.name %></strong>
          </div>
          <em class="pj-document-status is-<%= @document.status_tone %>"><%= @document.status_label %></em>
        </div>

        <dl class="pj-document-detail-list">
          <div><dt>Дата выдачи</dt><dd><%= @document.issued_on&.strftime("%d.%m.%Y") || "—" %></dd></div>
          <div><dt>Срок действия</dt><dd><%= @document.expires_on&.strftime("%d.%m.%Y") || "Без срока" %></dd></div>
          <div><dt>Кем выдан</dt><dd><%= @document.issuer.presence || "—" %></dd></div>
          <div><dt>Номер документа</dt><dd><%= @document.number.presence || "—" %></dd></div>
          <div><dt>Напомнить заранее</dt><dd><%= @document.expiry_reminder_days %> <%= russian_plural(@document.expiry_reminder_days, "день", "дня", "дней") %></dd></div>
        </dl>

        <div class="pj-document-comment">
          <span>Комментарий</span>
          <p><%= @document.notes.presence || "—" %></p>
        </div>
      </section>

      <aside class="pj-document-files-card">
        <div class="pj-documents-section-heading is-compact">
          <div><h2>Прикреплённые файлы</h2></div>
          <span><%= @document.files.count %></span>
        </div>

        <% if @document.files.attached? %>
          <div class="pj-document-file-list">
            <% @document.files.each do |file| %>
              <div class="pj-document-file-row">
                <%= link_to url_for(file), target: "_blank", rel: "noopener", class: "pj-document-file-row__main" do %>
                  <span class="pj-document-file-preview"><%= pj_icon(:file) %></span>
                  <span><strong><%= file.filename.to_s %></strong><small><%= number_to_human_size(file.byte_size) %> · <%= file.content_type.to_s.split("/").last.to_s.upcase.presence || "Файл" %></small></span>
                <% end %>

                <%= button_to file_pet_pet_document_path(@pet, @document, file),
                              method: :delete,
                              class: "pj-document-file-delete",
                              form_class: "pj-document-file-delete-form",
                              form: { onsubmit: "return confirm('Удалить файл?')" },
                              aria: { label: "Удалить #{file.filename}" } do %>
                  ×
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="pj-document-files-empty">Файлы пока не прикреплены.</p>
        <% end %>

        <%= link_to edit_pet_pet_document_path(@pet, @document), class: "pj-document-add-file" do %>
          <%= pj_icon(:plus) %><span>Добавить файл</span>
        <% end %>
      </aside>
    </div>

    <div class="pj-document-related-grid">
      <section class="pj-document-related-card">
        <div class="pj-document-related-card__head">
          <span class="pj-document-related-avatar">
            <% if @pet.photo.attached? %>
              <%= image_tag @pet.photo, alt: "" %>
            <% else %>
              <%= @pet.name.to_s.first.to_s.upcase.presence || "P" %>
            <% end %>
          </span>
          <div><small>Связанный питомец</small><strong><%= @pet.name %></strong><span><%= @pet.breed.presence || @pet.species.presence || "Питомец" %></span></div>
        </div>
        <%= link_to "Открыть профиль", pet_path(@pet), class: "pj-document-related-action" %>
      </section>

      <section class="pj-document-related-card">
        <div class="pj-document-related-card__head">
          <span class="pj-document-related-icon"><%= pj_icon(:journal) %></span>
          <div>
            <small>Связанная запись</small>
            <strong><%= @document.pet_event.present? ? (@document.pet_event.title.presence || "Запись в журнале") : "Не создана" %></strong>
            <span><%= @document.pet_event&.event_date&.strftime("%d.%m.%Y") || "Можно создать автоматически" %></span>
          </div>
        </div>

        <% if @document.pet_event.present? %>
          <%= link_to "Открыть запись", pet_pet_event_path(@pet, @document.pet_event), class: "pj-document-related-action" %>
          <%= button_to "Обновить из документа", sync_journal_event_pet_pet_document_path(@pet, @document), method: :patch, class: "pj-document-related-sync" %>
        <% else %>
          <%= button_to "Создать запись", sync_journal_event_pet_pet_document_path(@pet, @document), method: :patch, class: "pj-document-related-action" %>
        <% end %>
      </section>

      <section class="pj-document-related-card">
        <div class="pj-document-related-card__head">
          <span class="pj-document-related-icon"><%= pj_icon(:alarm) %></span>
          <div>
            <small>Связанное напоминание</small>
            <strong><%= @document.reminder.present? ? @document.reminder.title : "Не создано" %></strong>
            <span><%= @document.reminder&.next_run_at&.strftime("%d.%m.%Y, %H:%M") || (@document.expires_on.present? ? "Можно создать по сроку действия" : "Сначала укажите срок действия") %></span>
          </div>
        </div>

        <% if @document.reminder.present? %>
          <%= link_to "Открыть напоминание", pet_reminder_path(@pet, @document.reminder), class: "pj-document-related-action" %>
          <%= button_to "Обновить из документа", sync_expiry_reminder_pet_pet_document_path(@pet, @document), method: :patch, class: "pj-document-related-sync" %>
        <% elsif @document.expires_on.present? %>
          <%= button_to "Создать напоминание", sync_expiry_reminder_pet_pet_document_path(@pet, @document), method: :patch, class: "pj-document-related-action" %>
        <% else %>
          <%= link_to "Указать срок действия", edit_pet_pet_document_path(@pet, @document), class: "pj-document-related-action" %>
        <% end %>
      </section>
    </div>
  </div>
</div>
