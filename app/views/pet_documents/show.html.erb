<div class="document-detail-page py-4">
  <section class="documents-hero mb-4">
    <div class="documents-hero-main">
      <div>
        <div class="text-muted small mb-1"><%= @pet.name %> · <%= @document.document_type_label %></div>
        <h1 class="h3 mb-2"><%= @document.title %></h1>
        <p class="text-muted mb-0"><%= [@document.issuer.presence, @document.number.presence].compact.join(" · ").presence || "Реквизиты не указаны" %></p>
      </div>

      <div class="documents-current-signal">
        <span>Статус документа</span>
        <h2><%= @document.status_label %></h2>
        <p>
          <% if @document.expires_on.present? %>
            Действует до <%= @document.expires_on.strftime("%d.%m.%Y") %>.
          <% else %>
            Срок действия не указан.
          <% end %>
        </p>
      </div>
    </div>

    <div class="documents-metrics">
      <div><span><%= @document.files.count %></span><small><%= russian_plural(@document.files.count, "файл", "файла", "файлов") %></small></div>
      <div><span><%= @document.pet_event.present? ? "Да" : "—" %></span><small>запись журнала</small></div>
      <div><span><%= @document.reminder.present? ? "Да" : "—" %></span><small>напоминание</small></div>
      <div><span><%= @document.issued_on&.strftime("%d.%m") || "—" %></span><small>выдан</small></div>
      <div><span><%= @document.expires_on&.strftime("%d.%m") || "—" %></span><small>до даты</small></div>
    </div>

    <div class="documents-quick-actions">
      <%= link_to "Редактировать", edit_pet_pet_document_path(@pet, @document), class: "btn btn-primary" %>
      <%= link_to "К документам", pet_pet_documents_path(@pet), class: "btn btn-outline-secondary" %>
      <%= link_to "Журнал", pet_pet_events_path(@pet, type: :document), class: "btn btn-outline-primary btn-sm" %>
      <% if @document.reminder.present? %>
        <%= link_to "Напоминание", pet_reminder_path(@pet, @document.reminder), class: "btn btn-outline-primary btn-sm" %>
      <% end %>
    </div>
  </section>

  <div class="documents-layout">
    <section class="documents-main">
      <div class="dashboard-section">
        <div class="section-heading compact">
          <h2 class="h4 mb-0">Детали</h2>
          <span class="<%= document_status_class(@document) %>"><%= @document.status_label %></span>
        </div>

        <dl class="details-list dashboard-details">
          <div><dt>Тип</dt><dd><%= @document.document_type_label %></dd></div>
          <div><dt>Кем выдан</dt><dd><%= @document.issuer.presence || "—" %></dd></div>
          <div><dt>Номер</dt><dd><%= @document.number.presence || "—" %></dd></div>
          <div><dt>Дата выдачи</dt><dd><%= @document.issued_on&.strftime("%d.%m.%Y") || "—" %></dd></div>
          <div><dt>Действует до</dt><dd><%= @document.expires_on&.strftime("%d.%m.%Y") || "—" %></dd></div>
          <div><dt>Напомнить за</dt><dd><%= @document.expiry_reminder_days %> <%= russian_plural(@document.expiry_reminder_days, "день", "дня", "дней") %></dd></div>
        </dl>

        <% if @document.notes.present? %>
          <div class="notes-box">
            <div class="fw-semibold mb-1">Заметки</div>
            <div class="text-muted"><%= simple_format(@document.notes) %></div>
          </div>
        <% end %>
      </div>

      <div class="dashboard-section">
        <div class="section-heading compact">
          <h2 class="h4 mb-0">Файлы</h2>
          <span class="status-pill muted"><%= document_file_label(@document) %></span>
        </div>

        <% if @document.files.attached? %>
          <div class="document-file-grid">
            <% @document.files.each do |file| %>
              <div class="document-file-card">
                <div>
                  <div class="fw-semibold"><%= file.filename.to_s %></div>
                  <div class="text-muted small"><%= number_to_human_size(file.byte_size) %></div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                  <%= link_to "Открыть", url_for(file), target: "_blank", rel: "noopener", class: "btn btn-outline-primary btn-sm" %>
                  <%= button_to "Удалить",
                                file_pet_pet_document_path(@pet, @document, file),
                                method: :delete,
                                class: "btn btn-outline-danger btn-sm",
                                form: { onsubmit: "return confirm('Удалить файл?')" } %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="empty-state-inline">
            <div class="fw-semibold mb-1">Файлы не прикреплены</div>
            <div class="text-muted mb-3">Добавьте PDF, фото или скан через редактирование документа.</div>
            <%= link_to "Добавить файлы", edit_pet_pet_document_path(@pet, @document), class: "btn btn-primary btn-sm" %>
          </div>
        <% end %>
      </div>
    </section>

    <aside class="documents-side">
      <section class="dashboard-section">
        <div class="text-muted small mb-1">Связи</div>
        <h2 class="h4 mb-3">Журнал и напоминание</h2>

        <div class="compact-list mb-3">
          <div>
            <span>Запись журнала</span>
            <strong>
              <% if @document.pet_event.present? %>
                <%= link_to "Открыть", pet_pet_event_path(@pet, @document.pet_event), class: "text-decoration-none" %>
              <% else %>
                Нет
              <% end %>
            </strong>
          </div>
          <div>
            <span>Напоминание</span>
            <strong>
              <% if @document.reminder.present? %>
                <%= link_to "Открыть", pet_reminder_path(@pet, @document.reminder), class: "text-decoration-none" %>
              <% else %>
                Нет
              <% end %>
            </strong>
          </div>
        </div>

        <p class="text-muted mb-3">При редактировании можно обновить запись в журнале и напоминание о сроке действия.</p>
        <%= link_to "Изменить связи", edit_pet_pet_document_path(@pet, @document), class: "btn btn-outline-primary btn-sm w-100" %>
      </section>

      <section class="dashboard-section">
        <div class="text-muted small mb-1">Опасная зона</div>
        <h2 class="h4 mb-3">Удаление</h2>
        <p class="text-muted mb-3">Удаление уберет документ из библиотеки. Связанные файлы документа также будут удалены.</p>
        <%= button_to "Удалить документ",
                      pet_pet_document_path(@pet, @document),
                      method: :delete,
                      class: "btn btn-outline-danger btn-sm w-100",
                      form: { onsubmit: "return confirm('Удалить документ?')" } %>
      </section>
    </aside>
  </div>
</div>
