<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">
  <%= @pet.name %>: <%= @reminder.title %> — напоминание PetJournal.
</div>

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background:#f4f3ed;margin:0;padding:0;">
  <tr>
    <td align="center" style="padding:32px 16px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:620px;margin:0 auto;">
        <tr>
          <td style="padding:0 4px 18px;">
            <% if attachments["petjournal-logo.png"].present? %>
              <%= image_tag attachments["petjournal-logo.png"].url,
                            alt: "PetJournal",
                            width: 154,
                            style: "display:block;width:154px;max-width:100%;height:auto;border:0;" %>
            <% else %>
              <span style="font-family:Georgia,'Times New Roman',serif;font-size:24px;line-height:1;color:#174f34;">PetJournal</span>
            <% end %>
          </td>
        </tr>

        <tr>
          <td style="background:#fffefa;border:1px solid #e4e0d6;border-radius:18px;overflow:hidden;box-shadow:0 10px 30px rgba(40,60,48,.06);">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;">
              <tr>
                <td style="background:#174f34;padding:30px 34px 28px;">
                  <div style="margin:0 0 10px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:1.4;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:#cfe77b;">
                    Напоминание
                  </div>
                  <h1 style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:30px;line-height:1.25;font-weight:400;color:#fffdf6;">
                    <%= @reminder.title %>
                  </h1>
                  <p style="margin:10px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.55;color:#dce8df;">
                    Для <strong style="color:#ffffff;"><%= @pet.name %></strong>
                  </p>
                </td>
              </tr>

              <tr>
                <td style="padding:30px 34px 8px;">
                  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;">
                    <tr>
                      <td style="width:52%;padding:0 10px 18px 0;vertical-align:top;">
                        <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:1.4;font-weight:700;letter-spacing:.7px;text-transform:uppercase;color:#879188;">Когда</div>
                        <div style="margin-top:5px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.5;font-weight:700;color:#344038;"><%= l(@scheduled_at, format: :default) %></div>
                      </td>
                      <td style="width:48%;padding:0 0 18px 10px;vertical-align:top;">
                        <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:1.4;font-weight:700;letter-spacing:.7px;text-transform:uppercase;color:#879188;">Тип</div>
                        <div style="margin-top:5px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.5;font-weight:700;color:#344038;"><%= @reminder.reminder_type_label %></div>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

              <% if @reminder.note.present? %>
                <tr>
                  <td style="padding:0 34px 24px;">
                    <div style="background:#f4f5eb;border:1px solid #e3e7d2;border-radius:12px;padding:16px 18px;">
                      <div style="margin-bottom:6px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:1.4;font-weight:700;letter-spacing:.7px;text-transform:uppercase;color:#74806f;">Заметка</div>
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.65;color:#4d5a51;"><%= simple_format(h(@reminder.note), {}, wrapper_tag: "span") %></div>
                    </div>
                  </td>
                </tr>
              <% end %>

              <tr>
                <td style="padding:0 34px 34px;">
                  <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                    <tr>
                      <td bgcolor="#174f34" style="border-radius:10px;">
                        <%= link_to "Открыть напоминание",
                                    @reminder_url,
                                    style: "display:inline-block;padding:13px 20px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1;font-weight:700;color:#ffffff;text-decoration:none;border-radius:10px;" %>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td style="padding:18px 10px 0;text-align:center;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#89928b;">
            PetJournal помогает держать важное о питомце рядом.<br>
            Это автоматическое уведомление — отвечать на него не нужно.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
