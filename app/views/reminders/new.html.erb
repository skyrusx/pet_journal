<% content_for :title, "Новое напоминание — #{@pet.name} — PetJournal" %>

<div class="pj-reminders-page pj-reminder-form-page">
  <header class="pj-workspace-topbar pj-workspace-topbar--form">
    <%= link_to pet_reminders_path(@pet), class: "pj-workspace-back" do %>
      <%= pj_icon(:chevron) %><span>Назад к напоминаниям</span>
    <% end %>
  </header>

  <div class="pj-reminders-content pj-reminder-form-content">
    <div class="pj-mobile-detail-nav pj-mobile-form-nav">
      <%= link_to pet_reminders_path(@pet), class: "pj-mobile-context-back" do %>
        <%= pj_icon(:chevron) %><span>К напоминаниям</span>
      <% end %>
    </div>

    <div class="pj-reminder-form-heading">
      <h1>Создать напоминание</h1>
      <p>Настройте срок, повтор и каналы уведомлений для <%= @pet.name %>.</p>
    </div>

    <%= render "form", pet: @pet, reminder: @reminder %>
  </div>
</div>
