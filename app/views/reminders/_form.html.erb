<% if reminder.errors.any? %>
  <div class="flash-stack inline" aria-live="polite" aria-atomic="true">
    <div class="flash-toast alert" role="alert" data-flash-toast>
      <div>
        <strong>Проверьте форму</strong>
        <p><%= reminder.errors.full_messages.to_sentence %></p>
      </div>
      <button type="button" aria-label="Закрыть уведомление" data-flash-close></button>
    </div>
  </div>
<% end %>

<%= form_with(model: [pet, reminder], class: "structured-form") do |form| %>
  <section class="form-section">
    <div class="form-section-heading">
      <div>
        <h2>Основное</h2>
        <p>Что нужно не забыть и когда отправить первое уведомление.</p>
      </div>
    </div>

    <div class="row g-3">
      <div class="col-md-7">
        <%= form.label :title, class: "form-label" %>
        <%= form.text_field :title, class: "form-control", placeholder: "Например: дать таблетку" %>
      </div>

      <div class="col-md-5">
        <%= form.label :reminder_type, class: "form-label" %>
        <%= form.select :reminder_type, reminder_type_options, {}, class: "form-select" %>
      </div>

      <div class="col-md-6">
        <%= form.label :remind_at, class: "form-label" %>
        <%= form.datetime_local_field :remind_at, class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= form.label :repeat_rule, class: "form-label" %>
        <%= form.select :repeat_rule, repeat_rule_options, {}, class: "form-select" %>
      </div>

      <div class="col-12">
        <%= form.label :note, class: "form-label" %>
        <%= form.text_area :note, rows: 4, class: "form-control", placeholder: "Дозировка, условия, комментарий для себя" %>
      </div>
    </div>
  </section>

  <section class="form-section">
    <div class="form-section-heading">
      <div>
        <h2>Каналы доставки</h2>
        <p>Можно выбрать конкретные каналы для этого напоминания. Если ничего не выбрать, будут использованы все включенные каналы.</p>
      </div>
    </div>

    <% if @notification_channels.any? %>
      <div class="channel-choice-grid">
        <% @notification_channels.each do |channel| %>
          <label class="channel-choice">
            <%= check_box_tag "reminder[notification_channel_ids][]",
                              channel.id,
                              reminder.notification_channel_ids.include?(channel.id),
                              class: "form-check-input" %>
            <span>
              <strong><%= channel.name %></strong>
              <small><%= channel.channel_type_label %> · <%= channel.channel_web_push? ? "Браузерная подписка" : channel.address %></small>
            </span>
          </label>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state-inline">
        <div class="fw-semibold mb-1">Каналы еще не настроены</div>
        <p class="text-muted mb-3">PetJournal отправит уведомление на эл. почту аккаунта, но лучше подключить нужные каналы заранее.</p>
        <%= link_to "Настроить каналы", notification_channels_path, class: "btn btn-outline-primary btn-sm" %>
      </div>
    <% end %>
  </section>

  <div class="form-actions">
    <%= form.submit reminder.persisted? ? "Сохранить" : "Создать напоминание", class: "btn btn-primary" %>
    <%= link_to "Отмена", pet_reminders_path(pet), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
