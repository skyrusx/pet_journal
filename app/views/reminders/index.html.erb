<% content_for :title, "Напоминания — #{@pet.name} — PetJournal" %>

<div class="pj-reminders-page pj-reminders-index">
  <header class="pj-workspace-topbar">
    <h1>Напоминания</h1>
    <%= link_to notification_channels_path, class: "pj-workspace-icon", aria: { label: "Настройки уведомлений" }, title: "Настройки уведомлений" do %>
      <%= pj_icon(:bell) %>
    <% end %>
  </header>

  <div class="pj-reminders-content">
    <div class="pj-reminders-heading">
      <div>
        <h1>Напоминания</h1>
        <p>Важные дела по уходу за питомцем — вовремя и без лишней суеты.</p>
      </div>
      <%= link_to new_pet_reminder_path(@pet), class: "pj-reminders-primary-button" do %>
        <%= pj_icon(:plus) %><span>Создать напоминание</span>
      <% end %>
    </div>

    <div class="pj-reminders-toolbar">
      <details class="pj-reminders-pet-switcher pj-journal-pet-switcher">
        <summary>
          <span class="pj-reminders-pet-avatar pj-journal-pet-avatar">
            <% if @pet.photo.attached? %>
              <%= image_tag @pet.photo, alt: "" %>
            <% else %>
              <%= @pet.name.to_s.first.to_s.upcase.presence || "P" %>
            <% end %>
          </span>
          <span class="pj-reminders-pet-switcher__copy"><small>Питомец</small><strong><%= @pet.name %></strong></span>
          <%= pj_icon(:chevron) %>
        </summary>
        <div class="pj-reminders-pet-menu pj-journal-pet-menu">
          <% @reminder_pets.each do |pet| %>
            <%= link_to pet_reminders_path(pet), class: class_names("pj-reminders-pet-option", "pj-journal-pet-option", active: pet == @pet) do %>
              <span class="pj-reminders-pet-avatar pj-journal-pet-avatar">
                <% if pet.photo.attached? %>
                  <%= image_tag pet.photo, alt: "" %>
                <% else %>
                  <%= pet.name.to_s.first.to_s.upcase.presence || "P" %>
                <% end %>
              </span>
              <span><strong><%= pet.name %></strong><small><%= pet.breed.presence || pet.species.presence || "Питомец" %></small></span>
            <% end %>
          <% end %>
        </div>
      </details>

      <div class="pj-reminders-summary" aria-label="Сводка по напоминаниям">
        <span><strong><%= @active_count %></strong> активно</span>
        <span class="<%= "is-alert" if @overdue_count.positive? %>"><strong><%= @overdue_count %></strong> просрочено</span>
        <span><strong><%= @completed_count %></strong> выполнено</span>
      </div>
    </div>

    <%= form_with url: pet_reminders_path(@pet), method: :get, class: "pj-reminders-filters" do |form| %>
      <div class="pj-reminders-filter">
        <%= select_tag :status,
                       options_for_select(
                         [
                           ["Все статусы", "all"],
                           ["Активные", "active"],
                           ["Сегодня", "today"],
                           ["Просроченные", "overdue"],
                           ["Пауза", "paused"],
                           ["Выполненные", "completed"]
                         ],
                         @selected_status
                       ),
                       aria: { label: "Статус" } %>
      </div>

      <div class="pj-reminders-filter">
        <%= select_tag :type,
                       options_for_select([["Все типы", ""]] + reminder_type_options, @selected_type),
                       aria: { label: "Тип напоминания" } %>
      </div>

      <div class="pj-reminders-search-row">
        <div class="pj-reminders-filter pj-reminders-filter--search">
          <span aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="5.75"/><path d="m15 15 4.25 4.25"/></svg>
          </span>
          <%= form.search_field :q,
                                value: @query,
                                placeholder: "Поиск по названию или заметке",
                                aria: { label: "Поиск по напоминаниям" } %>
        </div>

        <button type="submit" class="pj-reminders-filter-submit" aria-label="Применить фильтры">
          <span>Применить</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="5.75"/><path d="m15 15 4.25 4.25"/></svg>
        </button>
      </div>

      <% if @selected_status != "active" || @selected_type.present? || @query.present? %>
        <%= link_to "Сбросить", pet_reminders_path(@pet), class: "pj-reminders-filter-reset" %>
      <% end %>
    <% end %>

    <% if @reminders.any? %>
      <div class="pj-reminders-table-wrap">
        <div class="pj-reminders-table-head">
          <span>Название</span>
          <span>Питомец</span>
          <span>Тип</span>
          <span>Дата и время</span>
          <span>Повтор</span>
          <span>Статус</span>
          <span></span>
        </div>

        <% @reminders.each do |reminder| %>
          <article class="pj-reminders-row-wrap">
            <%= link_to pet_reminder_path(@pet, reminder), class: "pj-reminders-row" do %>
              <span class="pj-reminders-row__title">
                <span class="pj-reminders-row__icon <%= reminder_type_tone(reminder) %>"><%= reminder_type_icon(reminder.reminder_type) %></span>
                <span><strong><%= reminder.title %></strong><small><%= reminder.note.present? ? truncate(reminder.note, length: 46) : "Без заметки" %></small></span>
              </span>
              <span class="pj-reminders-row__pet"><%= reminder.pet.name %></span>
              <span><%= reminder.reminder_type_label %></span>
              <span class="pj-reminders-row__date"><strong><%= reminder.next_run_at.strftime("%d.%m.%Y") %></strong><small><%= reminder.next_run_at.strftime("%H:%M") %></small></span>
              <span><%= reminder.repeat_rule_label %></span>
              <span><em class="pj-reminder-status <%= reminder_status_tone(reminder) %>"><%= reminder_status_label(reminder) %></em></span>
              <span class="pj-reminders-row__chevron"><%= pj_icon(:chevron) %></span>
            <% end %>

            <%= link_to edit_pet_reminder_path(reminder.pet, reminder),
                        class: "pj-reminders-row__edit",
                        aria: { label: "Редактировать #{reminder.title}" },
                        title: "Редактировать" do %>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 20l4.1-1 10.8-10.8a2.1 2.1 0 0 0-3-3L5.1 16 4 20z"/>
                <path d="m14.6 6.5 3 3"/>
              </svg>
            <% end %>
          </article>
        <% end %>
      </div>

      <div class="pj-reminders-mobile-list">
        <% @reminders.each do |reminder| %>
          <article class="pj-reminders-mobile-card-wrap">
            <%= link_to pet_reminder_path(reminder.pet, reminder), class: "pj-reminders-mobile-card" do %>
              <span class="pj-reminders-row__icon <%= reminder_type_tone(reminder) %>"><%= reminder_type_icon(reminder.reminder_type) %></span>
              <span class="pj-reminders-mobile-card__body">
                <small><%= reminder.next_run_at.strftime("%d.%m.%Y, %H:%M") %> · <%= reminder.pet.name %></small>
                <strong><%= reminder.title %></strong>
                <span><%= reminder.reminder_type_label %> · <%= reminder.repeat_rule_label %></span>
                <em class="pj-reminder-status <%= reminder_status_tone(reminder) %>"><%= reminder_status_label(reminder) %></em>
              </span>
            <% end %>

            <%= link_to edit_pet_reminder_path(reminder.pet, reminder),
                        class: "pj-reminders-row__edit",
                        aria: { label: "Редактировать #{reminder.title}" },
                        title: "Редактировать" do %>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 20l4.1-1 10.8-10.8a2.1 2.1 0 0 0-3-3L5.1 16 4 20z"/>
                <path d="m14.6 6.5 3 3"/>
              </svg>
            <% end %>
          </article>
        <% end %>
      </div>
    <% else %>
      <section class="pj-reminders-empty">
        <span><%= pj_icon(:alarm) %></span>
        <h2><%= @query.present? || @selected_type.present? || @selected_status != "active" ? "Ничего не найдено" : "Напоминаний пока нет" %></h2>
        <p>Создайте напоминание о прививке, лекарстве, обработке или другом важном деле.</p>
        <%= link_to "Создать напоминание", new_pet_reminder_path(@pet), class: "pj-reminders-primary-button" %>
      </section>
    <% end %>
  </div>
</div>
