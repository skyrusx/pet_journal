<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "PetJournal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <%= favicon_link_tag "petjournal/favicon.ico" %>
    <%= favicon_link_tag "petjournal/favicon-32.png", rel: "icon", type: "image/png" %>
    <%= favicon_link_tag "petjournal/favicon-512.png", rel: "apple-touch-icon", type: "image/png" %>

    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
    <%= javascript_import_module_tag "dashboard_sidebar" %>
    <%= javascript_import_module_tag "pet_photo_preview" %>
    <%= javascript_import_module_tag "pet_gallery" %>
    <%= javascript_import_module_tag "pet_gallery_upload" %>
    <%= javascript_import_module_tag "pet_gallery_sortable" %>
    <%= javascript_import_module_tag "pet_gallery_keyboard" %>
    <%= javascript_import_module_tag "pet_main_photo" %>
    <%= javascript_import_module_tag "pet_profile_photo_zoom" %>
    <%= javascript_import_module_tag "pet_crop_zoom_steps" %>
    <%= javascript_import_module_tag "pet_avatar_crop" %>
    <%= javascript_import_module_tag "journal_event_wizard" %>
    <%= javascript_import_module_tag "document_file_preview" %>
    <%= javascript_import_module_tag "notification_channels" %>
    <%= javascript_import_module_tag "account_profile" %>
    <%= javascript_import_module_tag "birthday_greeting" %>
    <%= javascript_include_tag "public_access_copy", defer: true %>
  </head>

  <body class="<%= class_names('pj-dashboard-body', 'ym-hide-content', current_user&.interface_text_size_css_class) %>">
    <div class="pj-dash" data-dashboard-root>
      <div class="pj-dash-shell">
        <%= render "shared/workspace_sidebar" %>

        <main class="pj-dash-main pj-workspace-main">
          <%= yield %>

          <footer class="pj-dash-footer pj-workspace-footer">
            <span>© <%= Date.current.year %> PetJournal.</span>
            <span>Сделано с заботой о тех, кто рядом ♡</span>
          </footer>
        </main>
      </div>
    </div>

    <%= render "shared/dashboard_mobile_chrome" if user_signed_in? %>
    <%= render "shared/birthday_greeting" if user_signed_in? %>

    <% if notice.present? || alert.present? %>
      <div class="flash-stack" aria-live="polite" aria-atomic="true">
        <% if notice.present? %>
          <div class="flash-toast notice" role="status" data-flash-toast>
            <div><strong>Готово</strong><p><%= notice %></p></div>
            <button type="button" aria-label="Закрыть уведомление" data-flash-close></button>
          </div>
        <% end %>

        <% if alert.present? %>
          <div class="flash-toast alert" role="alert" data-flash-toast>
            <div><strong>Внимание</strong><p><%= alert %></p></div>
            <button type="button" aria-label="Закрыть уведомление" data-flash-close></button>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= render "shared/yandex_metrika" %>
  </body>
</html>
