<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "PetJournal" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#07392f">
    <meta name="color-scheme" content="light">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <%= render "shared/pwa_head" %>

    <%= favicon_link_tag "petjournal/favicon.ico" %>
    <%= favicon_link_tag "petjournal/favicon-32.png", rel: "icon", type: "image/png" %>
    <%= favicon_link_tag "petjournal/favicon-512.png", rel: "apple-touch-icon", type: "image/png" %>

    <%= stylesheet_link_tag "application" %>
    <%= stylesheet_link_tag "new_design_footer" %>
    <%= javascript_importmap_tags %>
    <%= javascript_import_module_tag "pwa" %>
  </head>

  <body class="app-body pj-legal-body">
    <%= render "shared/legal_navigation" %>
    <main class="pj-legal-main">
      <%= yield %>
    </main>
    <%= render "pages/new_design_footer" %>
  </body>
</html>
