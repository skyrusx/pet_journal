<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "PetJournal PetTag" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      (function () {
        var storedTheme = localStorage.getItem("petjournal-theme");
        var systemDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = storedTheme || (systemDark ? "dark" : "light");
      })();
    </script>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-body public-body">
    <%= yield %>

    <% if notice.present? || alert.present? %>
      <div class="flash-stack" aria-live="polite" aria-atomic="true">
        <% if notice.present? %>
          <div class="flash-toast notice" role="status" data-flash-toast>
            <div>
              <strong>Готово</strong>
              <p><%= notice %></p>
            </div>
            <button type="button" aria-label="Закрыть уведомление" data-flash-close></button>
          </div>
        <% end %>

        <% if alert.present? %>
          <div class="flash-toast alert" role="alert" data-flash-toast>
            <div>
              <strong>Внимание</strong>
              <p><%= alert %></p>
            </div>
            <button type="button" aria-label="Закрыть уведомление" data-flash-close></button>
          </div>
        <% end %>
      </div>
    <% end %>

    <button type="button" class="theme-fab" data-theme-toggle aria-label="Переключить тему">
      <span class="theme-fab-icon" aria-hidden="true"></span>
    </button>
  </body>
</html>
