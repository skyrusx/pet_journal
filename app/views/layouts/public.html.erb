<% public_pet_tag_layout = controller_name == "public_pet_tags" %>
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "PetJournal PetTag" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= favicon_link_tag "petjournal/favicon.ico" %>
    <%= favicon_link_tag "petjournal/favicon-32.png", rel: "icon", type: "image/png" %>
    <%= favicon_link_tag "petjournal/favicon-512.png", rel: "apple-touch-icon", type: "image/png" %>

    <%= stylesheet_link_tag "application" %>
    <% if public_pet_tag_layout %>
      <%= stylesheet_link_tag "new_design" %>
      <%= stylesheet_link_tag "new_design_mobile" %>
    <% end %>
    <%= stylesheet_link_tag "new_design_footer" %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "public_pettag_location", defer: true %>
  </head>

  <body class="<%= class_names("app-body", "public-body", {
    "public-profile-layout-body" => controller_name == "public_pet_profile_shares",
    "public-pettag-layout-body" => public_pet_tag_layout,
    "pj-new-design-body" => public_pet_tag_layout
  }) %>">
    <% if public_pet_tag_layout %>
      <div class="pj-new-design pj-public-pettag-site">
        <%= render "pages/new_design_navbar",
                   brand_path: root_path,
                   features_path: root_path(anchor: "features"),
                   how_it_works_path: root_path(anchor: "how-it-works") %>

        <%= yield %>

        <%= render "devise/shared/auth_v2_footer" %>
      </div>
    <% else %>
      <%= yield %>
      <%= render "pages/new_design_footer" if controller_name == "public_pet_profile_shares" %>
    <% end %>

    <% if notice.present? || alert.present? %>
      <div class="flash-stack" aria-live="polite" aria-atomic="true">
        <% if notice.present? %>
          <div class="flash-toast notice" role="status" data-flash-toast>
            <div>
              <strong>Готово</strong>
              <p><%= notice %></p>
            </div>
            <button type="button" aria-label="Закрыть уведомление" data-flash-close></button>
          </div>
        <% end %>

        <% if alert.present? %>
          <div class="flash-toast alert" role="alert" data-flash-toast>
            <div>
              <strong>Внимание</strong>
              <p><%= alert %></p>
            </div>
            <button type="button" aria-label="Закрыть уведомление" data-flash-close></button>
          </div>
        <% end %>
      </div>
    <% end %>
  </body>
</html>
