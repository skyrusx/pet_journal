<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "PetJournal" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= render "shared/pwa_head", include_styles: false %>

    <%= favicon_link_tag "petjournal/favicon.ico" %>
    <%= favicon_link_tag "petjournal/favicon-32.png", rel: "icon", type: "image/png" %>
    <%= favicon_link_tag "petjournal/favicon-512.png", rel: "apple-touch-icon", type: "image/png" %>

    <%= stylesheet_link_tag "application" %>
    <%= stylesheet_link_tag "pwa_compact" %>
    <%= javascript_importmap_tags %>
    <%= javascript_import_module_tag "authenticated" %>
  </head>

  <body class="<%= class_names('pj-dashboard-body', current_user&.interface_text_size_css_class) %>" data-pwa-install-autoprompt="true">
    <div class="pj-dash" data-dashboard-root>
      <div class="pj-dash-shell">
        <%= render "shared/sidebar" %>

        <main class="pj-dash-main pj-workspace-main">
          <%= yield %>
          <%= render "shared/footer" %>
        </main>
      </div>
    </div>

    <%= render "shared/mobile_chrome" %>
    <%= render "shared/birthday_greeting" %>
    <%= render "shared/flashes" %>
  </body>
</html>
