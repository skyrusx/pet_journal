<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "PetJournal" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#07392f">
    <meta name="color-scheme" content="light">
    <meta name="application-name" content="PetJournal">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="PetJournal">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <%= favicon_link_tag "petjournal/favicon.ico" %>
    <%= favicon_link_tag "petjournal/favicon-32.png", rel: "icon", type: "image/png" %>
    <%= favicon_link_tag "petjournal/favicon-512.png", rel: "apple-touch-icon", type: "image/png" %>

    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
    <%= javascript_import_module_tag "pwa" %>
  </head>

  <% landing_page = controller_name == "pages" && action_name == "index" && !user_signed_in? %>
  <% guest_auth_page = devise_controller? && !user_signed_in? %>
  <% internal_page = !(landing_page || guest_auth_page) %>
  <body class="app-body <%= "app-internal-body" if internal_page %> <%= "pj-landing-body" if landing_page %> <%= "pj-auth-body" if guest_auth_page %>">
    <% unless landing_page || guest_auth_page %>
    <header class="app-header">
      <div class="app-shell app-header-inner app-header-desktop">
        <%= link_to root_path, class: "app-brand", aria: { label: "PetJournal — рабочий стол" } do %>
          <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", width: 168, height: 48 %>
        <% end %>

        <nav class="app-nav" aria-label="Основная навигация">
          <% if user_signed_in? %>
            <%= app_nav_link "Рабочий стол", root_path, active: request.path == root_path %>
            <%= app_nav_link "Мои питомцы", pets_path, active: request.path.start_with?(pets_path) %>
            <%= app_nav_link "Уведомления", notification_channels_path, active: controller_name == "notification_channels" %>
          <% else %>
            <%= app_nav_link "Войти", new_user_session_path %>
            <%= link_to "Регистрация", new_user_registration_path, class: "btn btn-primary btn-sm" %>
          <% end %>
        </nav>

        <% if user_signed_in? %>
          <details class="app-user-menu">
            <summary class="<%= "active" if devise_controller? %>" aria-label="Меню пользователя <%= current_user.email %>">
              <span class="app-user-avatar" aria-hidden="true"><%= current_user.email.to_s.first.to_s.upcase.presence || "P" %></span>
              <span class="app-user-email"><%= current_user.email %></span>
            </summary>
            <div class="app-user-dropdown">
              <div class="app-user-dropdown-email"><%= current_user.email %></div>
              <%= link_to "Настройки аккаунта",
                          edit_user_registration_path,
                          class: class_names("app-user-dropdown-link", active: devise_controller?) %>
              <div class="app-user-dropdown-separator" aria-hidden="true"></div>
              <%= button_to "Выйти",
                            destroy_user_session_path,
                            method: :delete,
                            class: "app-user-dropdown-link app-user-dropdown-danger",
                            form_class: "app-user-dropdown-form" %>
            </div>
          </details>
        <% end %>
      </div>

      <div class="app-shell mobile-app-header">
        <%= link_to root_path, class: "mobile-app-brand", aria: { label: "PetJournal — рабочий стол" } do %>
          <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", width: 132, height: 38 %>
        <% end %>

        <% if user_signed_in? %>
          <% pet = mobile_nav_pet %>
          <div class="mobile-header-actions">
            <%= link_to notification_channels_path,
                        class: class_names("mobile-header-icon", active: controller_name == "notification_channels"),
                        aria: { label: "Уведомления" } do %>
              <%= pj_icon(:bell) %>
              <% if mobile_notifications_badge.present? %>
                <span class="mobile-nav-badge"><%= mobile_notifications_badge %></span>
              <% end %>
            <% end %>

            <%= link_to pet.present? ? pet_path(pet) : edit_user_registration_path,
                        class: "mobile-header-avatar",
                        aria: { label: pet.present? ? "Профиль питомца #{pet.name}" : "Аккаунт" } do %>
              <% if pet&.photo&.attached? %>
                <%= image_tag pet.photo, alt: "", loading: "lazy" %>
              <% else %>
                <span><%= (pet&.name || current_user.email).to_s.first.to_s.upcase.presence || "P" %></span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </header>
    <% end %>

    <% if landing_page %>
    <div class="pj-landing-main">
      <%= yield %>
    </div>
    <% elsif guest_auth_page %>
    <main class="pj-auth-main">
      <%= yield %>
    </main>
    <% else %>
    <main class="app-shell app-main">
      <%= yield %>
    </main>
    <% end %>

    <% if internal_page %>
      <% if user_signed_in? %>
        <% mobile_nav_items = mobile_bottom_nav_items %>
        <div data-mobile-sheet-root>
          <div class="mobile-sheet-backdrop" data-mobile-sheet-backdrop hidden></div>

          <nav class="mobile-bottom-nav" aria-label="Основная мобильная навигация">
            <% mobile_nav_items.first(2).each do |item| %>
              <%= link_to item[:path],
                          class: class_names("mobile-bottom-nav-item", active: item[:active]),
                          aria: { current: item[:active] ? "page" : nil, label: item[:aria_label] || item[:label] } do %>
                <%= pj_icon(item[:icon]) %>
                <span class="mobile-bottom-label"><%= item[:label] %></span>
              <% end %>
            <% end %>

            <button class="mobile-bottom-nav-item mobile-bottom-add"
                    type="button"
                    aria-label="Добавить"
                    aria-controls="mobile-add-sheet"
                    aria-expanded="false"
                    data-mobile-sheet-open>
              <span class="mobile-bottom-add-icon"><%= pj_icon(:plus) %></span>
              <span class="mobile-bottom-label">Добавить</span>
            </button>

            <% reminders_item = mobile_nav_items.third %>
            <%= link_to reminders_item[:path],
                        class: class_names("mobile-bottom-nav-item", active: reminders_item[:active]),
                        aria: { current: reminders_item[:active] ? "page" : nil, label: reminders_item[:aria_label] } do %>
              <span class="mobile-bottom-icon-wrap">
                <%= pj_icon(reminders_item[:icon]) %>
                <% if reminders_item[:badge].present? %>
                  <span class="mobile-nav-badge"><%= reminders_item[:badge] %></span>
                <% end %>
              </span>
              <span class="mobile-bottom-label"><%= reminders_item[:label] %></span>
            <% end %>

            <% more_item = mobile_nav_items.fourth %>
            <button class="<%= class_names("mobile-bottom-nav-item", active: more_item[:active]) %>"
                    type="button"
                    aria-label="Ещё"
                    aria-controls="mobile-more-sheet"
                    aria-expanded="false"
                    data-mobile-sheet-open>
              <%= pj_icon(more_item[:icon]) %>
              <span class="mobile-bottom-label"><%= more_item[:label] %></span>
            </button>
          </nav>

          <section class="mobile-sheet"
                   id="mobile-add-sheet"
                   role="dialog"
                   aria-modal="true"
                   aria-labelledby="mobile-add-title"
                   aria-hidden="true"
                   hidden
                   data-mobile-sheet>
            <div class="mobile-sheet-handle" aria-hidden="true"></div>
            <div class="mobile-sheet-header">
              <h2 id="mobile-add-title">Добавить</h2>
              <button class="mobile-sheet-close" type="button" aria-label="Закрыть" data-mobile-sheet-close></button>
            </div>
            <div class="mobile-sheet-list">
              <% mobile_add_actions.each do |item| %>
                <%= link_to item[:path], class: "mobile-sheet-link", data: { mobile_sheet_link: true } do %>
                  <span class="mobile-sheet-link-icon"><%= pj_icon(item[:icon]) %></span>
                  <span><%= item[:label] %></span>
                  <%= pj_icon(:chevron, class: "mobile-sheet-chevron") %>
                <% end %>
              <% end %>
            </div>
          </section>

          <section class="mobile-sheet"
                   id="mobile-more-sheet"
                   role="dialog"
                   aria-modal="true"
                   aria-labelledby="mobile-more-title"
                   aria-hidden="true"
                   hidden
                   data-mobile-sheet>
            <div class="mobile-sheet-handle" aria-hidden="true"></div>
            <div class="mobile-sheet-header">
              <h2 id="mobile-more-title">Ещё</h2>
              <button class="mobile-sheet-close" type="button" aria-label="Закрыть" data-mobile-sheet-close></button>
            </div>

            <% pet = mobile_nav_pet %>
            <% if pet.present? %>
              <%= link_to pet_path(pet), class: "mobile-sheet-pet", data: { mobile_sheet_link: true } do %>
                <% if pet.photo.attached? %>
                  <%= image_tag pet.photo, class: "mobile-sheet-pet-photo", alt: "", loading: "lazy" %>
                <% else %>
                  <span class="mobile-sheet-pet-photo mobile-sheet-pet-placeholder"><%= pet.name.to_s.first.to_s.upcase.presence || "P" %></span>
                <% end %>
                <span class="mobile-sheet-pet-copy">
                  <strong><%= pet.name %></strong>
                  <small><%= pet_short_description(pet) %></small>
                </span>
                <%= pj_icon(:chevron, class: "mobile-sheet-chevron") %>
              <% end %>
            <% end %>

            <div class="mobile-sheet-list">
              <% mobile_more_menu_items.each do |item| %>
                <%= link_to item[:path],
                            class: class_names("mobile-sheet-link", active: item[:active]),
                            data: { mobile_sheet_link: true },
                            aria: { current: item[:active] ? "page" : nil } do %>
                  <span class="mobile-sheet-link-icon"><%= pj_icon(item[:icon]) %></span>
                  <span><%= item[:label] %></span>
                  <% if item[:badge].present? %>
                    <span class="mobile-sheet-badge"><%= item[:badge] %></span>
                  <% end %>
                  <%= pj_icon(:chevron, class: "mobile-sheet-chevron") %>
                <% end %>
              <% end %>
            </div>

            <div class="mobile-sheet-separator" aria-hidden="true"></div>
            <%= button_to destroy_user_session_path,
                          method: :delete,
                          class: "mobile-sheet-link mobile-sheet-logout",
                          form_class: "mobile-sheet-form",
                          data: { mobile_sheet_link: true } do %>
              <span class="mobile-sheet-link-icon"><%= pj_icon(:logout) %></span>
              <span>Выйти</span>
            <% end %>
          </section>
        </div>
      <% end %>

      <footer class="app-footer">
        <div class="app-shell app-footer-inner">
          <div class="app-footer-main">
            <div class="app-footer-brand">
              <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", width: 142, height: 41 %>
              <p>Всё важное о питомцах — рядом.</p>
            </div>

            <nav class="app-footer-nav" aria-label="Навигация в подвале">
              <%= link_to "Рабочий стол", root_path %>
              <%= link_to "Мои питомцы", pets_path %>
              <%= link_to "Уведомления", notification_channels_path %>
              <%= link_to "Настройки аккаунта", edit_user_registration_path %>
            </nav>

            <div class="app-footer-support">
              <div>Поддержка</div>
              <%= mail_to "support@pet-journal.ru" %>
              <%= link_to "VK PetJournal", "https://vk.ru/petjournal", target: "_blank", rel: "noopener" %>
              <button type="button" class="pwa-install-link" data-pwa-install-button hidden>Установить PetJournal</button>
            </div>
          </div>

          <div class="app-footer-bottom">
            <span>© <%= Date.current.year %> PetJournal</span>
            <span>Сделано с заботой о тех, кто рядом ♡</span>
          </div>
        </div>
      </footer>
    <% end %>

    <% if notice.present? || alert.present? %>
      <div class="flash-stack" aria-live="polite" aria-atomic="true">
        <% if notice.present? %>
          <div class="flash-toast notice" role="status" data-flash-toast>
            <div>
              <strong>Готово</strong>
              <p><%= notice %></p>
            </div>
            <button type="button" aria-label="Закрыть уведомление" data-flash-close></button>
          </div>
        <% end %>

        <% if alert.present? %>
          <div class="flash-toast alert" role="alert" data-flash-toast>
            <div>
              <strong>Внимание</strong>
              <p><%= alert %></p>
            </div>
            <button type="button" aria-label="Закрыть уведомление" data-flash-close></button>
          </div>
        <% end %>
      </div>
    <% end %>
  </body>
</html>
