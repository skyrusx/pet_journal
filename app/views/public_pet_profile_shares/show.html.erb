<% content_for :title, "#{@pet.name} · PetJournal" %>

<div class="pj-public-profile-page">
  <header class="pj-public-profile-topbar">
    <div class="pj-public-profile-topbar__inner">
      <%= link_to root_path, class: "pj-public-profile-brand", aria: { label: "PetJournal" } do %>
        <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal" %>
      <% end %>

      <button type="button" class="pj-public-profile-share-button" data-copy-url="<%= request.original_url %>">
        <%= pj_icon(:share) %>
        <span>Поделиться</span>
      </button>
    </div>
  </header>

  <main class="pj-public-profile-shell">
    <div class="pj-public-profile-layout">
      <section class="pj-public-profile-primary">
        <div class="pj-public-profile-photo-wrap">
          <% if @pet.photo.attached? %>
            <%= image_tag @pet.photo, class: "pj-public-profile-photo", alt: @pet.name %>
          <% else %>
            <div class="pj-public-profile-photo pj-public-profile-photo--placeholder"><%= @pet.name.to_s.first.to_s.upcase.presence || "P" %></div>
          <% end %>
        </div>

        <div class="pj-public-profile-identity">
          <div class="pj-public-profile-identity__title">
            <div>
              <h1><%= @pet.name %></h1>
              <p><%= pet_short_description(@pet) %></p>
            </div>
            <% if @pet.pet_tag&.enabled? %>
              <span class="pj-public-profile-verified" title="Профиль связан с PetTag">✓</span>
            <% end %>
          </div>

          <div class="pj-public-profile-meta">
            <span><%= pet_age(@pet) %></span>
            <% if @share.show_profile? %>
              <span><%= pet_weight_label(@pet.weight) %></span>
              <span><%= pet_sex_label(@pet) %></span>
            <% end %>
          </div>
        </div>

        <% if @share.show_profile? %>
          <section class="public-share-section pj-public-profile-section">
            <div class="pj-public-profile-section__head">
              <h2>О питомце</h2>
            </div>

            <dl class="pj-public-profile-details">
              <div><dt>Вид</dt><dd><%= @pet.species.presence || "—" %></dd></div>
              <div><dt>Порода</dt><dd><%= @pet.breed.presence || "—" %></dd></div>
              <div><dt>Дата рождения</dt><dd><%= @pet.birth_date.present? ? @pet.birth_date.strftime("%d.%m.%Y") : "—" %></dd></div>
              <div><dt>Окрас</dt><dd><%= @pet.color.presence || "—" %></dd></div>
              <div><dt>Чип</dt><dd><%= @pet.chip_number.presence || "—" %></dd></div>
              <% if @share.detail_full? %>
                <div><dt>Ветпаспорт</dt><dd><%= @pet.passport_number.presence || "—" %></dd></div>
                <div><dt>Стерилизация</dt><dd><%= @pet.neutered.nil? ? "—" : (@pet.neutered ? "Да" : "Нет") %></dd></div>
              <% end %>
            </dl>

            <% if @share.detail_full? && @pet.notes.present? %>
              <div class="pj-public-profile-note">
                <strong>Заметки владельца</strong>
                <%= simple_format(@pet.notes) %>
              </div>
            <% end %>
          </section>
        <% end %>

        <% if @share.show_owner_contact? %>
          <section class="public-share-section pj-public-profile-section pj-public-profile-contact">
            <div>
              <small>Контакт владельца</small>
              <h2>Связаться с владельцем</h2>
              <p>Используйте контакт только по вопросу этого питомца.</p>
            </div>
            <%= mail_to @pet.user.email, @pet.user.email, class: "pj-public-profile-primary-action" %>
          </section>
        <% end %>

        <% if @share.show_pet_tag? && @pet_tag.present? %>
          <section class="public-share-section pj-public-profile-section pj-public-profile-pettag">
            <div class="pj-public-profile-section__head pj-public-profile-section__head--split">
              <div>
                <small>Безопасность</small>
                <h2>PetTag</h2>
              </div>
              <span class="<%= pet_tag_status_class(@pet_tag) %>"><%= pet_tag_status_label(@pet_tag) %></span>
            </div>

            <% if @pet_tag.lost_mode_enabled? %>
              <div class="pj-public-profile-alert">
                <strong>Питомец отмечен как потерявшийся</strong>
                <p><%= @pet_tag.lost_message.presence || "Если вы видели питомца, свяжитесь с владельцем." %></p>
              </div>
            <% end %>

            <div class="pj-public-profile-pettag__grid">
              <div><strong>Сообщение</strong><p><%= @pet_tag.public_message.presence || "Публичное сообщение не заполнено." %></p></div>
              <div><strong>Особенности поведения</strong><p><%= @pet_tag.behavior_notes.presence || "Не указаны." %></p></div>
              <% if @pet_tag.show_medical_notes? %>
                <div><strong>Медицинские заметки</strong><p><%= @pet_tag.medical_notes.presence || "Не указаны." %></p></div>
              <% end %>
            </div>

            <% if @pet_tag.show_phone? && @pet_tag.contact_phone.present? %>
              <%= link_to "Позвонить владельцу", "tel:#{@pet_tag.contact_phone}", class: "pj-public-profile-primary-action" %>
            <% end %>
          </section>
        <% end %>
      </section>

      <aside class="pj-public-profile-secondary">
        <% if @share.show_journal? %>
          <section class="public-share-section pj-public-profile-side-card">
            <div class="pj-public-profile-section__head pj-public-profile-section__head--split">
              <div>
                <small>Журнал</small>
                <h2>Недавние записи</h2>
              </div>
              <span class="pj-public-profile-count"><%= @share.detail_full? ? "до 50" : "5" %></span>
            </div>

            <% if @events.any? %>
              <div class="pj-public-profile-journal-list">
                <% @events.each do |event| %>
                  <article class="pj-public-profile-journal-item">
                    <span class="pj-public-profile-journal-item__icon"><%= pj_icon(:journal) %></span>
                    <div>
                      <time><%= event.event_date.strftime("%d.%m.%Y") %></time>
                      <strong><%= event.title.presence || event.event_type_label %></strong>
                      <p><%= event_structured_summary(event) %></p>

                      <% if @share.detail_full? && event.structured? %>
                        <div class="pj-public-profile-inline-meta">
                          <% event.structured_rows.each do |label, value| %>
                            <span><%= label %>: <strong><%= value %></strong></span>
                          <% end %>
                        </div>
                      <% end %>

                      <% if event.files.attached? %>
                        <div class="pj-public-profile-file-list">
                          <% event.files.each do |file| %>
                            <% if @share.allow_file_downloads? %>
                              <%= link_to event_file_label(file), url_for(file) %>
                            <% else %>
                              <span><%= event_file_label(file) %></span>
                            <% end %>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </article>
                <% end %>
              </div>
            <% else %>
              <div class="pj-public-profile-side-empty">В журнале пока нет записей.</div>
            <% end %>
          </section>
        <% end %>

        <% if @share.show_documents? %>
          <section class="public-share-section pj-public-profile-side-card">
            <div class="pj-public-profile-section__head pj-public-profile-section__head--split">
              <div>
                <small>Документы</small>
                <h2>Документы питомца</h2>
              </div>
              <% if @share.allow_file_downloads? %><span class="pj-public-profile-count">скачивание</span><% end %>
            </div>

            <% if @documents.any? %>
              <div class="pj-public-profile-document-list">
                <% @documents.each do |document| %>
                  <article class="pj-public-profile-document-item">
                    <span><%= pj_icon(:file) %></span>
                    <div>
                      <strong><%= document.title %></strong>
                      <small>
                        <%= document.document_type_label %>
                        <% if document.expires_on.present? %> · до <%= document.expires_on.strftime("%d.%m.%Y") %><% end %>
                      </small>
                      <% if @share.detail_full? && document.notes.present? %><p><%= document.notes %></p><% end %>

                      <% if document.files.attached? %>
                        <div class="pj-public-profile-file-list">
                          <% document.files.each do |file| %>
                            <% if @share.allow_file_downloads? %>
                              <%= link_to event_file_label(file), url_for(file) %>
                            <% else %>
                              <span><%= event_file_label(file) %></span>
                            <% end %>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                    <em><%= document.status_label %></em>
                  </article>
                <% end %>
              </div>
            <% else %>
              <div class="pj-public-profile-side-empty">Документы пока не добавлены.</div>
            <% end %>
          </section>
        <% end %>

        <% if @share.show_reminders? %>
          <section class="public-share-section pj-public-profile-side-card">
            <div class="pj-public-profile-section__head">
              <small>Забота</small>
              <h2>Предстоящие напоминания</h2>
            </div>

            <% if @reminders.any? %>
              <div class="pj-public-profile-reminder-list">
                <% @reminders.each do |reminder| %>
                  <article class="pj-public-profile-reminder-item">
                    <span><%= pj_icon(:alarm) %></span>
                    <div>
                      <strong><%= reminder.title %></strong>
                      <small><%= reminder.reminder_type_label %> · <%= reminder.repeat_rule_label %></small>
                      <% if @share.detail_full? && reminder.note.present? %><p><%= reminder.note %></p><% end %>
                    </div>
                    <time class="<%= reminder.overdue? ? "is-overdue" : "" %>"><%= reminder.next_run_at.strftime("%d.%m · %H:%M") %></time>
                  </article>
                <% end %>
              </div>
            <% else %>
              <div class="pj-public-profile-side-empty">Активных напоминаний нет.</div>
            <% end %>
          </section>
        <% end %>
      </aside>
    </div>

    <footer class="pj-public-profile-footer">
      <span>Информация предоставлена владельцем питомца в PetJournal.</span>
      <span>Публичная ссылка показывает только выбранные владельцем данные.</span>
    </footer>
  </main>
</div>
