<div class="events-index journal-dashboard py-4">
  <section class="journal-workspace-hero mb-4">
    <div class="journal-hero-main">
      <div>
        <div class="text-muted small mb-1"><%= @pet.name %></div>
        <h1 class="h3 mb-2">Журнал событий</h1>
        <p class="text-muted mb-0">История здоровья, ухода, документов и будущих действий в хронологическом порядке.</p>
      </div>

      <div class="journal-current-signal">
        <span>Последняя активность</span>
        <% if @latest_event.present? %>
          <h2><%= @latest_event.title.presence || @latest_event.event_type_label %></h2>
          <p><%= @latest_event.event_date.strftime("%d.%m.%Y") %> · <%= event_structured_summary(@latest_event) %></p>
        <% else %>
          <h2>Журнал пока пуст</h2>
          <p>Добавьте первую запись, чтобы видеть историю питомца на обзоре и главной.</p>
        <% end %>
      </div>
    </div>

    <div class="journal-metrics">
      <div>
        <span><%= @total_events_count %></span>
        <small><%= russian_plural(@total_events_count, "запись", "записи", "записей") %></small>
      </div>
      <div>
        <span><%= @event_type_counts.keys.size %></span>
        <small><%= russian_plural(@event_type_counts.keys.size, "тип", "типа", "типов") %></small>
      </div>
      <div>
        <span><%= @events_with_files_count %></span>
        <small>с файлами</small>
      </div>
      <div>
        <span><%= @events_with_follow_up_count %></span>
        <small>с будущим действием</small>
      </div>
    </div>

    <div class="journal-quick-actions">
      <%= link_to "Добавить событие", new_pet_pet_event_path(@pet), class: "btn btn-primary" %>
      <%= link_to "Обзор питомца", pet_path(@pet), class: "btn btn-outline-secondary" %>
      <% quick_event_actions(@pet).each do |label, path| %>
        <%= link_to label, path, class: "btn btn-outline-primary btn-sm" %>
      <% end %>
    </div>
  </section>

  <nav class="pet-tabs mb-4" aria-label="Навигация питомца">
    <%= link_to "Обзор", pet_path(@pet), class: "pet-tab" %>
    <%= link_to "Журнал", pet_pet_events_path(@pet), class: "pet-tab active" %>
    <%= link_to "Напоминания", pet_reminders_path(@pet), class: "pet-tab" %>
    <%= link_to "Документы", pet_pet_documents_path(@pet), class: "pet-tab" %>
    <%= link_to "Жетон", pet_pet_tag_path(@pet), class: "pet-tab" %>
    <%= link_to "Доступ", pet_profile_shares_path(@pet), class: "pet-tab" %>
    <%= link_to "Данные", edit_pet_path(@pet), class: "pet-tab" %>
  </nav>

  <section class="journal-filter-panel mb-4">
    <div class="section-heading compact">
      <div>
        <div class="text-muted small mb-1">Фильтры</div>
        <h2 class="h5 mb-0"><%= journal_filter_summary(@selected_event_type, @selected_period, @selected_status, @query) %></h2>
      </div>
      <% if @selected_event_type.present? || @selected_period.present? || @selected_status.present? || @query.present? %>
        <%= link_to "Сбросить все", pet_pet_events_path(@pet), class: "btn btn-outline-secondary btn-sm" %>
      <% end %>
    </div>

    <%= form_with url: pet_pet_events_path(@pet), method: :get, class: "journal-search mb-3" do |form| %>
      <%= hidden_field_tag :type, @selected_event_type %>
      <%= hidden_field_tag :period, @selected_period %>
      <%= hidden_field_tag :status, @selected_status %>
      <%= form.search_field :q, value: @query, class: "form-control", placeholder: "Поиск: препарат, клиника, врач, диагноз, симптомы, рекомендации" %>
      <%= form.submit "Найти", class: "btn btn-outline-primary" %>
      <% if @query.present? %>
        <%= link_to "Очистить поиск",
                    pet_pet_events_path(@pet, type: @selected_event_type, period: @selected_period, status: @selected_status),
                    class: "btn btn-outline-secondary" %>
      <% end %>
    <% end %>

    <div class="journal-filter-group">
      <div>
        <div class="filter-panel-title">Тип события</div>
        <div class="filter-chips">
          <%= link_to "Все #{content_tag(:span, @total_events_count)}".html_safe,
                      event_filter_path(@pet, nil),
                      class: event_filter_class(@selected_event_type, nil) %>

          <% @event_type_filters.each do |event_type, label| %>
            <%= link_to "#{label} #{content_tag(:span, @event_type_counts.fetch(event_type, 0))}".html_safe,
                        event_filter_path(@pet, event_type),
                        class: event_filter_class(@selected_event_type, event_type) %>
          <% end %>
        </div>
      </div>

      <div>
        <div class="filter-panel-title">Период</div>
        <div class="filter-chips">
          <% event_period_filters(@pet, @selected_period).each do |label, path, active| %>
            <%= link_to label, path, class: reminder_filter_class(active) %>
          <% end %>
        </div>
      </div>

      <div>
        <div class="filter-panel-title">Состояние</div>
        <div class="filter-chips">
          <% event_status_filters(@pet, @selected_status).each do |label, path, active| %>
            <%= link_to label, path, class: reminder_filter_class(active) %>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <% if @pet_events.any? %>
    <div class="journal-timeline enhanced">
      <% @pet_events.group_by { |event| event.event_date.beginning_of_month }.each do |month, events| %>
        <section class="journal-month">
          <div class="journal-month-heading">
            <h2 class="journal-month-title"><%= event_month_label(month) %></h2>
            <span><%= events.size %> <%= russian_plural(events.size, "запись", "записи", "записей") %></span>
          </div>

          <div class="journal-month-events">
            <% events.each do |event| %>
              <article class="journal-event enhanced <%= event_tone(event.event_type) %>">
                <div class="journal-event-date">
                  <span><%= event.event_date.day %></span>
                  <small><%= event.event_date.strftime("%m.%Y") %></small>
                </div>

                <div class="journal-event-body">
                  <div class="journal-event-topline">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                      <span class="event-badge"><%= event.event_type_label %></span>
                      <% if event_attachment_label(event).present? %>
                        <span class="attachment-pill"><%= event_attachment_label(event) %></span>
                      <% end %>
                      <% if event.next_action_at.present? %>
                        <span class="signal-pill">Следующее: <%= event.next_action_at.strftime("%d.%m %H:%M") %></span>
                      <% end %>
                    </div>
                  </div>

                  <h3 class="h5 mb-2">
                    <%= link_to event.title.presence || event.event_type_label,
                                pet_pet_event_path(@pet, event),
                                class: "text-dark text-decoration-none" %>
                  </h3>

                  <p class="text-muted mb-3"><%= event_structured_summary(event) %></p>

                  <% if event.structured? %>
                    <div class="event-structured-preview mb-3">
                      <% event.structured_rows.first(4).each do |label, value| %>
                        <span><%= label %>: <strong><%= value %></strong></span>
                      <% end %>
                    </div>
                  <% end %>

                  <div class="journal-event-actions">
                    <%= link_to "Открыть", pet_pet_event_path(@pet, event), class: "btn btn-outline-primary btn-sm" %>
                    <%= link_to "Редактировать", edit_pet_pet_event_path(@pet, event), class: "btn btn-outline-secondary btn-sm" %>
                    <% if event.next_action_at.present? %>
                      <%= link_to "Создать напоминание",
                                  new_pet_reminder_path(@pet, reminder: { title: "Повторить: #{event.title.presence || event.event_type_label}", remind_at: event.next_action_at }),
                                  class: "btn btn-outline-secondary btn-sm" %>
                    <% end %>
                  </div>
                </div>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% elsif @selected_event_type.present? || @selected_period.present? || @selected_status.present? || @query.present? %>
    <div class="empty-panel">
      <h2 class="h4 mb-2">По фильтрам ничего нет</h2>
      <p class="text-muted mb-3">Измените период, тип события или поисковый запрос. Можно сразу добавить новую запись с нужным типом.</p>
      <div class="d-flex flex-wrap gap-2">
        <%= link_to "Показать все", pet_pet_events_path(@pet), class: "btn btn-outline-secondary" %>
        <%= link_to "Добавить событие", new_pet_pet_event_path(@pet, type: @selected_event_type.presence), class: "btn btn-primary" %>
      </div>
    </div>
  <% else %>
    <div class="empty-panel">
      <h2 class="h4 mb-2">Журнал пока пуст</h2>
      <p class="text-muted mb-3">Добавьте первую запись: заметку, вес, прививку, обработку или визит к врачу.</p>
      <div class="d-flex flex-wrap gap-2">
        <% quick_event_actions(@pet).each do |label, path| %>
          <%= link_to label, path, class: label == "Заметка" ? "btn btn-primary" : "btn btn-outline-primary" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
