<% initial_wizard_step = @pet_event.errors.any? || @pet_event.persisted? ? 2 : 1 %>
<% cancel_path = @pet_event.persisted? ? pet_pet_event_path(@pet, @pet_event) : pet_pet_events_path(@pet) %>

<%= form_with model: [@pet, @pet_event],
              local: true,
              class: "pj-journal-form",
              data: { journal_wizard: true, initial_step: initial_wizard_step } do |f| %>
  <% if @pet_event.errors.any? %>
    <div class="pj-journal-form-errors" role="alert">
      <strong>Проверьте форму</strong>
      <span><%= @pet_event.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <div class="pj-journal-form-layout">
    <aside class="pj-journal-step-rail" aria-label="Этапы заполнения">
      <button type="button"
              class="pj-journal-step-rail__button <%= "active" if initial_wizard_step == 1 %>"
              data-journal-wizard-nav="1">
        <b>1</b><span>Тип события</span>
      </button>
      <button type="button"
              class="pj-journal-step-rail__button <%= "active" if initial_wizard_step == 2 %>"
              data-journal-wizard-nav="2">
        <b>2</b><span>Детали</span>
      </button>
      <button type="button"
              class="pj-journal-step-rail__button"
              data-journal-wizard-nav="3"
              disabled>
        <b>3</b><span>Дополнительно</span>
      </button>
    </aside>

    <div class="pj-journal-form-main">
      <section class="pj-journal-form-section pj-journal-form-section--types"
               data-journal-wizard-step="1"
               <%= "hidden" unless initial_wizard_step == 1 %>>
        <div class="pj-journal-form-heading">
          <h1><%= @pet_event.persisted? ? "Тип события" : "Выберите тип события" %></h1>
          <p>Запись попадёт в журнал <%= @pet.name %>. После выбора перейдём к данным события.</p>
        </div>

        <div class="pj-journal-type-grid">
          <% PetEvent::EVENT_TYPE_LABELS.each do |key, label| %>
            <label class="pj-journal-type-option <%= event_tone(key) %>">
              <%= f.radio_button :event_type, key, data: { event_type_radio: true, journal_wizard_type: true } %>
              <span class="pj-journal-type-option__icon"><%= journal_event_icon(key) %></span>
              <strong><%= label %></strong>
              <small><%= event_type_hint(key) %></small>
              <i>✓</i>
            </label>
          <% end %>
        </div>

        <p class="pj-journal-wizard-message" data-journal-wizard-message hidden>Выберите тип события, чтобы продолжить.</p>

        <div class="pj-journal-form-actions pj-journal-form-actions--wizard">
          <%= link_to "Отмена", cancel_path, class: "pj-journal-form-cancel" %>
          <button type="button" class="pj-journal-form-save" data-journal-wizard-next>Далее</button>
        </div>
      </section>

      <section class="pj-journal-form-section"
               data-journal-wizard-step="2"
               <%= "hidden" unless initial_wizard_step == 2 %>>
        <div class="pj-journal-form-heading">
          <h1><%= @pet_event.persisted? ? "Редактировать событие" : "Детали события" %></h1>
          <p>Укажите основные данные. Поля ниже меняются в зависимости от выбранного типа события.</p>
        </div>

        <div class="pj-journal-fields pj-journal-fields--base">
          <div class="pj-journal-field">
            <%= f.label :event_date, "Дата события" %>
            <%= f.date_field :event_date, required: true %>
          </div>
          <div class="pj-journal-field">
            <%= f.label :event_time, "Время" %>
            <%= f.time_field :event_time, step: 60 %>
          </div>
          <div class="pj-journal-field">
            <%= f.label :status, "Состояние" %>
            <%= f.select :status, PetEvent::STATUS_LABELS.map { |key, label| [label, key] } %>
          </div>
          <div class="pj-journal-field">
            <%= f.label :title, "Название" %>
            <%= f.text_field :title, placeholder: "Можно оставить пустым" %>
          </div>
        </div>

        <div class="pj-journal-dynamic-section" data-event-fields="weight">
          <div class="pj-journal-fields">
            <div class="pj-journal-field">
              <%= f.label :weight_value, "Вес" %>
              <div class="pj-journal-inline-control">
                <%= f.number_field :weight_value, step: 0.01, min: 0, placeholder: "0" %>
                <%= f.select :weight_unit, [["кг", "kg"], ["г", "g"]] %>
              </div>
              <small>Если единица — кг, текущий вес питомца тоже обновится.</small>
            </div>
          </div>
        </div>

        <div class="pj-journal-dynamic-section" data-event-fields="vaccination">
          <div class="pj-journal-fields pj-journal-fields--two">
            <div class="pj-journal-field"><%= f.label :vaccine_name, "Вакцина" %><%= f.text_field :vaccine_name, placeholder: "Например, Nobivac DHPPi" %></div>
            <div class="pj-journal-field"><%= f.label :vaccine_batch, "Номер партии" %><%= f.text_field :vaccine_batch, placeholder: "Серия / партия" %></div>
            <div class="pj-journal-field"><%= f.label :clinic_name, "Клиника" %><%= f.text_field :clinic_name, placeholder: "Название клиники" %></div>
            <div class="pj-journal-field"><%= f.label :veterinarian_name, "Ветеринар" %><%= f.text_field :veterinarian_name, placeholder: "Имя врача" %></div>
            <div class="pj-journal-field"><%= f.label :valid_until, "Действует до" %><%= f.date_field :valid_until %></div>
          </div>
        </div>

        <div class="pj-journal-dynamic-section" data-event-fields="treatment">
          <div class="pj-journal-fields pj-journal-fields--two">
            <div class="pj-journal-field"><%= f.label :medication_name, "Препарат" %><%= f.text_field :medication_name, placeholder: "Название лекарства" %></div>
            <div class="pj-journal-field"><%= f.label :dosage, "Дозировка" %><%= f.text_field :dosage, placeholder: "Например, 1 таблетка" %></div>
            <div class="pj-journal-field"><%= f.label :course_started_on, "Начало курса" %><%= f.date_field :course_started_on %></div>
            <div class="pj-journal-field"><%= f.label :course_ended_on, "Окончание курса" %><%= f.date_field :course_ended_on %></div>
            <div class="pj-journal-field pj-journal-field--wide"><%= f.label :next_action_at, "Следующее действие" %><%= f.datetime_local_field :next_action_at %></div>
          </div>
        </div>

        <div class="pj-journal-dynamic-section" data-event-fields="parasite_treatment">
          <div class="pj-journal-fields pj-journal-fields--two">
            <div class="pj-journal-field"><%= f.label :medication_name, "Средство" %><%= f.text_field :medication_name, placeholder: "Например, Бравекто" %></div>
            <div class="pj-journal-field"><%= f.label :dosage, "Дозировка / способ" %><%= f.text_field :dosage, placeholder: "Например, 1 таблетка" %></div>
            <div class="pj-journal-field"><%= f.label :course_started_on, "Дата обработки" %><%= f.date_field :course_started_on %></div>
            <div class="pj-journal-field"><%= f.label :next_action_at, "Следующая обработка" %><%= f.datetime_local_field :next_action_at %></div>
          </div>
        </div>

        <div class="pj-journal-dynamic-section" data-event-fields="visit">
          <div class="pj-journal-fields pj-journal-fields--two">
            <div class="pj-journal-field"><%= f.label :clinic_name, "Клиника" %><%= f.text_field :clinic_name, placeholder: "Название клиники" %></div>
            <div class="pj-journal-field"><%= f.label :veterinarian_name, "Ветеринар" %><%= f.text_field :veterinarian_name, placeholder: "Имя врача" %></div>
            <div class="pj-journal-field pj-journal-field--wide"><%= f.label :diagnosis, "Диагноз" %><%= f.text_field :diagnosis, placeholder: "Если поставлен" %></div>
            <div class="pj-journal-field pj-journal-field--wide"><%= f.label :recommendations, "Рекомендации" %><%= f.text_area :recommendations, rows: 3 %></div>
            <div class="pj-journal-field"><%= f.label :next_action_at, "Повторный приём / действие" %><%= f.datetime_local_field :next_action_at %></div>
          </div>
        </div>

        <div class="pj-journal-dynamic-section" data-event-fields="illness">
          <div class="pj-journal-fields pj-journal-fields--two">
            <div class="pj-journal-field pj-journal-field--wide"><%= f.label :symptoms, "Симптомы" %><%= f.text_area :symptoms, rows: 3, placeholder: "Что заметили" %></div>
            <div class="pj-journal-field"><%= f.label :severity, "Тяжесть" %><%= f.select :severity, event_severity_options, { include_blank: "Не указана" } %></div>
            <div class="pj-journal-field"><%= f.label :diagnosis, "Диагноз" %><%= f.text_field :diagnosis %></div>
            <div class="pj-journal-field"><%= f.label :symptom_started_on, "Начало симптомов" %><%= f.date_field :symptom_started_on %></div>
            <div class="pj-journal-field"><%= f.label :symptom_ended_on, "Окончание симптомов" %><%= f.date_field :symptom_ended_on %></div>
            <div class="pj-journal-field pj-journal-field--wide"><%= f.label :recommendations, "Рекомендации" %><%= f.text_area :recommendations, rows: 3 %></div>
          </div>
        </div>

        <div class="pj-journal-dynamic-section" data-event-fields="note">
          <p class="pj-journal-type-note">Для заметки достаточно даты, времени, состояния, названия и описания.</p>
        </div>

        <div class="pj-journal-dynamic-section" data-event-fields="document">
          <div class="pj-journal-type-note">
            В журнале сохранится запись о документе. Для отдельной карточки документа используйте
            <%= link_to "раздел «Документы»", pet_pet_documents_path(@pet) %>.
          </div>
        </div>

        <div class="pj-journal-form-actions pj-journal-form-actions--wizard">
          <button type="button" class="pj-journal-form-cancel" data-journal-wizard-back>Назад</button>
          <button type="button" class="pj-journal-form-save" data-journal-wizard-next>Далее</button>
        </div>
      </section>

      <section class="pj-journal-form-section"
               data-journal-wizard-step="3"
               hidden>
        <div class="pj-journal-form-heading">
          <h1>Дополнительно</h1>
          <p>Добавьте заметки, файлы или напоминание. Этот шаг можно пропустить и сразу сохранить событие.</p>
        </div>

        <div class="pj-journal-field">
          <%= f.label :description, "Заметки" %>
          <%= f.text_area :description, rows: 4, placeholder: "Что произошло, рекомендации, важные наблюдения..." %>
        </div>

        <section class="pj-document-form-card pj-document-upload-card pj-journal-upload-card" data-document-file-control>
          <div class="pj-document-form-card__heading">
            <h2>Файлы</h2>
            <p>Анализы, назначения, чеки или фотографии. Можно выбрать несколько.</p>
          </div>

          <% if @pet_event.persisted? && @pet_event.files.attached? %>
            <div class="pj-document-existing-files">
              <% @pet_event.files.each do |file| %>
                <%= link_to url_for(file), target: "_blank", rel: "noopener", class: "pj-document-existing-file" do %>
                  <span><%= pj_icon(:file) %></span>
                  <span><strong><%= file.filename.to_s %></strong><small><%= number_to_human_size(file.byte_size) %></small></span>
                <% end %>
              <% end %>
            </div>
          <% end %>

          <label class="pj-document-dropzone" data-document-file-dropzone>
            <span class="pj-document-dropzone__icon"><%= pj_icon(:file) %></span>
            <strong><%= @pet_event.files.attached? ? "Добавить ещё файлы" : "Перетащите файлы сюда" %></strong>
            <small>или выберите их с устройства</small>
            <span class="pj-document-dropzone__button">Выбрать файлы</span>
            <%= f.file_field :files, multiple: true, class: "pj-document-dropzone__input" %>
          </label>

          <div class="pj-document-selected-files" data-document-file-previews hidden aria-live="polite"></div>
        </section>

        <label class="pj-journal-follow-up-toggle" data-follow-up-section>
          <%= check_box_tag :create_follow_up_reminder, "1", false %>
          <span><strong>Создать напоминание по следующему действию</strong><small>Работает для событий, где указана дата следующего шага.</small></span>
        </label>

        <div class="pj-journal-form-actions pj-journal-form-actions--wizard">
          <button type="button" class="pj-journal-form-cancel" data-journal-wizard-back>Назад</button>
          <%= f.submit(@pet_event.persisted? ? "Сохранить изменения" : "Сохранить событие", class: "pj-journal-form-save") %>
        </div>
      </section>
    </div>
  </div>
<% end %>
