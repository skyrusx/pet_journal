<% content_for :title, "Редактировать #{journal_event_title(@pet_event)} — PetJournal" %>

<div class="pj-journal-page pj-journal-form-page">
  <header class="pj-workspace-topbar pj-journal-detail-topbar">
    <%= link_to pet_pet_events_path(@pet), class: "pj-workspace-back" do %>
      <%= pj_icon(:chevron) %><span>Назад к журналу</span>
    <% end %>

    <div class="pj-desktop-detail-actions" aria-label="Действия с событием">
      <%= button_to pet_pet_event_path(@pet, @pet_event),
                    method: :delete,
                    class: "pj-desktop-detail-action pj-desktop-detail-action--danger",
                    form_class: "pj-desktop-detail-action-form",
                    form: { onsubmit: "return confirm('Удалить событие?')" },
                    aria: { label: "Удалить событие" },
                    title: "Удалить" do %>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/>
        </svg>
      <% end %>
    </div>
  </header>

  <div class="pj-journal-form-content">
    <div class="pj-mobile-detail-nav pj-mobile-form-nav">
      <%= link_to pet_pet_event_path(@pet, @pet_event), class: "pj-mobile-context-back" do %>
        <%= pj_icon(:chevron) %><span>К событию</span>
      <% end %>
    </div>

    <div class="pj-mobile-form-heading">
      <h1>Редактировать событие</h1>
      <p>Обновите данные записи для <%= @pet.name %>.</p>
    </div>

    <%= render "form" %>
  </div>
</div>
