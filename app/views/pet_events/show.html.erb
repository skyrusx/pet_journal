<% content_for :title, "#{journal_event_title(@pet_event)} — #{@pet.name} — PetJournal" %>
<% state_label, state_tone = journal_event_state(@pet_event) %>

<div class="pj-journal-page pj-journal-show">
  <header class="pj-workspace-topbar pj-journal-detail-topbar">
    <%= link_to pet_pet_events_path(@pet), class: "pj-workspace-back" do %>
      <%= pj_icon(:chevron) %><span>Назад к журналу</span>
    <% end %>

    <div class="pj-journal-detail-actions">
      <details class="pj-journal-more">
        <summary aria-label="Другие действия"><%= pj_icon(:more) %></summary>
        <div>
          <%= link_to edit_pet_pet_event_path(@pet, @pet_event), class: "pj-journal-more__item" do %>
            <span>Редактировать</span>
          <% end %>
          <%= button_to "Удалить запись",
                        pet_pet_event_path(@pet, @pet_event),
                        method: :delete,
                        class: "pj-journal-more__item pj-journal-more__item--danger",
                        form_class: "pj-journal-more__form",
                        form: { onsubmit: "return confirm('Удалить событие?')" } %>
        </div>
      </details>
    </div>
  </header>

  <div class="pj-journal-content pj-journal-detail-content">
    <%= link_to pet_pet_events_path(@pet), class: "pj-journal-mobile-back" do %>
      <%= pj_icon(:chevron) %><span><%= @pet_event.event_type_label %></span>
    <% end %>

    <div class="pj-journal-detail-grid">
      <article class="pj-journal-event-sheet">
        <div class="pj-journal-event-heading">
          <span class="pj-journal-event-heading__icon"><%= journal_event_icon(@pet_event.event_type) %></span>
          <div>
            <h1><%= journal_event_title(@pet_event) %></h1>
            <p><%= event_date_time_label(@pet_event) %></p>
          </div>
          <span class="pj-journal-state <%= state_tone %>"><%= state_label %></span>
        </div>

        <dl class="pj-journal-detail-list">
          <div><dt>Питомец</dt><dd><%= @pet.name %></dd></div>
          <div><dt>Тип события</dt><dd><%= @pet_event.event_type_label %></dd></div>
          <div><dt>Состояние</dt><dd><%= @pet_event.status_label %></dd></div>
          <div><dt>Дата и время</dt><dd><%= event_date_time_label(@pet_event) %></dd></div>
          <% @pet_event.structured_rows.each do |label, value| %>
            <div><dt><%= label %></dt><dd><%= simple_format(value.to_s) %></dd></div>
          <% end %>
          <% if @pet_event.next_action_at.present? %>
            <div><dt>Следующее действие</dt><dd><%= l(@pet_event.next_action_at, format: :default) %></dd></div>
          <% end %>
        </dl>

        <section class="pj-journal-note-block">
          <h2>Заметки</h2>
          <%= simple_format(@pet_event.description.presence || "Заметки не добавлены.") %>
        </section>

        <% if @pet_event.files.attached? %>
          <section class="pj-journal-files">
            <h2>Файлы</h2>
            <% @pet_event.files.each do |file| %>
              <div class="pj-journal-file-row">
                <span class="pj-journal-file-row__icon"><%= pj_icon(:file) %></span>
                <span><strong><%= file.filename %></strong><small><%= number_to_human_size(file.byte_size) %></small></span>
                <%= link_to url_for(file), target: "_blank", rel: "noopener", aria: { label: "Открыть #{file.filename}" } do %>
                  <%= pj_icon(:chevron) %>
                <% end %>
              </div>
            <% end %>
          </section>
        <% end %>

        <% if @pet_event.next_action_at.present? %>
          <section class="pj-journal-follow-up">
            <div><strong>Не забыть следующий шаг</strong><small><%= l(@pet_event.next_action_at, format: :default) %></small></div>
            <%= link_to "Создать напоминание",
                        new_pet_reminder_path(
                          @pet,
                          reminder: {
                            title: journal_event_title(@pet_event),
                            remind_at: @pet_event.next_action_at,
                            note: "Создано из записи журнала от #{event_date_label(@pet_event.event_date)}."
                          }
                        ),
                        class: "pj-journal-secondary-action" %>
          </section>
        <% end %>
      </article>

      <aside class="pj-journal-event-aside">
        <%= link_to pet_path(@pet), class: "pj-journal-pet-card" do %>
          <span class="pj-journal-pet-card__photo">
            <% if @pet.photo.attached? %>
              <%= image_tag @pet.photo, alt: @pet.name %>
            <% else %>
              <%= @pet.name.to_s.first.to_s.upcase.presence || "P" %>
            <% end %>
          </span>
          <span><strong><%= @pet.name %></strong><small><%= @pet.breed.presence || @pet.species.presence || "Питомец" %></small><small><%= pet_age(@pet) %></small></span>
        <% end %>

        <section class="pj-journal-history-card">
          <h2>История события</h2>
          <div><span></span><p><strong>Создано</strong><small><%= l(@pet_event.created_at, format: :default) %></small></p></div>
          <% if @pet_event.updated_at > @pet_event.created_at + 1.second %>
            <div><span></span><p><strong>Обновлено</strong><small><%= l(@pet_event.updated_at, format: :default) %></small></p></div>
          <% end %>
        </section>
      </aside>
    </div>
  </div>
</div>
