<div class="event-show py-4">
  <section class="event-detail-hero <%= event_tone(@pet_event.event_type) %> mb-4">
    <div>
      <div class="text-muted small mb-1"><%= @pet.name %> · <%= event_date_label(@pet_event.event_date) %></div>
      <span class="event-badge mb-3"><%= @pet_event.event_type_label %></span>
      <h1 class="h3 mb-2"><%= @pet_event.title.presence || @pet_event.event_type_label %></h1>
      <p class="text-muted mb-0"><%= event_type_hint(@pet_event.event_type) %></p>
    </div>

    <div class="event-detail-actions">
      <%= link_to "К журналу", pet_pet_events_path(@pet), class: "btn btn-outline-secondary" %>
      <%= link_to "К обзору", pet_path(@pet), class: "btn btn-outline-secondary" %>
      <%= link_to "Редактировать", edit_pet_pet_event_path(@pet, @pet_event), class: "btn btn-primary" %>
    </div>
  </section>

  <div class="row g-4">
    <section class="col-lg-7">
      <% if @pet_event.structured? %>
        <div class="workspace-section mb-4">
          <div class="section-heading compact">
            <div>
              <div class="text-muted small mb-1">Структура</div>
              <h2 class="h4 mb-0">Данные события</h2>
            </div>
          </div>

          <dl class="details-list">
            <% @pet_event.structured_rows.each do |label, value| %>
              <div><dt><%= label %></dt><dd><%= simple_format(value.to_s) %></dd></div>
            <% end %>
          </dl>
        </div>
      <% end %>

      <div class="workspace-section mb-4">
        <div class="section-heading compact">
          <div>
            <div class="text-muted small mb-1">Запись</div>
            <h2 class="h4 mb-0">Описание</h2>
          </div>
        </div>

        <div class="event-description">
          <%= simple_format(@pet_event.description.presence || "Описание не заполнено.") %>
        </div>
      </div>

      <% if @pet_event.files.attached? %>
        <section class="workspace-section">
          <div class="section-heading compact">
            <div>
              <div class="text-muted small mb-1">Документы</div>
              <h2 class="h4 mb-0"><%= @pet_event.files.count %> <%= russian_plural(@pet_event.files.count, "файл", "файла", "файлов") %></h2>
            </div>
          </div>

          <div class="document-list">
            <% @pet_event.files.each do |file| %>
              <div class="document-row">
                <div>
                  <div class="fw-semibold"><%= file.filename %></div>
                  <div class="text-muted small"><%= event_file_label(file) %></div>
                </div>
                <%= link_to "Открыть", url_for(file), class: "btn btn-outline-primary btn-sm", target: "_blank", rel: "noopener" %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>
    </section>

    <aside class="col-lg-5">
      <section class="details-panel mb-4">
        <div class="section-heading compact">
          <h2 class="h4 mb-0">Детали</h2>
        </div>

        <dl class="details-list">
          <div><dt>Питомец</dt><dd><%= @pet.name %></dd></div>
          <div><dt>Тип</dt><dd><%= @pet_event.event_type_label %></dd></div>
          <div><dt>Дата</dt><dd><%= event_date_label(@pet_event.event_date) %></dd></div>
          <div><dt>Файлы</dt><dd><%= @pet_event.files.count %> <%= russian_plural(@pet_event.files.count, "файл", "файла", "файлов") %></dd></div>
          <% if @pet_event.next_action_at.present? %>
            <div><dt>Следующее действие</dt><dd><%= l(@pet_event.next_action_at) %></dd></div>
          <% end %>
          <% if @pet_event.pet_documents.any? %>
            <div>
              <dt>Документы</dt>
              <dd><%= @pet_event.pet_documents.map { |document| link_to(document.title, pet_pet_document_path(@pet, document)) }.to_sentence.html_safe %></dd>
            </div>
          <% end %>
        </dl>
      </section>

      <% if @pet_event.next_action_at.present? %>
        <section class="action-panel mb-4">
          <div class="text-muted small mb-1">Следующий шаг</div>
          <h2 class="h5 mb-2">Закрепить в напоминаниях</h2>
          <p class="text-muted mb-3">Событие содержит дату следующего действия. Создайте напоминание, чтобы оно попало в общий план ухода.</p>
          <%= link_to "Создать напоминание",
                      new_pet_reminder_path(
                        @pet,
                        reminder: {
                          title: @pet_event.title.presence || @pet_event.event_type_label,
                          reminder_type: @pet_event.event_type.in?(Reminder.reminder_types.keys) ? @pet_event.event_type : "other",
                          remind_at: @pet_event.next_action_at,
                          note: "Создано из записи журнала от #{event_date_label(@pet_event.event_date)}."
                        }
                      ),
                      class: "btn btn-primary btn-sm w-100" %>
        </section>
      <% end %>

      <section class="action-panel danger-zone">
        <div class="text-muted small mb-1">Опасное действие</div>
        <h2 class="h5 mb-2">Удалить запись</h2>
        <p class="text-muted mb-3">Запись исчезнет из журнала питомца вместе с привязанными файлами.</p>
        <%= button_to "Удалить событие",
                      pet_pet_event_path(@pet, @pet_event),
                      method: :delete,
                      class: "btn btn-outline-danger btn-sm",
                      form: { onsubmit: "return confirm('Удалить событие?')" } %>
      </section>
    </aside>
  </div>
</div>
