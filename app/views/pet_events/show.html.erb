<div class="py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <div class="text-muted small mb-1">
        <%= @pet_event.event_date %> · <%= @pet_event.event_type_label %>
      </div>
      <h1 class="h3 mb-0"><%= @pet_event.title.presence || @pet_event.event_type_label %></h1>
    </div>

    <div class="d-flex gap-2">
      <%= link_to "К журналу", pet_pet_events_path(@pet), class: "btn btn-outline-secondary" %>
      <%= link_to "Редактировать", edit_pet_pet_event_path(@pet, @pet_event), class: "btn btn-primary" %>
      <%= button_to "Удалить",
                    pet_pet_event_path(@pet, @pet_event),
                    method: :delete,
                    class: "btn btn-outline-danger",
                    form: { onsubmit: "return confirm('Удалить событие?')" } %>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <p class="mb-3">
        <strong>Питомец:</strong> <%= @pet.name %>
      </p>

      <p class="mb-3">
        <strong>Тип события:</strong> <%= @pet_event.event_type_label %>
      </p>

      <p class="mb-3">
        <strong>Дата события:</strong> <%= @pet_event.event_date %>
      </p>

      <div class="mb-3">
        <strong>Описание:</strong>
        <div class="mt-2 text-muted">
          <%= @pet_event.description.presence || "—" %>
        </div>
      </div>

      <% if @pet_event.files.attached? %>
        <div class="mt-4">
          <strong>Файлы:</strong>
          <div class="mt-2 d-flex flex-column gap-2">
            <% @pet_event.files.each do |file| %>
              <%= link_to file.filename.to_s, url_for(file), target: "_blank", rel: "noopener" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
