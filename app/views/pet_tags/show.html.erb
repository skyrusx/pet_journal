<div class="pet-tag-page py-4">
  <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
    <div>
      <div class="text-muted small mb-1"><%= @pet.name %></div>
      <h1 class="h3 mb-1">Жетон</h1>
      <p class="text-muted mb-0">Публичный QR-профиль для связи, если питомец потеряется.</p>
    </div>

    <div class="d-flex flex-wrap align-items-start gap-2">
      <%= link_to "Обзор питомца", pet_path(@pet), class: "btn btn-outline-secondary" %>
      <% if @pet_tag.persisted? %>
        <%= link_to "Редактировать", edit_pet_pet_tag_path(@pet), class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <nav class="pet-tabs mb-4" aria-label="Навигация питомца">
    <%= link_to "Обзор", pet_path(@pet), class: "pet-tab" %>
    <%= link_to "Журнал", pet_pet_events_path(@pet), class: "pet-tab" %>
    <%= link_to "Напоминания", pet_reminders_path(@pet), class: "pet-tab" %>
    <%= link_to "Документы", pet_pet_documents_path(@pet), class: "pet-tab" %>
    <%= link_to "Жетон", pet_pet_tag_path(@pet), class: "pet-tab active" %>
    <%= link_to "Данные", edit_pet_path(@pet), class: "pet-tab" %>
  </nav>

  <% if @pet_tag.persisted? %>
    <section class="pet-tag-hero mb-4">
      <div class="pet-tag-hero-main">
        <div>
          <span class="<%= pet_tag_status_class(@pet_tag) %>"><%= pet_tag_status_label(@pet_tag) %></span>
          <h2 class="h3 mt-3 mb-2"><%= pet_tag_primary_signal(@pet_tag, @recent_scans.first) %></h2>
          <p class="text-muted mb-0">
            QR-профиль показывает только выбранные данные и помогает быстро связаться с владельцем.
          </p>
        </div>

        <div class="pet-tag-stats">
          <div>
            <span><%= @scan_count %></span>
            <small><%= russian_plural(@scan_count, "сканирование", "сканирования", "сканирований") %></small>
          </div>
          <div>
            <span><%= @pet_tag.show_phone? && @pet_tag.contact_phone.present? ? "Да" : "Нет" %></span>
            <small>телефон виден</small>
          </div>
          <div>
            <span><%= notification_label(@pet_tag.notification_preference) %></span>
            <small>уведомления</small>
          </div>
        </div>
      </div>

      <div class="pet-tag-hero-actions">
        <%= link_to "Открыть public page",
                    public_pet_tag_path(@pet_tag.public_token),
                    class: "btn btn-primary",
                    target: "_blank",
                    rel: "noopener" %>
        <%= link_to "Редактировать", edit_pet_pet_tag_path(@pet), class: "btn btn-outline-secondary" %>
      </div>
    </section>

    <div class="row g-4">
      <section class="col-lg-7">
        <div class="tag-section-grid mb-4">
          <div class="action-panel">
            <div class="section-heading compact">
              <div>
                <div class="text-muted small mb-1">Публичная ссылка</div>
                <h2 class="h5 mb-0">Адрес QR-профиля</h2>
              </div>
            </div>

            <div class="public-url-box mb-3">
              <%= public_pet_tag_url(@pet_tag.public_token) %>
            </div>

            <div class="d-flex flex-wrap gap-2">
              <%= button_to "Обновить ссылку",
                            rotate_token_pet_pet_tag_path(@pet),
                            method: :patch,
                            class: "btn btn-outline-danger btn-sm",
                            form: { onsubmit: "return confirm('Обновить публичную ссылку? Старый QR-код перестанет работать.')" } %>
              <% if @pet_tag.token_rotated_at.present? %>
                <span class="text-muted small align-self-center">Обновлена <%= @pet_tag.token_rotated_at.strftime("%d.%m.%Y %H:%M") %></span>
              <% end %>
            </div>
          </div>

          <div class="action-panel qr-panel">
            <div class="section-heading compact">
              <div>
                <div class="text-muted small mb-1">QR-код</div>
                <h2 class="h5 mb-0">Для печати</h2>
              </div>
            </div>

            <div class="qr-preview">
              <%= image_tag qr_pet_pet_tag_path(@pet, format: :svg), alt: "QR-код PetTag для #{@pet.name}" %>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-3">
              <%= link_to "SVG", qr_pet_pet_tag_path(@pet, format: :svg), class: "btn btn-outline-primary btn-sm" %>
              <%= link_to "PNG", qr_pet_pet_tag_path(@pet, format: :png), class: "btn btn-outline-primary btn-sm" %>
            </div>
          </div>
        </div>

        <div class="action-panel mb-4">
          <div class="section-heading compact">
            <div>
              <div class="text-muted small mb-1">Режим потери</div>
              <h2 class="h5 mb-0"><%= @pet_tag.lost_mode_enabled? ? "Питомец отмечен как потерявшийся" : "Режим потери выключен" %></h2>
            </div>
            <span class="<%= @pet_tag.lost_mode_enabled? ? "lost-pill" : "status-pill muted" %>">
              <%= @pet_tag.lost_mode_enabled? ? "Включен" : "Выключен" %>
            </span>
          </div>

          <% if @pet_tag.lost_mode_enabled? %>
            <div class="lost-mode-summary">
              <p><%= @pet_tag.lost_message.presence || "Сообщение при потере не заполнено." %></p>
              <div class="text-muted small">Последнее место: <%= @pet_tag.last_seen_location.presence || "не указано" %></div>
            </div>
          <% else %>
            <p class="text-muted mb-3">Включайте режим потери только когда питомец действительно потерялся. Публичная страница станет заметнее, а уведомления можно получать при каждом открытии.</p>
          <% end %>

          <div class="d-flex flex-wrap gap-2">
            <%= link_to @pet_tag.lost_mode_enabled? ? "Изменить сообщение" : "Настроить режим потери",
                        edit_pet_pet_tag_path(@pet),
                        class: @pet_tag.lost_mode_enabled? ? "btn btn-outline-danger btn-sm" : "btn btn-outline-secondary btn-sm" %>
          </div>
        </div>

        <div class="action-panel mb-4">
          <div class="section-heading compact">
            <div>
              <div class="text-muted small mb-1">Сканирования</div>
              <h2 class="h5 mb-0">Последняя активность</h2>
            </div>
          </div>

          <% if @recent_scans.any? %>
            <div class="scan-list">
              <% @recent_scans.each do |scan| %>
                <div class="scan-item">
                  <div>
                    <div class="fw-semibold"><%= scan_time_label(scan) %></div>
                    <div class="text-muted small"><%= scan.user_agent.presence || "Браузер не определен" %></div>
                  </div>

                  <% if scan.location_shared? %>
                    <span class="location-pill">Геолокация</span>
                  <% end %>
                </div>

                <% if scan.location_shared? %>
                  <div class="scan-location">
                    <%= scan.location_label %>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="empty-state-inline">
              <div class="fw-semibold mb-1">Сканов пока нет</div>
              <div class="text-muted">После открытия QR-профиля здесь появятся дата, браузер и добровольно переданная геолокация.</div>
            </div>
          <% end %>
        </div>
      </section>

      <aside class="col-lg-5">
        <div class="action-panel mb-4">
          <div class="text-muted small mb-1">Публичный предпросмотр</div>
          <h2 class="h4 mb-3">Что увидит человек с QR</h2>

          <div class="preview-stack">
            <div>
              <div class="fw-semibold">Сообщение</div>
              <p class="text-muted mb-0"><%= @pet_tag.public_message.presence || "Сообщение не заполнено" %></p>
            </div>

            <% if @pet_tag.lost_mode_enabled? %>
              <div>
                <div class="fw-semibold">Режим потери</div>
                <p class="text-muted mb-0"><%= @pet_tag.lost_message.presence || "Питомец потерялся. Сообщение не заполнено." %></p>
              </div>

              <div>
                <div class="fw-semibold">Последнее место</div>
                <p class="text-muted mb-0"><%= @pet_tag.last_seen_location.presence || "Не указано" %></p>
              </div>
            <% end %>

            <div>
              <div class="fw-semibold">Поведение</div>
              <p class="text-muted mb-0"><%= @pet_tag.behavior_notes.presence || "Особенности не указаны" %></p>
            </div>

            <div>
              <div class="fw-semibold">Медицинское</div>
              <p class="text-muted mb-0"><%= @pet_tag.medical_notes.presence || "Медицинские заметки не указаны" %></p>
            </div>

            <div>
              <div class="fw-semibold">Телефон</div>
              <p class="text-muted mb-0">
                <% if @pet_tag.show_phone? && @pet_tag.contact_phone.present? %>
                  Показывается на публичной странице
                <% else %>
                  Скрыт
                <% end %>
              </p>
            </div>

            <div>
              <div class="fw-semibold">Уведомления</div>
              <p class="text-muted mb-0"><%= notification_label(@pet_tag.notification_preference) %></p>
            </div>
          </div>
        </div>

        <div class="action-panel">
          <div class="text-muted small mb-1">Приватность</div>
          <h2 class="h4 mb-3">Публичные данные</h2>

          <div class="privacy-list">
            <% pet_tag_visibility_rows(@pet_tag).each do |label, value| %>
              <div>
                <span><%= label %></span>
                <strong><%= value %></strong>
              </div>
            <% end %>
          </div>
        </div>
      </aside>
    </div>
  <% else %>
    <div class="empty-panel mb-4">
      <h2 class="h4 mb-2">QR-профиль еще не создан</h2>
      <p class="text-muted mb-0">
        Создайте публичную страницу с безопасным минимумом данных: фото и имя питомца, особенности поведения,
        медицинские заметки и контакт для связи.
      </p>
    </div>

    <%= render "form" %>
  <% end %>
</div>
