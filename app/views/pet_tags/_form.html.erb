<%= form_with model: @pet_tag,
              url: pet_pet_tag_path(@pet),
              method: @pet_tag.persisted? ? :patch : :post,
              local: true,
              class: "pj-pettag-form" do |f| %>
  <% if @pet_tag.errors.any? %>
    <div class="pj-pettag-form-errors" role="alert">
      <strong>Проверьте форму</strong>
      <span><%= @pet_tag.errors.full_messages.join(". ") %></span>
    </div>
  <% end %>

  <div class="pj-pettag-form-grid">
    <section class="pj-pettag-form-card">
      <div class="pj-pettag-form-card__heading"><h2>Публичный профиль</h2><p>Что увидит человек после сканирования QR-кода.</p></div>

      <label class="pj-pettag-toggle">
        <%= f.check_box :enabled %>
        <span><strong>Публичная страница включена</strong><small>Отключите, чтобы ссылка PetTag временно не открывалась</small></span>
      </label>

      <div class="pj-pettag-field">
        <%= f.label :public_message, "Сообщение владельца" %>
        <%= f.text_area :public_message, rows: 3, placeholder: "Если вы нашли питомца, пожалуйста, свяжитесь со мной" %>
      </div>
      <div class="pj-pettag-field">
        <%= f.label :behavior_notes, "Особенности поведения" %>
        <%= f.text_area :behavior_notes, rows: 3, placeholder: "Пугливый, откликается на имя, не любит руки…" %>
      </div>
      <div class="pj-pettag-field">
        <%= f.label :medical_notes, "Важные медицинские заметки" %>
        <%= f.text_area :medical_notes, rows: 3, placeholder: "Аллергии, лекарства, хронические состояния" %>
      </div>

      <label class="pj-pettag-toggle">
        <%= f.check_box :show_medical_notes %>
        <span><strong>Показывать медицинские заметки</strong><small>Только если эту информацию безопасно сделать публичной</small></span>
      </label>
    </section>

    <section class="pj-pettag-form-card">
      <div class="pj-pettag-form-card__heading"><h2>Режим потери</h2><p>Информация, которая станет заметнее, если питомец потеряется.</p></div>

      <div class="pj-pettag-field">
        <span class="pj-pettag-field-label">Статус безопасности</span>
        <div class="pj-pettag-status-readonly">
          <strong><%= @pet_tag.persisted? ? pet_tag_status_label(@pet_tag) : "В безопасности" %></strong>
          <small>Статус меняется только через действия PetTag: «Потерялся» → «Найден» → «Дома» → завершение инцидента.</small>
        </div>
      </div>
      <div class="pj-pettag-field">
        <%= f.label :lost_message, "Сообщение при потере" %>
        <%= f.text_area :lost_message, rows: 3, placeholder: "Пожалуйста, отправьте сообщение — питомец может испугаться" %>
      </div>
      <div class="pj-pettag-field">
        <%= f.label :last_seen_location, "Где видели в последний раз" %>
        <%= f.text_field :last_seen_location, placeholder: "Район, улица или ориентир" %>
      </div>
      <div class="pj-pettag-field">
        <%= f.label :found_message, "Сообщение после находки" %>
        <%= f.text_area :found_message, rows: 3, placeholder: "Спасибо! Я уже связываюсь с человеком, который нашёл питомца" %>
      </div>
    </section>

    <section class="pj-pettag-form-card">
      <div class="pj-pettag-form-card__heading"><h2>Контакты и уведомления</h2><p>Как PetJournal доставит владельцу сообщение о сканировании или находке.</p></div>

      <div class="pj-pettag-field">
        <%= f.label :contact_phone, "Телефон владельца" %>
        <%= f.telephone_field :contact_phone,
                              placeholder: "+7 (999) 123-45-67",
                              autocomplete: "tel",
                              inputmode: "tel",
                              data: { account_phone_input: true } %>
        <small>Телефон сохраняется в настройках PetTag, но сейчас не публикуется на QR-странице.</small>
      </div>

      <%= f.hidden_field :show_phone, value: "0" %>
      <div class="pj-pettag-toggle" aria-disabled="true">
        <input type="checkbox" disabled>
        <span><strong>Публичный телефон отключён</strong><small>Для публикации персонального контакта нужен отдельный юридический сценарий согласия. Связь с владельцем работает через защищённую форму PetTag.</small></span>
      </div>

      <div class="pj-pettag-field">
        <%= f.label :notification_preference, "Уведомления о сканах" %>
        <%= f.select :notification_preference, notification_options %>
      </div>

      <% if @notification_channels&.any? %>
        <div class="pj-pettag-channel-list">
          <span class="pj-pettag-field-label">Каналы PetTag</span>
          <%= hidden_field_tag "pet_tag[notification_channel_ids][]", "" %>
          <% @notification_channels.each do |channel| %>
            <label class="pj-pettag-channel">
              <%= check_box_tag "pet_tag[notification_channel_ids][]", channel.id, @pet_tag.notification_channel_ids.include?(channel.id) %>
              <span><strong><%= channel.name %></strong><small><%= channel.channel_type_label %></small></span>
            </label>
          <% end %>
        </div>
      <% else %>
        <p class="pj-pettag-form-hint">Каналы уведомлений пока не настроены. Для PetTag будет использован email аккаунта.</p>
      <% end %>

      <% if @pet_tag.persisted? %>
        <div class="pj-pettag-token-management">
          <div>
            <strong>Публичный токен</strong>
            <small>Если QR попал не туда, можно выпустить новую ссылку. Старый QR перестанет работать.</small>
            <% if @pet_tag.token_rotated_at.present? %>
              <small>Последняя замена: <%= @pet_tag.token_rotated_at.strftime("%d.%m.%Y %H:%M") %></small>
            <% end %>
          </div>
          <%= link_to "Обновить",
                      rotate_token_pet_pet_tag_path(@pet),
                      class: "pj-pettag-token-rotate",
                      data: { turbo_method: :patch, turbo_confirm: "Обновить публичную ссылку? Старый QR-код перестанет работать." } %>
        </div>
      <% end %>
    </section>
  </div>

  <div class="pj-pettag-form-actions">
    <%= link_to "Отмена", @pet_tag.persisted? ? pet_pet_tag_path(@pet) : pet_path(@pet), class: "pj-pettag-secondary-button" %>
    <%= f.submit @pet_tag.persisted? ? "Сохранить" : "Создать", class: "pj-pettag-primary-button" %>
  </div>
<% end %>
