<%= form_with model: @pet_tag,
              url: pet_pet_tag_path(@pet),
              method: @pet_tag.persisted? ? :patch : :post,
              local: true,
              class: "structured-form" do |f| %>
  <% if @pet_tag.errors.any? %>
    <div class="flash-stack" aria-live="polite" aria-atomic="true">
      <div class="flash-toast alert" role="alert" data-flash-toast>
        <div>
          <strong>Проверьте форму</strong>
          <p><%= @pet_tag.errors.full_messages.join(". ") %></p>
        </div>
        <button type="button" aria-label="Закрыть уведомление" data-flash-close></button>
      </div>
    </div>
  <% end %>

  <section class="form-section">
    <div class="form-section-heading">
      <div>
        <h2 class="h5 mb-1">Публичный профиль</h2>
        <p class="text-muted mb-0">Эта информация будет доступна по ссылке на жетоне.</p>
      </div>
      <% if @pet_tag.persisted? %>
        <span class="status-pill"><%= @pet_tag.enabled? ? "Активен" : "Отключен" %></span>
      <% end %>
    </div>

    <div class="form-check form-switch mb-3">
      <%= f.check_box :enabled, class: "form-check-input", role: "switch" %>
      <%= f.label :enabled, "Публичная страница включена", class: "form-check-label" %>
    </div>

    <div class="form-hint mb-3">
      На публичной странице не показывается эл. почта владельца. Телефон и медицинские заметки появятся только если вы включите их ниже.
    </div>

    <div class="mb-3">
      <%= f.label :public_message, "Сообщение", class: "form-label" %>
      <%= f.text_area :public_message,
                      rows: 3,
                      class: "form-control",
                      placeholder: "Например: если вы нашли меня, пожалуйста, свяжитесь с владельцем" %>
    </div>

    <div class="mb-3">
      <%= f.label :behavior_notes, "Особенности поведения", class: "form-label" %>
      <%= f.text_area :behavior_notes,
                      rows: 3,
                      class: "form-control",
                      placeholder: "Пугливый, не любит руки, откликается на имя" %>
    </div>

    <div>
      <%= f.label :medical_notes, "Важные медицинские заметки", class: "form-label" %>
      <%= f.text_area :medical_notes,
                      rows: 3,
                      class: "form-control",
                      placeholder: "Аллергии, лекарства, хронические состояния" %>
    </div>

    <div class="form-check form-switch mt-3">
      <%= f.check_box :show_medical_notes, class: "form-check-input", role: "switch" %>
      <%= f.label :show_medical_notes, "Показывать медицинские заметки на публичной странице", class: "form-check-label" %>
    </div>
  </section>

  <section class="form-section lost-mode-section">
    <div class="form-section-heading">
      <div>
        <h2 class="h5 mb-1">Режим потери</h2>
        <p class="text-muted mb-0">Включайте только если питомец потерялся. Публичная страница станет более заметной.</p>
      </div>
      <span class="lost-pill">Режим потери</span>
    </div>

    <div class="mb-3">
      <%= f.label :safety_status, "Статус безопасности", class: "form-label" %>
      <%= f.select :safety_status, pet_tag_status_options, {}, class: "form-select" %>
    </div>

    <div class="mb-3">
      <%= f.label :lost_message, "Сообщение при потере", class: "form-label" %>
      <%= f.text_area :lost_message,
                      rows: 3,
                      class: "form-control",
                      placeholder: "Например: пожалуйста, позвоните сразу, питомец может испугаться" %>
    </div>

    <div>
      <%= f.label :last_seen_location, "Где видели в последний раз", class: "form-label" %>
      <%= f.text_field :last_seen_location,
                       class: "form-control",
                       placeholder: "Район, улица или ориентир" %>
    </div>

    <div class="mt-3">
      <%= f.label :found_message, "Сообщение когда питомца нашли", class: "form-label" %>
      <%= f.text_area :found_message,
                      rows: 3,
                      class: "form-control",
                      placeholder: "Например: спасибо, я уже связываюсь с человеком, который нашел питомца" %>
    </div>
  </section>

  <section class="form-section">
    <div class="form-section-heading">
      <div>
        <h2 class="h5 mb-1">Связь</h2>
        <p class="text-muted mb-0">Показывайте только тот контакт, который готовы сделать публичным.</p>
      </div>
    </div>

    <div class="row g-3">
      <div class="col-md-7">
        <%= f.label :contact_phone, "Телефон", class: "form-label" %>
        <%= f.telephone_field :contact_phone, class: "form-control", placeholder: "+7..." %>
      </div>

      <div class="col-md-5 d-flex align-items-end">
        <div class="form-check form-switch mb-2">
          <%= f.check_box :show_phone, class: "form-check-input", role: "switch" %>
          <%= f.label :show_phone, "Показывать телефон", class: "form-check-label" %>
        </div>
      </div>

      <div class="col-md-7">
        <%= f.label :notification_preference, "Уведомления о сканах", class: "form-label" %>
        <%= f.select :notification_preference, notification_options, {}, class: "form-select" %>
      </div>
    </div>

    <div class="form-hint mt-3">
      Уведомления о геолокации отправляются всегда, когда человек добровольно передает место через публичную страницу. Повторная отправка по той же форме блокируется.
    </div>

    <% if @notification_channels&.any? %>
      <div class="mt-3">
        <div class="form-label">Каналы для PetTag</div>
        <div class="channel-choice-grid">
          <% @notification_channels.each do |channel| %>
            <label class="channel-choice">
              <%= check_box_tag "pet_tag[notification_channel_ids][]",
                                channel.id,
                                @pet_tag.notification_channel_ids.include?(channel.id),
                                class: "form-check-input" %>
              <span>
                <strong><%= channel.name %></strong>
                <small><%= channel.channel_type_label %> · <%= channel.channel_web_push? ? "Браузерная подписка" : channel.address %></small>
              </span>
            </label>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="form-hint mt-3">
        Каналы уведомлений не настроены. PetTag будет использовать эл. почту аккаунта.
      </div>
    <% end %>
  </section>

  <div class="form-actions">
    <%= f.submit @pet_tag.persisted? ? "Сохранить настройки" : "Создать QR-профиль", class: "btn btn-primary" %>
    <%= link_to "К обзору", pet_path(@pet), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
