<% content_for :title, "Настройки PetTag — #{@pet.name} — PetJournal" %>

<div class="pj-pettag-page pj-pettag-form-page">
  <header class="pj-workspace-topbar pj-workspace-topbar--form">
    <%= link_to pet_pet_tag_path(@pet), class: "pj-workspace-back" do %>
      <%= pj_icon(:chevron) %><span>Назад к PetTag</span>
    <% end %>
  </header>

  <div class="pj-pettag-content pj-pettag-form-content">
    <div class="pj-mobile-detail-nav pj-mobile-form-nav">
      <%= link_to pet_pet_tag_path(@pet), class: "pj-mobile-context-back" do %>
        <%= pj_icon(:chevron) %><span>К PetTag</span>
      <% end %>
    </div>

    <div class="pj-pettag-form-heading">
      <h1>Настройки PetTag</h1>
      <p>Управляйте публичным профилем, режимом потери, контактами и уведомлениями.</p>
    </div>

    <%= render "form" %>
  </div>
</div>
