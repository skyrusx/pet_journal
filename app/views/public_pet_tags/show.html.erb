<% content_for :title, "#{@pet.name} — PetTag — PetJournal" %>

<div class="pj-public-pettag">
  <header class="pj-public-pettag__brand">
    <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal" %>
    <span>PetTag</span>
  </header>

  <main class="pj-public-pettag__shell <%= "is-lost" if @pet_tag.status_lost? %>">
    <section class="pj-public-pettag__identity">
      <span class="pj-public-pettag__avatar">
        <% if @pet.photo.attached? %>
          <%= image_tag @pet.photo, alt: @pet.name %>
        <% else %>
          <%= @pet.name.to_s.first.to_s.upcase.presence || "P" %>
        <% end %>
      </span>
      <div>
        <h1><%= @pet.name %></h1>
        <p><%= @pet.breed.presence || @pet.species.presence || "Питомец" %></p>
      </div>
      <span class="pj-public-pettag__status <%= @pet_tag.status_lost? ? "is-danger" : @pet_tag.status_found? ? "is-warning" : "is-success" %>">
        <%= pet_tag_status_label(@pet_tag) %>
      </span>
    </section>

    <% if @pet_tag.status_lost? %>
      <section class="pj-public-pettag__alert">
        <strong><%= @pet.name %> потерялся!</strong>
        <p><%= @pet_tag.lost_message.presence || "Пожалуйста, свяжитесь с владельцем как можно скорее." %></p>
        <% if @pet_tag.last_seen_location.present? %><small>Последнее место: <%= @pet_tag.last_seen_location %></small><% end %>
      </section>
    <% elsif @pet_tag.status_found? %>
      <section class="pj-public-pettag__notice">
        <strong>Питомца уже нашли</strong>
        <p><%= @pet_tag.found_message.presence || "Владелец уже получил сообщение, но дополнительная информация всё ещё может быть полезна." %></p>
      </section>
    <% end %>

    <% if @pet_tag.public_message.present? %>
      <section class="pj-public-pettag__message"><%= @pet_tag.public_message %></section>
    <% end %>

    <% if @pet_tag.show_phone? && @pet_tag.contact_phone.present? %>
      <%= link_to "Позвонить владельцу",
                  "tel:#{@pet_tag.contact_phone.gsub(/[^\d+]/, "")}",
                  class: "pj-public-pettag__call" %>
    <% end %>

    <div class="pj-public-pettag__info-grid">
      <% if @pet_tag.behavior_notes.present? %>
        <section><span>Поведение</span><p><%= @pet_tag.behavior_notes %></p></section>
      <% end %>
      <% if @pet_tag.show_medical_notes? && @pet_tag.medical_notes.present? %>
        <section><span>Важно для здоровья</span><p><%= @pet_tag.medical_notes %></p></section>
      <% end %>
    </div>

    <section class="pj-public-pettag__found">
      <% if @pet_tag_scan.location_shared? %>
        <div class="pj-public-pettag__thanks">
          <strong>Спасибо, информация уже отправлена владельцу.</strong>
          <p>Повторная отправка из этого открытия PetTag заблокирована.</p>
        </div>
      <% else %>
        <div class="pj-public-pettag__found-heading">
          <h2>Я нашёл питомца</h2>
          <p>Оставьте контакт и примерное место. Геолокация передаётся только после вашего разрешения.</p>
        </div>

        <%= form_with url: public_pet_tag_location_path(@pet_tag.public_token), method: :post, local: true, class: "pj-public-pettag__form" do %>
          <%= hidden_field_tag :scan_token, @pet_tag_scan.public_token %>
          <%= hidden_field_tag :latitude, nil, id: "location-latitude" %>
          <%= hidden_field_tag :longitude, nil, id: "location-longitude" %>

          <div class="pj-public-pettag__field-row">
            <label><span>Ваше имя</span><%= text_field_tag :finder_name, nil, placeholder: "Как к вам обращаться" %></label>
            <label><span>Контакт для связи</span><%= text_field_tag :finder_contact, nil, placeholder: "Телефон или мессенджер" %></label>
          </div>
          <label><span>Ориентир</span><%= text_field_tag :location_note, nil, placeholder: "Например, у входа в парк" %></label>
          <label><span>Сообщение владельцу</span><%= text_area_tag :finder_message, nil, rows: 3, placeholder: "Где питомец и в каком он состоянии" %></label>

          <div class="pj-public-pettag__form-actions">
            <button type="button" class="pj-public-pettag__secondary" data-location-button>Добавить геолокацию</button>
            <%= submit_tag "Отправить владельцу", class: "pj-public-pettag__submit" %>
          </div>
          <div class="pj-public-pettag__location-status" data-location-status></div>
        <% end %>
      <% end %>
    </section>
  </main>

  <footer class="pj-public-pettag__footer">PetJournal · Только данные, которыми владелец решил поделиться</footer>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var button = document.querySelector("[data-location-button]");
    var status = document.querySelector("[data-location-status]");
    var latitude = document.getElementById("location-latitude");
    var longitude = document.getElementById("location-longitude");
    if (!button || !status || !latitude || !longitude) return;

    button.addEventListener("click", function () {
      if (!navigator.geolocation) {
        status.textContent = "Геолокация недоступна в этом браузере.";
        return;
      }
      status.textContent = "Запрашиваем разрешение…";
      navigator.geolocation.getCurrentPosition(function (position) {
        latitude.value = position.coords.latitude;
        longitude.value = position.coords.longitude;
        status.textContent = "Геолокация добавлена и будет отправлена вместе с сообщением.";
      }, function () {
        status.textContent = "Геолокация не получена. Можно отправить ориентир вручную.";
      }, { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 });
    });
  });
</script>
