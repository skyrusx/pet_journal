<% content_for :title, "#{@pet.name} — PetTag — PetJournal" %>
<% owner_name = "Владелец питомца" %>
<% phone = @pet_tag.public_phone %>
<% status_class = @pet_tag.status_lost? ? "is-danger" : (@pet_tag.status_found? ? "is-warning" : "is-success") %>
<% hero_title = if @pet_tag.status_lost?
                  "Я потерялся, но обо мне уже позаботились"
                elsif @pet_tag.status_found?
                  "Меня уже нашли — владелец знает"
                else
                  "Мой PetTag помогает быстро связаться с владельцем"
                end %>

<div class="pj-public-tag-page <%= "is-lost" if @pet_tag.status_lost? %>">
  <header class="pj-public-tag-header">
    <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", class: "pj-public-tag-logo" %>
  </header>

  <main class="pj-public-tag-main">
    <% if @pet_tag_scan.location_shared? %>
      <section class="pj-public-tag-success" aria-live="polite">
        <span class="pj-public-tag-success__icon">✓</span>
        <h1>Сообщение отправлено!</h1>
        <p>Владелец получил ваше сообщение и переданную информацию. Спасибо, что помогаете питомцу вернуться домой.</p>
        <div class="pj-public-tag-success__next">
          <strong>Что дальше?</strong>
          <span>Оставайтесь на связи, если владелец захочет уточнить детали.</span>
        </div>
        <%= link_to "Вернуться на главную", root_path, class: "pj-public-tag-primary-button" %>
      </section>
    <% else %>
      <section class="pj-public-tag-hero">
        <div class="pj-public-tag-hero__copy">
          <span class="pj-public-tag-eyebrow">PetTag · <%= @pet_tag.tag_code %></span>
          <h1><%= hero_title %> <span aria-hidden="true">💚</span></h1>
          <p>
            <% if @pet_tag.status_lost? %>
              Если вы нашли питомца, пожалуйста, <%= phone.present? ? "позвоните владельцу или " : "" %>отправьте сообщение ниже.
            <% elsif @pet_tag.status_found? %>
              Владелец уже получил информацию о находке. Дополнительное сообщение всё ещё может помочь.
            <% else %>
              Эта страница содержит только данные, которыми владелец решил поделиться для безопасности питомца.
            <% end %>
          </p>
        </div>

        <div class="pj-public-tag-pet-card">
          <div class="pj-public-tag-pet-card__photo">
            <% if @pet.photo.attached? %>
              <%= image_tag @pet.photo, alt: @pet.name %>
            <% else %>
              <span><%= @pet.name.to_s.first.to_s.upcase.presence || "P" %></span>
            <% end %>
          </div>

          <div class="pj-public-tag-pet-card__body">
            <div class="pj-public-tag-pet-card__heading">
              <div>
                <h2><%= @pet.name %></h2>
                <p><%= @pet.breed.presence || @pet.species.presence || "Питомец" %></p>
              </div>
              <span class="pj-public-tag-status <%= status_class %>"><%= pet_tag_status_label(@pet_tag) %></span>
            </div>

            <div class="pj-public-tag-pet-meta">
              <% if @pet.birth_date.present? %><span><%= pet_age_label(@pet.birth_date) %></span><% end %>
              <% if @pet.weight.present? %><span><%= @pet.weight %> кг</span><% end %>
              <% if @pet.color.present? %><span><%= @pet.color %></span><% end %>
            </div>

            <% if @pet_tag.behavior_notes.present? %>
              <div class="pj-public-tag-note">
                <span>Особые приметы</span>
                <p><%= @pet_tag.behavior_notes %></p>
              </div>
            <% end %>
          </div>
        </div>
      </section>

      <% if @pet_tag.status_lost? %>
        <section class="pj-public-tag-alert">
          <strong>⚠ <%= @pet.name %> потерялся!</strong>
          <p><%= @pet_tag.lost_message.presence || "Пожалуйста, отправьте сообщение владельцу как можно скорее." %></p>
          <% if @pet_tag.last_seen_location.present? %>
            <small>Последнее место: <%= @pet_tag.last_seen_location %></small>
          <% end %>
        </section>
      <% elsif @pet_tag.status_found? %>
        <section class="pj-public-tag-alert is-warning">
          <strong>Питомца уже нашли</strong>
          <p><%= @pet_tag.found_message.presence || "Владелец уже получил сообщение о находке." %></p>
        </section>
      <% end %>

      <section class="pj-public-tag-contact-grid">
        <article class="pj-public-tag-panel pj-public-tag-owner">
          <span class="pj-public-tag-panel__label"><%= phone.present? ? "Экстренный контакт" : "Связь с владельцем" %></span>
          <div class="pj-public-tag-owner__identity">
            <span class="pj-public-tag-owner__avatar"><%= owner_name.first.to_s.upcase %></span>
            <div>
              <strong><%= owner_name %></strong>
              <% if phone.present? %>
                <%= link_to phone,
                            "tel:#{phone.gsub(/[^\d+]/, "")}",
                            class: "pj-public-tag-owner__phone",
                            aria: { label: "Позвонить владельцу по номеру #{phone}" } %>
              <% end %>
            </div>
          </div>
          <% if phone.present? %>
            <p class="pj-public-tag-muted">Владелец отдельно разрешил публикацию этого номера на странице PetTag.</p>
          <% else %>
            <p class="pj-public-tag-muted">Прямой телефон скрыт. Используйте защищённую форму сообщения.</p>
          <% end %>
        </article>

        <article class="pj-public-tag-panel pj-public-tag-contact-actions">
          <span class="pj-public-tag-panel__label">Связаться с владельцем</span>
          <% if phone.present? %>
            <%= link_to "Позвонить", "tel:#{phone.gsub(/[^\d+]/, "")}", class: "pj-public-tag-outline-button" %>
          <% end %>
          <a href="#found-form" class="pj-public-tag-outline-button">Написать владельцу</a>
          <small>Контакт из формы попадёт только владельцу вместе с сообщением.</small>
        </article>

        <article class="pj-public-tag-panel pj-public-tag-trust">
          <span class="pj-public-tag-panel__label">Безопасность и приватность</span>
          <ul>
            <li>Показываются только данные, которыми владелец решил поделиться о питомце</li>
            <% if phone.present? %>
              <li>Номер телефона опубликован по отдельному действующему согласию владельца</li>
            <% else %>
              <li>Прямые персональные контакты владельца не публикуются без отдельного согласия</li>
            <% end %>
            <li>Геолокация отправляется только после разрешения браузера и вашего согласия</li>
            <li>Публичная страница не индексируется поисковиками</li>
          </ul>
        </article>
      </section>

      <% if @pet_tag.public_message.present? || (@pet_tag.show_medical_notes? && @pet_tag.medical_notes.present?) %>
        <section class="pj-public-tag-info-row">
          <% if @pet_tag.public_message.present? %>
            <article class="pj-public-tag-panel">
              <span class="pj-public-tag-panel__label">Сообщение владельца</span>
              <p><%= @pet_tag.public_message %></p>
            </article>
          <% end %>
          <% if @pet_tag.show_medical_notes? && @pet_tag.medical_notes.present? %>
            <article class="pj-public-tag-panel">
              <span class="pj-public-tag-panel__label">Важно для здоровья</span>
              <p><%= @pet_tag.medical_notes %></p>
            </article>
          <% end %>
        </section>
      <% end %>

      <section class="pj-public-tag-found" id="found-form">
        <div class="pj-public-tag-found__heading">
          <span class="pj-public-tag-eyebrow">Сообщение владельцу</span>
          <h2>Я нашёл питомца</h2>
          <p>Укажите, где вы нашли питомца и как с вами связаться. Геолокация передаётся только после вашего разрешения.</p>
        </div>

        <%= form_with url: public_pet_tag_location_path(@pet_tag.public_token), method: :post, local: true, class: "pj-public-tag-form" do %>
          <%= hidden_field_tag :scan_token, @pet_tag_scan.public_token %>
          <%= hidden_field_tag :latitude, nil, id: "location-latitude" %>
          <%= hidden_field_tag :longitude, nil, id: "location-longitude" %>

          <div class="pj-public-tag-form__row">
            <label>
              <span>Ваше имя</span>
              <%= text_field_tag :finder_name, nil, placeholder: "Как к вам обращаться" %>
            </label>
            <label>
              <span>Контакт для связи</span>
              <%= text_field_tag :finder_contact, nil, placeholder: "Телефон или мессенджер" %>
            </label>
          </div>

          <label>
            <span>Место находки</span>
            <%= text_field_tag :location_note, nil, placeholder: "Например, у входа в парк" %>
          </label>

          <label>
            <span>Ваше сообщение</span>
            <%= text_area_tag :finder_message, nil, rows: 4, placeholder: "Где питомец и в каком он состоянии" %>
          </label>

          <button type="button" class="pj-public-tag-location-button" data-location-button>
            <span>⌖</span>
            <span><strong>Добавить мою геолокацию</strong><small>Только с вашего разрешения</small></span>
          </button>
          <div class="pj-public-tag-location-status" data-location-status aria-live="polite"></div>

          <div class="pj-public-tag-consent">
            <label class="pj-public-tag-consent__check">
              <%= check_box_tag :finder_personal_data_consent, "1", false, required: true %>
              <span>Я даю <%= link_to "согласие на обработку переданных мной данных",
                                      pet_tag_data_consent_path,
                                      target: "_blank",
                                      rel: "noopener" %>.</span>
            </label>
            <p>Подробнее — в <%= link_to "Политике обработки персональных данных",
                                        privacy_path,
                                        target: "_blank",
                                        rel: "noopener" %>.</p>
          </div>

          <%= submit_tag "Отправить владельцу", class: "pj-public-tag-primary-button" %>
          <small class="pj-public-tag-form__privacy">Контактные данные из этой формы увидит только владелец питомца.</small>
        <% end %>
      </section>
    <% end %>
  </main>

  <footer class="pj-public-tag-footer">
    <span>Спасибо, что помогаете вернуть питомца домой.</span>
    <span>PetJournal · безопасность и забота · <%= link_to "Конфиденциальность", privacy_path %></span>
  </footer>
</div>
