<% if resource.errors.any? %>
  <div class="flash-stack" id="error_explanation" data-turbo-temporary aria-live="polite" aria-atomic="true">
    <div class="flash-toast alert" role="alert" data-flash-toast>
      <div>
        <strong>Проверьте форму</strong>
        <p><%= resource.errors.full_messages.join(". ") %></p>
      </div>
      <button type="button" aria-label="Закрыть уведомление" data-flash-close></button>
    </div>
  </div>
<% end %>
