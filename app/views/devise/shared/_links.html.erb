<div class="auth-links">
  <%- if controller_name != "sessions" %>
    <%= link_to "Войти", new_session_path(resource_name), class: "auth-link-primary" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to "Создать аккаунт", new_registration_path(resource_name), class: "auth-link-primary" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <%= link_to "Забыли пароль?", new_password_path(resource_name) %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != "confirmations" %>
    <%= link_to "Не пришло подтверждение?", new_confirmation_path(resource_name) %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != "unlocks" %>
    <%= link_to "Не пришла разблокировка?", new_unlock_path(resource_name) %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Войти через #{OmniAuth::Utils.camelize(provider)}",
                    omniauth_authorize_path(resource_name, provider),
                    data: { turbo: false },
                    class: "btn btn-outline-secondary btn-sm auth-oauth-button" %>
    <% end %>
  <% end %>
</div>
