<header class="auth-v2-header" aria-label="Навигация авторизации">
  <%= link_to "На главную",
              root_path,
              class: "auth-v2-back",
              aria: { label: "Вернуться на главную PetJournal" } %>

  <%= link_to root_path, class: "auth-v2-brand", aria: { label: "PetJournal — главная" } do %>
    <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", width: 148, height: 42 %>
  <% end %>

  <% if controller_name == "sessions" %>
    <%= link_to "Создать аккаунт", new_user_registration_path, class: "auth-v2-alt" %>
  <% elsif controller_name == "registrations" && action_name == "new" %>
    <%= link_to "Войти", new_user_session_path, class: "auth-v2-alt" %>
  <% elsif controller_name == "passwords" %>
    <%= link_to "Войти", new_user_session_path, class: "auth-v2-alt" %>
  <% else %>
    <span class="auth-v2-alt" aria-hidden="true"></span>
  <% end %>
</header>
