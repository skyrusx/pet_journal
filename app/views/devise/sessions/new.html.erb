<div class="auth-page py-4">
  <section class="auth-card">
    <div class="auth-copy">
      <div class="text-muted small mb-1">PetJournal</div>
      <h1 class="h3 mb-2">Вход</h1>
      <p class="text-muted mb-0">Вернитесь к карточкам питомцев, журналу событий и QR-профилям безопасности.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <div class="mb-3">
        <%= f.label :email, "Эл. почта", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, "Пароль", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-check mb-3">
          <%= f.check_box :remember_me, class: "form-check-input" %>
          <%= f.label :remember_me, "Запомнить меня", class: "form-check-label" %>
        </div>
      <% end %>

      <%= f.submit "Войти", class: "btn btn-primary w-100" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>
</div>
