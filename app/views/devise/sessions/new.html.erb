<%= render "devise/shared/auth_v2_navbar" %>

<div class="pj-auth-v2">
  <main class="pj-auth-v2-main">
    <div class="pj-auth-v2-shell">
      <section class="pj-auth-v2-stage" aria-labelledby="pj-auth-v2-title">
        <div class="pj-auth-v2-visual" aria-hidden="true">
          <div class="pj-auth-v2-brand-card">
            <%= image_tag "petjournal/logo-horizontal.png", alt: "", class: "pj-auth-v2-brand-card__logo" %>
            <h2>Ваш журнал заботы о питомце</h2>
            <p>Здоровье, важные события и документы — всегда рядом.</p>
            <div class="pj-auth-v2-brand-card__benefits">
              <span>Напоминания</span>
              <span>Документы</span>
              <span>PetTag</span>
            </div>
          </div>
        </div>

        <div class="pj-auth-v2-form-side">
          <div class="pj-auth-v2-card">
            <div class="pj-auth-v2-heading">
              <h1 id="pj-auth-v2-title">Вход</h1>
              <p>Добро пожаловать! Мы рады вас видеть.</p>
            </div>

            <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "pj-auth-v2-form" }) do |f| %>
              <div class="pj-auth-v2-field">
                <%= f.label :email, "Email" %>
                <%= f.email_field :email,
                                  autofocus: true,
                                  autocomplete: "email",
                                  placeholder: "example@mail.ru",
                                  class: "pj-auth-v2-input" %>
              </div>

              <div class="pj-auth-v2-field">
                <div class="pj-auth-v2-field-row">
                  <%= f.label :password, "Пароль" %>
                  <%= link_to "Забыли пароль?", new_password_path(resource_name), class: "pj-auth-v2-forgot" %>
                </div>
                <div class="pj-auth-v2-password">
                  <%= f.password_field :password,
                                       autocomplete: "current-password",
                                       class: "pj-auth-v2-input",
                                       data: { password_input: true } %>
                  <%= render "devise/shared/password_toggle" %>
                </div>
              </div>

              <%= f.submit "Войти", class: "pj-auth-v2-submit" %>
            <% end %>

            <div class="pj-auth-v2-divider"><span>или войдите через</span></div>

            <div class="pj-auth-v2-socials" aria-label="Социальный вход">
              <button class="pj-auth-v2-social" type="button" aria-disabled="true" title="Подключим VK ID следующим этапом">
                <span class="pj-auth-v2-social__vk" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M6.79 7.3H4.05c.13 6.24 3.25 9.99 8.72 9.99h.31v-3.57c2.01.2 3.53 1.67 4.14 3.57h2.84c-.78-2.84-2.83-4.41-4.11-5.01 1.28-.74 3.08-2.54 3.51-4.98h-2.58c-.56 1.98-2.22 3.78-3.8 3.95V7.3H10.5v6.92c-1.6-.4-3.62-2.34-3.71-6.92Z"/>
                  </svg>
                </span>
                <span>VK ID</span>
              </button>

              <button class="pj-auth-v2-social" type="button" aria-disabled="true" title="Подключим Яндекс ID следующим этапом">
                <span class="pj-auth-v2-social__ya" aria-hidden="true">Я</span>
                <span>Яндекс ID</span>
              </button>
            </div>

            <p class="pj-auth-v2-register">
              Нет аккаунта?
              <%= link_to "Зарегистрироваться", new_registration_path(resource_name) %>
            </p>
          </div>
        </div>
      </section>
    </div>
  </main>
</div>
