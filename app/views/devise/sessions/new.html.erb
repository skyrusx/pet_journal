<%= render "devise/shared/auth_v2_navbar" %>

<div class="pj-auth-v2">
  <main class="pj-auth-v2-main">
    <div class="pj-auth-v2-shell">
      <section class="pj-auth-v2-stage" aria-labelledby="pj-auth-v2-title">
        <div class="pj-auth-v2-visual" aria-hidden="true">
          <div class="pj-auth-v2-brand-card">
            <%= image_tag "petjournal/logo-horizontal.png", alt: "", class: "pj-auth-v2-brand-card__logo" %>
            <h2>Ваш журнал заботы о питомце</h2>
            <ul class="pj-auth-v2-brand-card__benefits">
              <li>Напоминания о событиях</li>
              <li>Документы в порядке</li>
              <li>PetTag — безопасность</li>
            </ul>
          </div>
        </div>

        <div class="pj-auth-v2-form-side">
          <div class="pj-auth-v2-card">
            <div class="pj-auth-v2-heading">
              <h1 id="pj-auth-v2-title">Вход</h1>
              <p>Добро пожаловать!<br>Мы рады вас видеть.</p>
            </div>

            <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "pj-auth-v2-form" }) do |f| %>
              <%= render "shared/public_form_protection" %>

              <div class="pj-auth-v2-field">
                <%= f.label :email, "Email" %>
                <%= f.email_field :email,
                                  autocomplete: "email",
                                  placeholder: "example@mail.ru",
                                  required: true,
                                  class: "pj-auth-v2-input" %>
              </div>

              <div class="pj-auth-v2-field">
                <div class="pj-auth-v2-field-row">
                  <%= f.label :password, "Пароль" %>
                  <%= link_to "Забыли пароль?", new_password_path(resource_name), class: "pj-auth-v2-forgot" %>
                </div>
                <div class="pj-auth-v2-password auth-password-field">
                  <%= f.password_field :password,
                                       autocomplete: "current-password",
                                       placeholder: "••••••••",
                                       required: true,
                                       class: "pj-auth-v2-input",
                                       data: { password_input: true } %>
                  <%= render "devise/shared/password_toggle" %>
                </div>
              </div>

              <%= f.submit "Войти", class: "pj-auth-v2-submit" %>
            <% end %>

            <%= render "devise/shared/oauth_buttons", divider_text: "или войдите через" %>

            <p class="pj-auth-v2-register">
              Нет аккаунта?
              <%= link_to "Зарегистрироваться", new_registration_path(resource_name) %>
            </p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <%= render "devise/shared/auth_v2_footer" %>
</div>
