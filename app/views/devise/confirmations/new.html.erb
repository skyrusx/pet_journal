<div class="auth-page">
  <section class="auth-card">
    <div class="auth-copy">
      <%= link_to root_path, class: "auth-brand", aria: { label: "PetJournal — главная" } do %>
        <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", width: 172, height: 49 %>
      <% end %>
      <span>Подтверждение почты</span>
      <h1>Отправим инструкцию ещё раз</h1>
      <p>Укажите эл. почту, чтобы повторно получить письмо подтверждения.</p>
      <ul>
        <li>Проверьте папку «Спам»</li>
        <li>Используйте почту, указанную при регистрации</li>
        <li>Подтверждение защищает аккаунт</li>
      </ul>
      <div class="auth-pettag-art" aria-hidden="true">
        <span class="auth-pettag-ring"></span>
        <span class="auth-pettag-qr"></span>
        <span class="auth-pettag-label">PetTag</span>
      </div>
    </div>

    <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
      <div class="auth-form-heading">
        <span>Почта</span>
        <h2>Повторить письмо</h2>
      </div>

      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-3">
        <%= f.label :email, "Эл. почта", class: "form-label" %>
        <%= f.email_field :email,
                          autofocus: true,
                          autocomplete: "email",
                          value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email),
                          class: "form-control" %>
      </div>

      <%= f.submit "Отправить инструкцию", class: "btn btn-primary w-100 auth-submit" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>
</div>
