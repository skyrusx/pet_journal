<%= render "devise/shared/auth_header" %>

<div class="auth-page">
  <section class="auth-card">
    <div class="auth-copy">
      <%= link_to root_path, class: "auth-brand", aria: { label: "PetJournal — главная" } do %>
        <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", width: 172, height: 49 %>
      <% end %>
      <span>PetJournal</span>
      <h1>Начните с питомца</h1>
      <p>Создайте аккаунт, добавьте питомца и начните собирать историю здоровья в одном месте.</p>
      <ul>
        <li>Первую карточку можно создать сразу</li>
        <li>Данные закрыты по умолчанию</li>
        <li>PetTag доступен в профиле питомца</li>
      </ul>
      <div class="auth-pettag-art" aria-hidden="true"></div>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <div class="auth-form-heading">
        <span>Создайте аккаунт</span>
        <h2>Регистрация</h2>
      </div>

      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-3">
        <%= f.label :email, "Электронная почта", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, "Пароль", class: "form-label" %>
        <% if @minimum_password_length %>
          <div class="form-text">Минимум <%= @minimum_password_length %> символов.</div>
        <% end %>
        <div class="auth-password-field">
          <%= f.password_field :password, autocomplete: "new-password", class: "form-control", data: { password_input: true } %>
          <%= render "devise/shared/password_toggle" %>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, "Повторите пароль", class: "form-label" %>
        <div class="auth-password-field">
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", data: { password_input: true } %>
          <%= render "devise/shared/password_toggle" %>
        </div>
      </div>

      <%= f.submit "Зарегистрироваться", class: "btn btn-primary w-100 auth-submit" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>
</div>
