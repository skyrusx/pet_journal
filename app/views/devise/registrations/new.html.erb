<%= render "devise/shared/auth_v2_navbar" %>

<div class="pj-auth-v2 pj-auth-v2--registration">
  <main class="pj-auth-v2-main">
    <div class="pj-auth-v2-shell">
      <section class="pj-auth-v2-stage" aria-labelledby="pj-auth-v2-title">
        <div class="pj-auth-v2-visual" aria-hidden="true">
          <div class="pj-auth-v2-brand-card">
            <%= image_tag "petjournal/logo-horizontal.png", alt: "", class: "pj-auth-v2-brand-card__logo" %>
            <h2>Ваш журнал заботы о питомце</h2>
            <ul class="pj-auth-v2-brand-card__benefits">
              <li>Напоминания о событиях</li>
              <li>Документы в порядке</li>
              <li>PetTag — безопасность</li>
            </ul>
          </div>
        </div>

        <div class="pj-auth-v2-form-side">
          <div class="pj-auth-v2-card">
            <div class="pj-auth-v2-heading">
              <h1 id="pj-auth-v2-title">Регистрация</h1>
              <p>Создайте аккаунт, чтобы начать<br>заботиться о питомце.</p>
            </div>

            <%= render "devise/shared/error_messages", resource: resource %>

            <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "pj-auth-v2-form pj-auth-v2-registration-form" }) do |f| %>
              <div class="pj-auth-v2-field">
                <%= f.label :name, "Имя" %>
                <%= f.text_field :name,
                                 autocomplete: "name",
                                 placeholder: "Введите имя",
                                 required: true,
                                 class: "pj-auth-v2-input" %>
              </div>

              <div class="pj-auth-v2-field">
                <%= f.label :email, "Email" %>
                <%= f.email_field :email,
                                  autocomplete: "email",
                                  placeholder: "example@mail.ru",
                                  required: true,
                                  class: "pj-auth-v2-input" %>
              </div>

              <div class="pj-auth-v2-field">
                <%= f.label :password, "Пароль" %>
                <div class="pj-auth-v2-password auth-password-field">
                  <%= f.password_field :password,
                                       autocomplete: "new-password",
                                       placeholder: "••••••••",
                                       required: true,
                                       class: "pj-auth-v2-input",
                                       data: { password_input: true } %>
                  <%= render "devise/shared/password_toggle" %>
                </div>
              </div>

              <div class="pj-auth-v2-field">
                <%= f.label :password_confirmation, "Повторите пароль" %>
                <div class="pj-auth-v2-password auth-password-field">
                  <%= f.password_field :password_confirmation,
                                       autocomplete: "new-password",
                                       placeholder: "••••••••",
                                       required: true,
                                       class: "pj-auth-v2-input",
                                       data: { password_input: true } %>
                  <%= render "devise/shared/password_toggle" %>
                </div>
              </div>

              <div class="pj-auth-v2-consent">
                <label class="pj-auth-v2-consent__check">
                  <%= f.check_box :personal_data_consent, { required: true }, "1", "0" %>
                  <span>Я даю <%= legal_link :personal_data_consent,
                                              lowercase: true,
                                              target: "_blank",
                                              rel: "noopener" %>.</span>
                </label>
                <p>Подробнее: <%= legal_link :privacy,
                                             target: "_blank",
                                             rel: "noopener" %>.</p>
              </div>

              <%= f.submit "Зарегистрироваться", class: "pj-auth-v2-submit" %>
            <% end %>

            <p class="pj-auth-v2-register">
              Уже есть аккаунт?
              <%= link_to "Войти", new_session_path(resource_name) %>
            </p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <%= render "devise/shared/auth_v2_footer", show_legal: false %>
</div>