<div class="auth-page py-4">
  <section class="auth-card">
    <div class="auth-copy">
      <div class="text-muted small mb-1">PetJournal</div>
      <h1 class="h3 mb-2">Регистрация</h1>
      <p class="text-muted mb-0">Создайте приватное пространство для истории здоровья, документов и PetTag.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-3">
        <%= f.label :email, "Эл. почта", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, "Пароль", class: "form-label" %>
        <% if @minimum_password_length %>
          <div class="form-text">Минимум <%= @minimum_password_length %> символов.</div>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, "Повторите пароль", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
      </div>

      <%= f.submit "Создать аккаунт", class: "btn btn-primary w-100" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>
</div>
