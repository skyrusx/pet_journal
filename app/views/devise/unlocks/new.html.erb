<div class="auth-page py-4">
  <section class="auth-card">
    <div class="auth-copy">
      <div class="text-muted small mb-1">Разблокировка</div>
      <h1 class="h3 mb-2">Повторить инструкцию</h1>
      <p class="text-muted mb-0">Укажите эл. почту, чтобы получить письмо для разблокировки аккаунта.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-3">
        <%= f.label :email, "Эл. почта", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
      </div>

      <%= f.submit "Отправить инструкцию", class: "btn btn-primary w-100" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>
</div>
