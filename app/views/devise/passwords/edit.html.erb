<div class="auth-page">
  <section class="auth-card">
    <div class="auth-copy">
      <%= link_to root_path, class: "auth-brand", aria: { label: "PetJournal — главная" } do %>
        <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", width: 172, height: 49 %>
      <% end %>
      <span>Новый пароль</span>
      <h1>Защитите доступ к PetJournal</h1>
      <p>Задайте новый пароль для входа в дневник питомца.</p>
      <ul>
        <li>Используйте пароль, который не повторяется</li>
        <li>Минимальная длина показана в форме</li>
        <li>После смены можно войти снова</li>
      </ul>
      <div class="auth-pettag-art" aria-hidden="true">
        <span class="auth-pettag-ring"></span>
        <span class="auth-pettag-qr"></span>
        <span class="auth-pettag-label">PetTag</span>
      </div>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
      <div class="auth-form-heading">
        <span>Доступ</span>
        <h2>Сменить пароль</h2>
      </div>

      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="mb-3">
        <%= f.label :password, "Новый пароль", class: "form-label" %>
        <% if @minimum_password_length %>
          <div class="form-text">Минимум <%= @minimum_password_length %> символов.</div>
        <% end %>
        <div class="auth-password-field">
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control", data: { password_input: true } %>
          <%= render "devise/shared/password_toggle" %>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, "Повторите пароль", class: "form-label" %>
        <div class="auth-password-field">
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", data: { password_input: true } %>
          <%= render "devise/shared/password_toggle" %>
        </div>
      </div>

      <%= f.submit "Сменить пароль", class: "btn btn-primary w-100 auth-submit" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>
</div>
