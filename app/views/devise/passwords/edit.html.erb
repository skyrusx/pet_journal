<div class="auth-page py-4">
  <section class="auth-card">
    <div class="auth-copy">
      <div class="text-muted small mb-1">Восстановление доступа</div>
      <h1 class="h3 mb-2">Новый пароль</h1>
      <p class="text-muted mb-0">Задайте новый пароль для входа в PetJournal.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="mb-3">
        <%= f.label :password, "Новый пароль", class: "form-label" %>
        <% if @minimum_password_length %>
          <div class="form-text">Минимум <%= @minimum_password_length %> символов.</div>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, "Повторите пароль", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
      </div>

      <%= f.submit "Сменить пароль", class: "btn btn-primary w-100" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>
</div>
