<%= render "devise/shared/auth_v2_navbar" %>

<div class="pj-auth-v2 pj-auth-v2--reset-password">
  <main class="pj-auth-v2-main">
    <div class="pj-auth-v2-shell">
      <section class="pj-auth-v2-stage" aria-labelledby="pj-auth-v2-title">
        <div class="pj-auth-v2-visual" aria-hidden="true">
          <div class="pj-auth-v2-brand-card">
            <%= image_tag "petjournal/logo-horizontal.png", alt: "", class: "pj-auth-v2-brand-card__logo" %>
            <h2>Ваш журнал заботы о питомце</h2>
            <ul class="pj-auth-v2-brand-card__benefits">
              <li>Напоминания о событиях</li>
              <li>Документы в порядке</li>
              <li>PetTag — безопасность</li>
            </ul>
          </div>
        </div>

        <div class="pj-auth-v2-form-side">
          <div class="pj-auth-v2-card">
            <div class="pj-auth-v2-heading">
              <h1 id="pj-auth-v2-title">Новый пароль</h1>
              <p>Придумайте новый пароль<br>для входа в PetJournal.</p>
            </div>

            <%= render "devise/shared/error_messages", resource: resource %>

            <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "pj-auth-v2-form" }) do |f| %>
              <%= f.hidden_field :reset_password_token %>

              <div class="pj-auth-v2-field">
                <%= f.label :password, "Новый пароль" %>
                <div class="pj-auth-v2-password auth-password-field">
                  <%= f.password_field :password,
                                       autocomplete: "new-password",
                                       placeholder: "••••••••",
                                       required: true,
                                       minlength: @minimum_password_length,
                                       aria: (@minimum_password_length ? { describedby: "pj-auth-v2-password-hint" } : {}),
                                       class: "pj-auth-v2-input",
                                       data: { password_input: true } %>
                  <%= render "devise/shared/password_toggle" %>
                </div>
                <% if @minimum_password_length %>
                  <p class="pj-auth-v2-password-hint" id="pj-auth-v2-password-hint">
                    Минимум <%= @minimum_password_length %> символов
                  </p>
                <% end %>
              </div>

              <div class="pj-auth-v2-field">
                <%= f.label :password_confirmation, "Повторите пароль" %>
                <div class="pj-auth-v2-password auth-password-field">
                  <%= f.password_field :password_confirmation,
                                       autocomplete: "new-password",
                                       placeholder: "••••••••",
                                       required: true,
                                       minlength: @minimum_password_length,
                                       class: "pj-auth-v2-input",
                                       data: { password_input: true } %>
                  <%= render "devise/shared/password_toggle" %>
                </div>
              </div>

              <%= f.submit "Сохранить новый пароль", class: "pj-auth-v2-submit" %>
            <% end %>

            <p class="pj-auth-v2-register pj-auth-v2-back-link">
              <%= link_to "← Вернуться ко входу", new_session_path(resource_name) %>
            </p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <%= render "devise/shared/auth_v2_footer" %>
</div>