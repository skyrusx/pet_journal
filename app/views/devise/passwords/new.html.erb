<div class="auth-page">
  <section class="auth-card">
    <div class="auth-copy">
      <%= link_to root_path, class: "auth-brand", aria: { label: "PetJournal — главная" } do %>
        <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", width: 172, height: 49 %>
      <% end %>
      <span>Восстановление доступа</span>
      <h1>Вернём доступ к журналу</h1>
      <p>Укажите эл. почту, и мы отправим ссылку для смены пароля.</p>
      <ul>
        <li>Ссылка придёт на почту аккаунта</li>
        <li>Старый пароль менять вручную не нужно</li>
        <li>Ваши данные остаются закрытыми</li>
      </ul>
      <div class="auth-pettag-art" aria-hidden="true">
        <span class="auth-pettag-ring"></span>
        <span class="auth-pettag-qr"></span>
        <span class="auth-pettag-label">PetTag</span>
      </div>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
      <div class="auth-form-heading">
        <span>Пароль</span>
        <h2>Получить ссылку</h2>
      </div>

      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-3">
        <%= f.label :email, "Эл. почта", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
      </div>

      <%= f.submit "Отправить ссылку", class: "btn btn-primary w-100 auth-submit" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>
</div>
