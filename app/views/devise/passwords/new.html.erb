<%= render "devise/shared/auth_header" %>

<div class="auth-page">
  <section class="auth-card">
    <div class="auth-copy">
      <%= link_to root_path, class: "auth-brand", aria: { label: "PetJournal — главная" } do %>
        <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", width: 172, height: 49 %>
      <% end %>
      <span>PetJournal</span>
      <h1>Доступ к журналу можно восстановить</h1>
      <p>Мы отправим ссылку на электронную почту, указанную при регистрации.</p>
      <ul>
        <li>Ссылка придёт на почту аккаунта</li>
        <li>Данные питомцев останутся на месте</li>
        <li>После смены пароля можно войти снова</li>
      </ul>
      <div class="auth-pettag-art" aria-hidden="true"></div>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
      <div class="auth-form-heading">
        <span>Доступ к аккаунту</span>
        <h2>Восстановление пароля</h2>
      </div>

      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-3">
        <%= f.label :email, "Электронная почта", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
      </div>

      <%= f.submit "Отправить инструкцию", class: "btn btn-primary w-100 auth-submit" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>
</div>
