<% if user_signed_in? %>
  <div class="home-dashboard home-dashboard-release py-4">
    <section class="home-hero home-hero-calm mb-4">
      <div>
        <div class="text-muted small mb-1">Сегодня в PetJournal</div>
        <h1 class="h2 mb-2">Всё важное о питомцах — без лишнего шума</h1>
        <p class="text-muted mb-0">Сначала — что требует внимания, затем история и остальные разделы.</p>
      </div>

      <div class="home-hero-actions">
        <% if @pets.any? %>
          <%= link_to "Добавить запись", new_pet_pet_event_path(@pets.first), class: "btn btn-primary" %>
          <%= link_to "Добавить питомца", new_pet_path, class: "btn btn-outline-secondary" %>
        <% else %>
          <%= link_to "Добавить питомца", new_pet_path, class: "btn btn-primary" %>
        <% end %>
      </div>
    </section>

    <% if @pets.any? %>
      <section class="dashboard-section home-today mb-4">
        <div class="section-heading">
          <div>
            <div class="text-muted small mb-1">Главное сейчас</div>
            <h2 class="h4 mb-1">Сегодня и ближайшее</h2>
            <p class="text-muted mb-0">Только то, что может потребовать вашего внимания.</p>
          </div>
          <% if @overdue_reminders_count.positive? || @today_reminders_count.positive? %>
            <span class="home-attention-count">
              <%= @overdue_reminders_count + @today_reminders_count %>
              <%= russian_plural(@overdue_reminders_count + @today_reminders_count, "дело", "дела", "дел") %>
            </span>
          <% end %>
        </div>

        <div class="home-priority-list">
          <% priority_items = @next_reminders.first(3) %>
          <% priority_items.each do |reminder| %>
            <%= link_to pet_reminder_path(reminder.pet, reminder), class: class_names("home-priority-item", danger: reminder.overdue?, warning: reminder.due_today?) do %>
              <span class="home-priority-marker" aria-hidden="true"></span>
              <span class="home-priority-copy">
                <strong><%= reminder.title %></strong>
                <small><%= reminder.pet.name %> · <%= reminder.reminder_type_label %></small>
              </span>
              <span class="home-priority-time">
                <% if reminder.overdue? %>
                  Просрочено
                <% elsif reminder.due_today? %>
                  сегодня · <%= reminder.next_run_at.strftime("%H:%M") %>
                <% else %>
                  <%= reminder.next_run_at.strftime("%d.%m") %>
                <% end %>
              </span>
            <% end %>
          <% end %>

          <% @expiring_documents.first(2).each do |document| %>
            <%= link_to pet_pet_document_path(document.pet, document), class: "home-priority-item document" do %>
              <span class="home-priority-marker" aria-hidden="true"></span>
              <span class="home-priority-copy">
                <strong><%= document.title %></strong>
                <small><%= document.pet.name %> · документ</small>
              </span>
              <span class="home-priority-time">до <%= document.expires_on.strftime("%d.%m") %></span>
            <% end %>
          <% end %>

          <% if priority_items.empty? && @expiring_documents.empty? %>
            <div class="home-priority-empty">
              <strong>Срочных дел нет</strong>
              <span>Ближайшие напоминания и сроки документов появятся здесь.</span>
            </div>
          <% end %>
        </div>
      </section>

      <div class="home-layout home-layout-release">
        <section class="home-main">
          <div class="dashboard-section">
            <div class="section-heading">
              <div>
                <h2 class="h4 mb-1">Мои питомцы</h2>
                <p class="text-muted mb-0">Состояние и последнее важное изменение по каждому питомцу.</p>
              </div>
              <%= link_to "Все питомцы", pets_path, class: "btn btn-outline-secondary btn-sm" %>
            </div>

            <div class="home-pet-grid">
              <% @pets.each do |pet| %>
                <% latest_event = @latest_events_by_pet_id[pet.id] %>
                <% pet_tag = pet.pet_tag %>
                <% next_reminder = pet.reminders.status_active.order(:next_run_at).first %>
                <% signal = pet_overview_signal(pet, pet_tag, pet_tag&.pet_tag_scans&.order(created_at: :desc)&.first, latest_event, next_reminder) %>

                <article class="home-pet-card">
                  <div class="home-pet-card-main">
                    <% if pet.photo.attached? %>
                      <%= image_tag pet.photo, class: "pet-card-photo", alt: pet.name, loading: "lazy" %>
                    <% else %>
                      <div class="pet-card-photo pet-card-photo-placeholder"><%= pet.name.to_s.first.to_s.upcase.presence || "P" %></div>
                    <% end %>

                    <div class="pet-card-body">
                      <div class="d-flex justify-content-between gap-2 align-items-start mb-2">
                        <div>
                          <h3 class="h5 mb-1"><%= link_to pet.name, pet_path(pet), class: "text-dark text-decoration-none" %></h3>
                          <div class="text-muted small"><%= pet_age(pet) %> · <%= pet_short_description(pet) %></div>
                        </div>
                        <span class="signal-pill"><%= signal[:label] %></span>
                      </div>

                      <div class="activity-line">
                        <div class="home-card-signal mb-1"><%= signal[:title] %></div>
                        <div class="text-muted small"><%= signal[:body] %></div>
                      </div>
                    </div>
                  </div>

                  <div class="pet-card-actions">
                    <%= link_to "Открыть", pet_path(pet), class: "btn btn-outline-secondary btn-sm" %>
                    <%= link_to "Добавить запись", new_pet_pet_event_path(pet), class: "btn btn-primary btn-sm" %>
                  </div>
                </article>
              <% end %>
            </div>
          </div>

          <div class="dashboard-section">
            <div class="section-heading compact">
              <div>
                <div class="text-muted small mb-1">Последняя активность</div>
                <h2 class="h4 mb-0">История</h2>
              </div>
            </div>

            <% if @recent_events.any? %>
              <div class="dashboard-timeline">
                <% @recent_events.each do |event| %>
                  <article class="dashboard-timeline-item <%= event_tone(event.event_type) %>">
                    <div class="dashboard-timeline-date">
                      <strong><%= event.event_date.strftime("%d") %></strong>
                      <span><%= event.event_date.strftime("%m.%Y") %></span>
                    </div>
                    <div class="dashboard-timeline-body">
                      <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
                        <span class="event-badge"><%= event.event_type_label %></span>
                        <span class="attachment-pill"><%= event.pet.name %></span>
                      </div>
                      <h3 class="h6 mb-1"><%= link_to event.title.presence || event.event_type_label, pet_pet_event_path(event.pet, event), class: "text-dark text-decoration-none" %></h3>
                      <p class="text-muted mb-0"><%= event_structured_summary(event) %></p>
                    </div>
                  </article>
                <% end %>
              </div>
            <% else %>
              <div class="empty-state-inline">
                <h3 class="h5 mb-2">Журнал пока пуст</h3>
                <p class="text-muted mb-3">Добавьте вес, вакцинацию, визит к врачу или обычную заметку.</p>
                <%= link_to "Добавить первую запись", new_pet_pet_event_path(@pets.first), class: "btn btn-primary btn-sm" %>
              </div>
            <% end %>
          </div>
        </section>

        <aside class="home-side">
          <% primary_pet = @pets.first %>
          <section class="dashboard-section home-shortcuts">
            <div class="section-heading compact">
              <div>
                <div class="text-muted small mb-1">Быстрый доступ</div>
                <h2 class="h4 mb-0"><%= primary_pet.name %></h2>
              </div>
            </div>

            <nav class="home-shortcut-list" aria-label="Разделы питомца">
              <%= link_to pet_pet_events_path(primary_pet) do %><span>Журнал</span><small>История и наблюдения</small><% end %>
              <%= link_to pet_reminders_path(primary_pet) do %><span>Напоминания</span><small>Что сделать дальше</small><% end %>
              <%= link_to pet_pet_documents_path(primary_pet) do %><span>Документы</span><small>Файлы и сроки</small><% end %>
              <%= link_to pet_pet_tag_path(primary_pet) do %><span>PetTag</span><small>Безопасность и QR</small><% end %>
              <%= link_to pet_profile_shares_path(primary_pet) do %><span>Доступ</span><small>Поделиться данными</small><% end %>
            </nav>
          </section>

          <section class="dashboard-section home-background-summary">
            <div class="text-muted small mb-2">В фоне</div>
            <div class="compact-list">
              <div><span>Документы со сроком</span><strong><%= @expiring_documents.size %></strong></div>
              <div><span>Сканирования PetTag</span><strong><%= @pet_tag_scans_count %></strong></div>
              <div><span>Активный доступ</span><strong><%= @active_profile_shares_count %></strong></div>
            </div>
          </section>
        </aside>
      </div>
    <% else %>
      <section class="empty-panel home-empty home-onboarding">
        <div>
          <div class="text-muted small mb-1">Первый шаг</div>
          <h2 class="h4 mb-2">Начнём с питомца</h2>
          <p class="text-muted mb-3">Добавьте имя и основные данные. После этого PetJournal предложит создать первую запись и напоминание.</p>
          <%= link_to "Добавить питомца", new_pet_path, class: "btn btn-primary" %>
        </div>
        <ol class="home-onboarding-steps" aria-label="Как начать пользоваться PetJournal">
          <li class="active"><span>1</span><div><strong>Питомец</strong><small>Создайте карточку</small></div></li>
          <li><span>2</span><div><strong>Первая запись</strong><small>Зафиксируйте важное</small></div></li>
          <li><span>3</span><div><strong>Напоминание</strong><small>Не держите всё в голове</small></div></li>
        </ol>
      </section>
    <% end %>
  </div>
<% else %>
  <%= render "guest_home" %>
<% end %>
