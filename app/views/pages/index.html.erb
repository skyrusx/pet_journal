<div class="py-5">
  <div class="mb-5">
    <h1 class="display-5 fw-semibold mb-3">PetJournal</h1>
    <p class="lead text-muted mb-4">
      Домашний журнал питомца: карточка, события, заметки и напоминания.
    </p>

    <div class="d-flex gap-2">
      <% if user_signed_in? %>
        <%= link_to "Перейти в приложение", "#", class: "btn btn-primary" %>
      <% else %>
        <%= link_to "Войти", new_user_session_path, class: "btn btn-primary" %>
        <%= link_to "Регистрация", new_user_registration_path, class: "btn btn-outline-secondary" %>
      <% end %>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-md-4">
      <div class="border rounded p-4 h-100 bg-white">
        <h2 class="h5 mb-3">Карточка питомца</h2>
        <p class="text-muted mb-0">
          Основная информация, фото и важные данные в одном месте.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="border rounded p-4 h-100 bg-white">
        <h2 class="h5 mb-3">Журнал событий</h2>
        <p class="text-muted mb-0">
          Прививки, приемы, вес, заметки и история питомца.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="border rounded p-4 h-100 bg-white">
        <h2 class="h5 mb-3">Напоминания</h2>
        <p class="text-muted mb-0">
          Ничего не забыть: обработки, лекарства и важные даты.
        </p>
      </div>
    </div>
  </div>
</div>
