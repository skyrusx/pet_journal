<% content_for :title, "PetJournal — здоровье, уход и безопасность питомца" %>
<% content_for :head do %>
  <meta name="description" content="Журнал здоровья питомца, документы, напоминания и QR-профиль PetTag — всё важное в одном месте.">
<% end %>

<div class="pj-landing pj-v2-landing">
  <header class="pj-v2-site-header" data-mobile-menu-root>
    <div class="pj-v2-shell pj-v2-header-inner">
      <button class="pj-v2-menu-toggle"
              type="button"
              aria-label="Открыть меню"
              aria-controls="landing-mobile-menu"
              aria-expanded="false"
              data-mobile-menu-open>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>

      <%= link_to root_path, class: "pj-v2-brand", aria: { label: "PetJournal — главная" } do %>
        <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", width: 166, height: 48 %>
      <% end %>

      <nav class="pj-v2-nav" aria-label="Основная навигация">
        <a href="#features">Возможности</a>
        <a href="#how-it-works">Как это работает</a>
        <a href="#pettag">PetTag</a>
      </nav>

      <div class="pj-v2-header-actions">
        <%= link_to "Войти", new_user_session_path, class: "pj-v2-login" %>
        <%= link_to "Создать журнал", new_user_registration_path, class: "pj-v2-button pj-v2-button-small" %>
      </div>

      <span class="pj-v2-mobile-spacer" aria-hidden="true"></span>
    </div>

    <div class="mobile-menu-backdrop pj-mobile-menu-backdrop" data-mobile-menu-backdrop hidden></div>
    <nav class="mobile-menu-panel pj-mobile-menu-panel pj-v2-mobile-menu"
         id="landing-mobile-menu"
         aria-label="Мобильная навигация"
         aria-hidden="true"
         hidden
         data-mobile-menu-panel>
      <div class="mobile-menu-header">
        <%= link_to root_path, class: "mobile-menu-brand", aria: { label: "PetJournal — главная" } do %>
          <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", width: 138, height: 40 %>
        <% end %>
        <button class="mobile-menu-close" type="button" aria-label="Закрыть меню" data-mobile-menu-close></button>
      </div>
      <div class="mobile-menu-links">
        <a href="#features" class="mobile-menu-link" data-mobile-menu-link>Возможности</a>
        <a href="#how-it-works" class="mobile-menu-link" data-mobile-menu-link>Как это работает</a>
        <a href="#pettag" class="mobile-menu-link" data-mobile-menu-link>PetTag</a>
        <div class="pj-v2-menu-auth-label">Уже есть аккаунт?</div>
        <%= link_to "Войти", new_user_session_path, class: "mobile-menu-link pj-v2-menu-login", data: { mobile_menu_link: true } %>
        <%= link_to "Создать журнал", new_user_registration_path, class: "mobile-menu-cta", data: { mobile_menu_link: true } %>
      </div>
    </nav>
  </header>

  <main class="pj-v2-main">
    <section class="pj-v2-shell pj-v2-hero" aria-labelledby="pj-v2-hero-title">
      <div class="pj-v2-hero-card">
        <div class="pj-v2-hero-copy">
          <span class="pj-v2-kicker">Забота. Память. Спокойствие.</span>
          <h1 id="pj-v2-hero-title">Все заботы о питомце<br>в одном месте</h1>
          <p>Журнал здоровья, напоминания, документы и PetTag — чтобы всё важное было рядом даже тогда, когда голова занята другим.</p>
          <div class="pj-v2-hero-actions">
            <%= link_to "Создать журнал", new_user_registration_path, class: "pj-v2-button" %>
            <a href="#features" class="pj-v2-button pj-v2-button-secondary">Узнать больше</a>
          </div>
        </div>

        <div class="pj-v2-hero-visual">
          <%= image_tag "petjournal/hero-composite.png",
                        alt: "PetJournal на телефоне рядом с питомцем",
                        width: 760,
                        height: 709 %>
        </div>

        <div class="pj-v2-hero-strip" aria-label="Основные возможности">
          <div><strong>Журнал</strong><span>история здоровья</span></div>
          <div><strong>Напоминания</strong><span>важное вовремя</span></div>
          <div><strong>Документы</strong><span>файлы и сроки</span></div>
          <div><strong>PetTag</strong><span>безопасность питомца</span></div>
        </div>
      </div>
    </section>

    <section class="pj-v2-shell pj-v2-benefits" id="features">
      <article>
        <span class="pj-v2-benefit-icon">♡</span>
        <div><h2>Здоровье под контролем</h2><p>История здоровья, прививки, анализы и осмотры в одном месте.</p></div>
      </article>
      <article>
        <span class="pj-v2-benefit-icon">◷</span>
        <div><h2>Ничего не забыть</h2><p>Напоминания о событиях и приёмах вовремя, без заметок по разным приложениям.</p></div>
      </article>
      <article>
        <span class="pj-v2-benefit-icon">◇</span>
        <div><h2>Безопасность с PetTag</h2><p>QR-профиль поможет связаться с вами, если питомец потеряется.</p></div>
      </article>
    </section>

    <section class="pj-v2-shell pj-v2-product" id="product">
      <div class="pj-v2-section-copy">
        <span class="pj-v2-kicker">Понятный ежедневный помощник</span>
        <h2>Видно только то, что действительно важно</h2>
        <p>PetJournal не превращает заботу в админку. Ближайшие события, питомцы и последние записи собраны компактно и читаются за несколько секунд.</p>
      </div>

      <div class="pj-v2-dashboard-preview" aria-label="Пример главного экрана PetJournal">
        <aside class="pj-v2-preview-nav">
          <strong>PetJournal</strong>
          <span class="active">⌂ Главная</span>
          <span>▤ Журнал</span>
          <span>◷ Напоминания</span>
          <span>▱ Документы</span>
          <span>◇ PetTag</span>
          <span>♙ Питомцы</span>
        </aside>
        <div class="pj-v2-preview-main">
          <div class="pj-v2-preview-title"><div><small>Сегодня и ближайшее</small><strong>Что важно сейчас</strong></div><span>Смотреть всё</span></div>
          <div class="pj-v2-preview-events">
            <article><b>◷</b><div><strong>Вакцинация</strong><small>Тор · сегодня, 11:00</small></div><span>›</span></article>
            <article><b>♡</b><div><strong>Осмотр у ветеринара</strong><small>Локи · завтра, 16:30</small></div><span>›</span></article>
            <article><b>▤</b><div><strong>Чистка ушей</strong><small>Рыжуля · 25 авг.</small></div><span>›</span></article>
          </div>

          <div class="pj-v2-preview-title pj-v2-preview-title-pets"><strong>Мои питомцы</strong></div>
          <div class="pj-v2-preview-pets">
            <% ["Тор", "Локи", "Рыжуля", "Фрея"].each_with_index do |name, index| %>
              <article><span><%= name.first %></span><strong><%= name %></strong><small><%= index.even? ? "Всё хорошо" : "Есть напоминание" %></small></article>
            <% end %>
          </div>
        </div>
      </div>
    </section>

    <section class="pj-v2-shell pj-v2-feature-grid">
      <article><span>▤</span><h2>Журнал здоровья</h2><p>Вес, симптомы, визиты, вакцинации, лекарства и заметки в единой хронологии.</p></article>
      <article><span>◷</span><h2>Напоминания</h2><p>Одноразовые и повторяющиеся задачи, чтобы следующий шаг не потерялся.</p></article>
      <article><span>▱</span><h2>Документы</h2><p>Ветпаспорт, анализы, назначения и другие файлы рядом с историей питомца.</p></article>
      <article><span>↗</span><h2>Доступ</h2><p>Делитесь только выбранными данными с ветеринаром, близкими или передержкой.</p></article>
      <article><span>♙</span><h2>Несколько питомцев</h2><p>Отдельная история и задачи для каждого питомца в одном аккаунте.</p></article>
      <article class="pj-v2-feature-accent"><span>◇</span><h2>PetTag</h2><p>Публичный QR-профиль для экстренного контакта без раскрытия лишних данных.</p></article>
    </section>

    <section class="pj-v2-shell pj-v2-steps" id="how-it-works">
      <div class="pj-v2-section-copy centered">
        <span class="pj-v2-kicker">Как это работает</span>
        <h2>Три простых шага</h2>
      </div>
      <div class="pj-v2-step-grid">
        <article><span>1</span><h3>Добавьте питомца</h3><p>Имя, вид, дата рождения и основные особенности.</p></article>
        <article><span>2</span><h3>Ведите историю</h3><p>Добавляйте события, документы и всё, что важно помнить.</p></article>
        <article><span>3</span><h3>Получайте напоминания</h3><p>PetJournal подскажет, что требует внимания дальше.</p></article>
      </div>
    </section>

    <section class="pj-v2-shell pj-v2-pettag" id="pettag">
      <div class="pj-v2-pettag-art">
        <%= image_tag "petjournal/auth-pettag.png",
                      alt: "Жетон PetTag",
                      width: 420,
                      height: 474,
                      loading: "lazy" %>
      </div>
      <div>
        <span class="pj-v2-kicker">PetTag</span>
        <h2>Спокойнее, если питомец потеряется</h2>
        <p>Человек сканирует QR-код и получает безопасную страницу питомца с теми данными, которые вы разрешили показать.</p>
        <ul>
          <li>Без установки приложения</li>
          <li>Контакты можно изменить в любой момент</li>
          <li>Есть режим пропажи и история сканирований</li>
        </ul>
        <%= link_to "Создать журнал", new_user_registration_path, class: "pj-v2-button" %>
      </div>
    </section>

    <section class="pj-v2-shell pj-v2-faq" id="faq">
      <div class="pj-v2-section-copy">
        <span class="pj-v2-kicker">Вопросы</span>
        <h2>Перед началом</h2>
      </div>
      <div class="pj-v2-faq-list">
        <details open><summary>PetJournal можно попробовать бесплатно?</summary><p>Да. Создать аккаунт и начать вести журнал можно без оплаты.</p></details>
        <details><summary>Можно добавить несколько питомцев?</summary><p>Да. У каждого будет своя карточка, журнал, документы, напоминания и PetTag.</p></details>
        <details><summary>Нужно устанавливать приложение?</summary><p>Нет. PetJournal работает в браузере на телефоне и компьютере.</p></details>
      </div>
    </section>

    <section class="pj-v2-shell pj-v2-final-cta">
      <div><span class="pj-v2-kicker">PetJournal</span><h2>Начните с одного питомца</h2><p>Добавить карточку и первую запись можно за несколько минут.</p></div>
      <%= link_to "Создать журнал", new_user_registration_path, class: "pj-v2-button" %>
    </section>
  </main>

  <footer class="pj-v2-footer">
    <div class="pj-v2-shell">
      <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", width: 142, height: 41 %>
      <span>© <%= Date.current.year %> PetJournal</span>
      <%= mail_to "support@pet-journal.ru", "Поддержка" %>
      <%= link_to "VK", "https://vk.ru/petjournal", target: "_blank", rel: "noopener" %>
    </div>
  </footer>
</div>
