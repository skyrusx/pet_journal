<footer class="pj-nd-footer" aria-label="Подвал PetJournal">
  <div class="pj-nd-shell">
    <div class="pj-nd-footer__panel">
      <div class="pj-nd-footer__top">
        <div class="pj-nd-footer__brand">
          <%= link_to root_path, class: "pj-nd-footer__brand-link", aria: { label: "PetJournal" } do %>
            <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", class: "pj-nd-footer__logo" %>
          <% end %>
          <p class="pj-nd-footer__tagline">Забота. Память. Спокойствие.</p>
        </div>

        <nav class="pj-nd-footer__column pj-nd-footer__nav" aria-label="Разделы сайта">
          <h3>Разделы</h3>
          <%= link_to "Возможности", root_path(anchor: "features") %>
          <%= link_to "Как это работает", root_path(anchor: "how-it-works") %>
          <%= link_to "Войти", new_user_session_path %>
          <%= link_to "Создать журнал", new_user_registration_path %>
        </nav>

        <div class="pj-nd-footer__column pj-nd-footer__support">
          <h3>Поддержка</h3>
          <a href="mailto:support@pet-journal.ru">support@pet-journal.ru</a>
          <p>Мы рядом, если нужна помощь</p>
        </div>

        <div class="pj-nd-footer__column pj-nd-footer__social">
          <h3>Мы в соцсетях</h3>
          <a class="pj-nd-footer__vk" href="https://vk.ru/petjournal" target="_blank" rel="noopener noreferrer" aria-label="PetJournal во ВКонтакте">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m9.489.004.729-.003h3.564l.73.003.914.01.433.007.418.011.403.014.388.016.374.021.36.025.345.03.333.033c1.74.196 2.933.616 3.833 1.516.9.9 1.32 2.092 1.516 3.833l.034.333.029.346.025.36.02.373.025.588.012.41.013.644.009.915.004.98-.001 3.313-.003.73-.01.914-.007.433-.011.418-.014.403-.016.388-.021.374-.025.36-.03.345-.033.333c-.196 1.74-.616 2.933-1.516 3.833-.9.9-2.092 1.32-3.833 1.516l-.333.034-.346.029-.36.025-.373.02-.588.025-.41.012-.644.013-.915.009-.98.004-3.313-.001-.73-.003-.914-.01-.433-.007-.418-.011-.403-.014-.388-.016-.374-.021-.36-.025-.345-.03-.333-.033c-1.74-.196-2.933-.616-3.833-1.516-.9-.9-1.32-2.092-1.516-3.833l-.034-.333-.029-.346-.025-.36-.02-.373-.025-.588-.012-.41-.013-.644-.009-.915-.004-.98.001-3.313.003-.73.01-.914.007-.433.011-.418.014-.403.016-.388.021-.374.025-.36.03-.345.033-.333c.196-1.74.616-2.933 1.516-3.833.9-.9 2.092-1.32 3.833-1.516l.333-.034.346-.029.36-.025.373-.02.588-.025.41-.012.644-.013.915-.009.98-.004ZM6.79 7.3H4.05c.13 6.24 3.25 9.99 8.72 9.99h.31v-3.57c2.01.2 3.53 1.67 4.14 3.57h2.84c-.78-2.84-2.83-4.41-4.11-5.01 1.28-.74 3.08-2.54 3.51-4.98h-2.58c-.56 1.98-2.22 3.78-3.8 3.95V7.3H10.5v6.92c-1.6-.4-3.62-2.34-3.71-6.92Z"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="pj-nd-footer__bottom">
        <p>© <%= Time.current.year %> PetJournal.</p>
        <nav class="pj-nd-footer__legal" aria-label="Юридические документы">
          <%= legal_link :privacy %>
          <span aria-hidden="true">·</span>
          <%= legal_link :personal_data_consent %>
        </nav>
        <p class="pj-nd-footer__made-with-care">Сделано с заботой о тех, кто рядом ♡</p>
      </div>
    </div>
  </div>
</footer>
