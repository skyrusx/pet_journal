<% brand_path = local_assigns.fetch(:brand_path, new_design_path) %>
<% features_path = local_assigns.fetch(:features_path, "#features") %>
<% how_it_works_path = local_assigns.fetch(:how_it_works_path, "#how-it-works") %>

<header class="pj-nd-navbar">
  <div class="pj-nd-shell pj-nd-navbar__inner">
    <%= link_to brand_path, class: "pj-nd-navbar__brand", aria: { label: "PetJournal — новый дизайн" } do %>
      <%= image_tag "petjournal/logo-horizontal.png", alt: "PetJournal", class: "pj-nd-navbar__logo" %>
    <% end %>

    <nav class="pj-nd-navbar__nav" aria-label="Основная навигация">
      <%= link_to "Возможности", features_path %>
      <%= link_to "Как это работает", how_it_works_path %>
    </nav>

    <div class="pj-nd-navbar__actions">
      <%= link_to "Войти", new_user_session_path, class: "pj-nd-navbar__login" %>
      <%= link_to "Создать журнал", new_user_registration_path, class: "pj-nd-navbar__cta" %>
    </div>

    <details class="pj-nd-navbar__mobile">
      <summary aria-label="Открыть меню">
        <span class="pj-nd-navbar__burger" aria-hidden="true"><span></span></span>
      </summary>

      <div class="pj-nd-navbar__mobile-panel">
        <div class="pj-nd-navbar__mobile-card">
          <nav class="pj-nd-navbar__mobile-nav" aria-label="Мобильная навигация">
            <%= link_to "Возможности", features_path %>
            <%= link_to "Как это работает", how_it_works_path %>
          </nav>

          <div class="pj-nd-navbar__mobile-separator" aria-hidden="true"></div>

          <div class="pj-nd-navbar__mobile-actions">
            <%= link_to "Войти", new_user_session_path, class: "pj-nd-navbar__mobile-login" %>
            <%= link_to "Создать журнал", new_user_registration_path, class: "pj-nd-navbar__mobile-cta" %>
          </div>
        </div>
      </div>
    </details>
  </div>
</header>
