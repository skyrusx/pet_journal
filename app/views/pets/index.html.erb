<% content_for :title, "Питомцы — PetJournal" %>
<% account_name = current_user.name.presence || current_user.email.to_s.split("@").first.presence || "Аккаунт" %>

<div class="pj-pets-page pj-pets-page--index">
  <header class="pj-workspace-topbar">
    <h1>Питомцы</h1>
    <div class="pj-workspace-topbar__actions">
      <%= link_to(@pets.first ? pet_reminders_path(@pets.first) : pets_path, class: "pj-workspace-icon", aria: { label: "Напоминания" }) do %>
        <%= pj_icon(:bell) %>
      <% end %>
      <%= link_to edit_user_registration_path, class: "pj-workspace-avatar", aria: { label: "Профиль" } do %>
        <%= account_name.to_s.first.to_s.upcase %>
      <% end %>
    </div>
  </header>

  <div class="pj-pets-content">
    <div class="pj-pets-heading">
      <div>
        <p>Все ваши питомцы в одном месте</p>
      </div>
      <%= link_to new_pet_path, class: "pj-pets-primary-button" do %>
        <%= pj_icon(:plus) %><span>Добавить питомца</span>
      <% end %>
    </div>

    <% if @pets.any? %>
      <div class="pj-pets-grid">
        <% @pets.each do |pet| %>
          <% pet_tag = pet.pet_tag %>
          <% tag_active = pet_tag&.persisted? && pet_tag.enabled? %>
          <%= link_to pet_path(pet), class: "pj-pet-list-card" do %>
            <span class="pj-pet-list-card__photo">
              <% if pet.photo.attached? %>
                <%= image_tag pet.photo, alt: pet.name, loading: "lazy" %>
              <% else %>
                <span class="pj-pet-list-card__placeholder"><%= pet.name.to_s.first.to_s.upcase.presence || "P" %></span>
              <% end %>
            </span>

            <span class="pj-pet-list-card__body">
              <strong class="pj-pet-list-card__name"><%= pet.name %></strong>
              <span class="pj-pet-list-card__breed"><%= pet.breed.presence || pet.species.presence || "Данные не заполнены" %></span>
              <span class="pj-pet-list-card__age"><%= pet_age(pet) %></span>
              <span class="pj-pet-list-card__tag <%= "is-muted" unless tag_active %>">
                <span class="pj-pet-list-card__tag-dot">●</span>
                PetTag <%= tag_active ? pet_tag_status_label(pet_tag).downcase : "не настроен" %>
              </span>
            </span>

            <span class="pj-pet-list-card__chevron"><%= pj_icon(:chevron) %></span>
          <% end %>
        <% end %>

        <%= link_to new_pet_path, class: "pj-pet-list-add" do %>
          <span class="pj-pet-list-add__plus"><%= pj_icon(:plus) %></span>
          <span>Добавить<br>питомца</span>
        <% end %>
      </div>
    <% else %>
      <section class="pj-pets-empty">
        <span class="pj-pets-empty__icon"><%= pj_icon(:paw) %></span>
        <h2>Добавьте первого питомца</h2>
        <p>Начните с имени и фото. Остальные данные можно заполнить позже.</p>
        <%= link_to "Добавить питомца", new_pet_path, class: "pj-pets-primary-button" %>
      </section>
    <% end %>
  </div>
</div>
