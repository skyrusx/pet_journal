<div class="py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Мои питомцы</h1>
    <%= link_to "Добавить питомца", new_pet_path, class: "btn btn-primary" %>
  </div>

  <% if @pets.any? %>
    <div class="row g-3">
      <% @pets.each do |pet| %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
              <h2 class="h5 card-title mb-3"><%= pet.name %></h2>

              <p class="text-muted mb-1">Вид: <%= pet.species.presence || "—" %></p>
              <p class="text-muted mb-1">Порода: <%= pet.breed.presence || "—" %></p>
              <p class="text-muted mb-0">Вес: <%= pet.weight.presence || "—" %></p>
            </div>

            <div class="card-footer bg-white border-0 pt-0 d-flex gap-2 flex-wrap">
              <%= link_to "Открыть", pet_path(pet), class: "btn btn-outline-primary btn-sm" %>
              <%= link_to "Журнал", pet_pet_events_path(pet), class: "btn btn-outline-secondary btn-sm" %>
              <%= link_to "Редактировать", edit_pet_path(pet), class: "btn btn-outline-secondary btn-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-light border">
      У вас пока нет питомцев.
    </div>
  <% end %>
</div>
