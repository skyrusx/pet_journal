<% all_photos = pet.pet_photos.with_attached_image.ordered.to_a %>
<% photos = all_photos.reject(&:is_primary?) %>
<% gallery_full = all_photos.size >= PetPhoto::MAX_PHOTOS_PER_PET %>

<% if pet.persisted? %>
  <section class="pj-pet-gallery-editor"
           data-pet-gallery-editor
           data-reorder-url="<%= reorder_pet_pet_photos_path(pet) %>">
    <div class="pj-pet-gallery-editor__heading">
      <div>
        <span class="pj-pet-gallery-editor__eyebrow">Галерея</span>
        <h2>Фотографии питомца</h2>
        <p>Добавляйте дополнительные фотографии и меняйте их порядок перетаскиванием.</p>
      </div>

      <div class="pj-pet-gallery-editor__heading-actions">
        <span class="pj-pet-gallery-editor__count"><%= pet_gallery_photo_count_label(photos.size) %></span>

        <label class="pj-pets-primary-button pj-pet-gallery-editor__add <%= "is-disabled" if gallery_full %>"
               aria-disabled="<%= gallery_full %>">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          <span>Добавить фото</span>
          <%= file_field_tag "images[]",
                             multiple: true,
                             accept: "image/png,image/jpeg,image/webp",
                             disabled: gallery_full,
                             class: "pj-pet-gallery-editor__file-input",
                             data: {
                               pet_gallery_direct_upload: true,
                               upload_url: pet_pet_photos_path(pet),
                               max_count: PetPhoto::MAX_PHOTOS_PER_PET,
                               existing_count: all_photos.size,
                               max_bytes: PetPhoto::MAX_FILE_SIZE
                             } %>
        </label>
      </div>
    </div>

    <% if photos.any? %>
      <div class="pj-pet-gallery-editor__grid" data-pet-gallery-sort-list>
        <% photos.each do |photo| %>
          <article class="pj-pet-gallery-card" data-pet-gallery-card data-photo-id="<%= photo.id %>">
            <div class="pj-pet-gallery-card__image-wrap"
                 data-pet-gallery-sort-handle
                 aria-label="Перетащить фотографию для изменения порядка">
              <%= image_tag photo.image.variant(resize_to_fill: [520, 520]),
                            alt: "Фото #{pet.name}",
                            loading: "lazy",
                            class: "pj-pet-gallery-card__image" %>
            </div>

            <div class="pj-pet-gallery-card__actions">
              <button type="button"
                      class="pj-pet-gallery-card__action pj-pet-gallery-card__action--icon pj-pet-gallery-card__action--star"
                      data-pet-crop-trigger
                      data-mode="primary"
                      data-url="<%= primary_pet_pet_photo_path(pet, photo) %>"
                      data-photo-src="<%= url_for(photo.image.variant(resize_to_limit: [1800, 1800])) %>"
                      data-crop-x="<%= photo.avatar_crop_x %>"
                      data-crop-y="<%= photo.avatar_crop_y %>"
                      data-crop-width="<%= photo.avatar_crop_width %>"
                      data-crop-height="<%= photo.avatar_crop_height %>"
                      aria-label="Использовать как фото профиля"
                      title="Использовать как фото профиля">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m12 3.8 2.45 4.96 5.47.8-3.96 3.85.94 5.44L12 16.28l-4.9 2.57.94-5.44-3.96-3.85 5.47-.8L12 3.8Z"/>
                </svg>
              </button>

              <button type="button"
                      class="pj-pet-gallery-card__delete"
                      data-pet-gallery-delete
                      data-url="<%= pet_pet_photo_path(pet, photo) %>"
                      data-confirm="Удалить эту фотографию? Исходный файл будет удалён из галереи."
                      aria-label="Удалить фотографию"
                      title="Удалить фотографию">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/>
                </svg>
              </button>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="pj-pet-gallery-editor__empty">
        <strong>В галерее пока нет фотографий</strong>
        <span>Нажмите «Добавить фото», чтобы добавить дополнительные снимки питомца.</span>
      </div>
    <% end %>

    <p class="pj-pet-gallery-editor__status" data-pet-gallery-status aria-live="polite">
      <%= "Достигнут лимит — #{PetPhoto::MAX_PHOTOS_PER_PET} фотографий." if gallery_full %>
    </p>
  </section>

  <%= render "pets/photo_crop_modal" if all_photos.any? %>
<% end %>
