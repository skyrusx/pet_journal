<% content_for :title, "Добавить питомца — PetJournal" %>

<div class="pj-pets-page pj-pet-form-page">
  <header class="pj-workspace-topbar pj-workspace-topbar--form">
    <%= link_to pets_path, class: "pj-workspace-back" do %>
      <%= pj_icon(:chevron) %><span>К списку питомцев</span>
    <% end %>
    <%= link_to(@pet.persisted? ? pet_path(@pet) : pets_path, class: "pj-workspace-avatar", aria: { label: "Питомцы" }) do %>
      <%= pj_icon(:paw) %>
    <% end %>
  </header>

  <div class="pj-pets-content pj-pet-form-content">
    <div class="pj-mobile-detail-nav pj-mobile-form-nav">
      <%= link_to pets_path, class: "pj-mobile-context-back" do %>
        <%= pj_icon(:chevron) %><span>К питомцам</span>
      <% end %>
    </div>

    <div class="pj-pet-form-heading">
      <h1>Добавить питомца</h1>
      <p>Заполните основные данные. Дополнительную информацию можно добавить позже.</p>
    </div>

    <%= render "form" %>
  </div>
</div>
