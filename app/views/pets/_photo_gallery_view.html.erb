<% primary_photo = pet.primary_photo %>

<% if primary_photo&.image&.attached? %>
  <button type="button"
          class="pj-pet-profile-lightbox-trigger"
          data-pet-profile-lightbox-trigger
          data-src="<%= url_for(primary_photo.image.variant(resize_to_limit: [2000, 2000])) %>"
          data-alt="Фото <%= pet.name %>"
          tabindex="-1"
          aria-hidden="true"
          hidden></button>

  <div class="pj-pet-lightbox" data-pet-profile-lightbox hidden aria-hidden="true">
    <div class="pj-pet-lightbox__backdrop" data-pet-profile-lightbox-close></div>
    <section class="pj-pet-lightbox__dialog pj-pet-lightbox__dialog--single"
             role="dialog"
             aria-modal="true"
             aria-label="Фото питомца"
             tabindex="-1">
      <button type="button"
              class="pj-pet-lightbox__close"
              data-pet-profile-lightbox-close
              aria-label="Закрыть">×</button>
      <div class="pj-pet-lightbox__stage">
        <img alt="" data-pet-profile-lightbox-image draggable="false">
      </div>
    </section>
  </div>
<% end %>

<% if photos.any? %>
  <section class="pj-pet-gallery-view" aria-labelledby="pet-gallery-title">
    <div class="pj-pet-gallery-view__heading">
      <div>
        <span>Галерея</span>
        <h2 id="pet-gallery-title">Фотографии <%= pet.name %></h2>
      </div>
      <span><%= pet_gallery_photo_count_label(photos.size) %></span>
    </div>

    <div class="pj-pet-gallery-view__grid">
      <% photos.each_with_index do |photo, index| %>
        <button type="button"
                class="pj-pet-gallery-view__item"
                data-pet-lightbox-open
                data-index="<%= index %>"
                data-src="<%= url_for(photo.image.variant(resize_to_limit: [1800, 1800])) %>"
                data-alt="Фото <%= pet.name %>, <%= index + 1 %> из <%= photos.size %>"
                aria-label="Открыть фотографию <%= index + 1 %> из <%= photos.size %>">
          <%= image_tag photo.image.variant(resize_to_fill: [620, 620]), alt: "", loading: "lazy" %>
          <span class="pj-photo-zoom-overlay" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <circle cx="10.5" cy="10.5" r="5.5"/>
              <path d="m15 15 4.5 4.5"/>
            </svg>
          </span>
        </button>
      <% end %>
    </div>

    <div class="pj-pet-lightbox" data-pet-lightbox hidden aria-hidden="true">
      <div class="pj-pet-lightbox__backdrop" data-pet-lightbox-close></div>
      <section class="pj-pet-lightbox__dialog"
               role="dialog"
               aria-modal="true"
               aria-label="Галерея питомца"
               tabindex="-1">
        <button type="button" class="pj-pet-lightbox__close" data-pet-lightbox-close aria-label="Закрыть">×</button>
        <% if photos.many? %>
          <button type="button" class="pj-pet-lightbox__nav is-prev" data-pet-lightbox-prev aria-label="Предыдущая фотография">‹</button>
        <% end %>
        <div class="pj-pet-lightbox__stage" data-pet-lightbox-stage>
          <img alt="" data-pet-lightbox-image draggable="false">
        </div>
        <% if photos.many? %>
          <button type="button" class="pj-pet-lightbox__nav is-next" data-pet-lightbox-next aria-label="Следующая фотография">›</button>
        <% end %>
        <div class="pj-pet-lightbox__counter" data-pet-lightbox-counter></div>
      </section>
    </div>
  </section>
<% end %>
