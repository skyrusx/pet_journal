<%= form_with model: @pet, local: true, class: "pj-pet-form" do |f| %>
  <% if @pet.errors.any? %>
    <div class="pj-pet-form__errors" role="alert">
      <strong>Проверьте форму</strong>
      <span><%= @pet.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <div class="pj-pet-form__grid">
    <div class="pj-pet-form__photo-column">
      <label class="pj-pet-form__label">Фото питомца</label>
      <label class="pj-pet-photo-upload">
        <% if @pet.photo.attached? %>
          <%= image_tag @pet.photo, alt: @pet.name.presence || "Фото питомца", class: "pj-pet-photo-upload__preview" %>
          <span class="pj-pet-photo-upload__change"><%= pj_icon(:plus) %></span>
        <% else %>
          <span class="pj-pet-photo-upload__icon">☁</span>
          <strong>Загрузить фото</strong>
          <small>PNG, JPG до 5 МБ</small>
        <% end %>
        <%= f.file_field :photo, accept: "image/png,image/jpeg,image/webp", class: "pj-pet-photo-upload__input" %>
      </label>
    </div>

    <div class="pj-pet-form__fields">
      <div class="pj-pet-field">
        <%= f.label :name, class: "pj-pet-form__label" do %>Кличка <span>*</span><% end %>
        <%= f.text_field :name, class: "pj-pet-form__control", placeholder: "Введите кличку", autocomplete: "off", required: true %>
      </div>

      <div class="pj-pet-field">
        <%= f.label :species, class: "pj-pet-form__label" do %>Вид животного <span>*</span><% end %>
        <%= f.text_field :species,
                         class: "pj-pet-form__control",
                         placeholder: "Например, Собака",
                         list: "pet-species-options",
                         required: true %>
        <datalist id="pet-species-options">
          <option value="Собака"></option>
          <option value="Кошка"></option>
          <option value="Кролик"></option>
          <option value="Птица"></option>
          <option value="Грызун"></option>
          <option value="Рептилия"></option>
        </datalist>
      </div>

      <div class="pj-pet-field pj-pet-field--wide">
        <%= f.label :breed, "Порода", class: "pj-pet-form__label" %>
        <%= f.text_field :breed, class: "pj-pet-form__control", placeholder: "Введите породу" %>
      </div>

      <div class="pj-pet-field">
        <%= f.label :birth_date, "Дата рождения", class: "pj-pet-form__label" %>
        <%= f.date_field :birth_date, class: "pj-pet-form__control" %>
      </div>

      <div class="pj-pet-field">
        <span class="pj-pet-form__label">Пол</span>
        <div class="pj-pet-sex-toggle">
          <label class="<%= "is-selected" if @pet.sex == 0 %>">
            <%= f.radio_button :sex, 0 %><span>Самец</span>
          </label>
          <label class="<%= "is-selected" if @pet.sex == 1 %>">
            <%= f.radio_button :sex, 1 %><span>Самка</span>
          </label>
        </div>
      </div>

      <div class="pj-pet-field pj-pet-field--weight">
        <%= f.label :weight, "Вес", class: "pj-pet-form__label" %>
        <div class="pj-pet-weight-control">
          <%= f.number_field :weight, step: 0.01, min: 0, class: "pj-pet-form__control", placeholder: "0" %>
          <span>кг</span>
        </div>
      </div>

      <div class="pj-pet-field pj-pet-field--wide">
        <%= f.label :notes, "Особые приметы", class: "pj-pet-form__label" %>
        <%= f.text_area :notes,
                        rows: 3,
                        class: "pj-pet-form__control pj-pet-form__textarea",
                        placeholder: "Например: белое пятно на груди, шрам на правом ухе..." %>
      </div>
    </div>
  </div>

  <details class="pj-pet-form__extra" <%= "open" if @pet.persisted? && [@pet.color, @pet.chip_number, @pet.passport_number].any?(&:present?) %>>
    <summary>Дополнительные данные</summary>
    <p>Сохраняем текущие возможности карточки: окрас, чип, ветпаспорт и стерилизацию.</p>
    <div class="pj-pet-form__extra-grid">
      <div class="pj-pet-field">
        <%= f.label :color, "Окрас", class: "pj-pet-form__label" %>
        <%= f.text_field :color, class: "pj-pet-form__control", placeholder: "Например, рыжий" %>
      </div>
      <div class="pj-pet-field">
        <%= f.label :chip_number, "Номер чипа", class: "pj-pet-form__label" %>
        <%= f.text_field :chip_number, class: "pj-pet-form__control" %>
      </div>
      <div class="pj-pet-field">
        <%= f.label :passport_number, "Номер ветпаспорта", class: "pj-pet-form__label" %>
        <%= f.text_field :passport_number, class: "pj-pet-form__control" %>
      </div>
      <label class="pj-pet-neutered-control">
        <%= f.check_box :neutered %>
        <span><strong>Стерилизован / кастрирован</strong><small>Можно изменить в любой момент</small></span>
      </label>
    </div>
  </details>

  <div class="pj-pet-form__actions">
    <%= link_to(@pet.persisted? ? pet_path(@pet) : pets_path, class: "pj-pet-secondary-button") do %>Отмена<% end %>
    <%= f.submit(@pet.persisted? ? "Сохранить изменения" : "Сохранить", class: "pj-pets-primary-button") %>
  </div>
<% end %>
