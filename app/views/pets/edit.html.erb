<% content_for :title, "Редактировать #{@pet.name} — PetJournal" %>

<div class="pj-pets-page pj-pet-form-page">
  <header class="pj-workspace-topbar pj-workspace-topbar--form">
    <%= link_to pet_path(@pet), class: "pj-workspace-back" do %>
      <%= pj_icon(:chevron) %><span>К профилю питомца</span>
    <% end %>
  </header>

  <div class="pj-pets-content pj-pet-form-content">
    <div class="pj-mobile-detail-nav pj-mobile-form-nav">
      <%= link_to pet_path(@pet), class: "pj-mobile-context-back" do %>
        <%= pj_icon(:chevron) %><span>К профилю</span>
      <% end %>
    </div>

    <div class="pj-pet-form-heading">
      <h1>Редактировать питомца</h1>
      <p>Обновите данные <%= @pet.name %>. Изменения сразу появятся в профиле.</p>
    </div>

    <%= render "form" %>
  </div>
</div>
