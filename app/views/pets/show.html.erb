<% content_for :title, "#{@pet.name} — PetJournal" %>
<% latest_event = @recent_events.first %>
<% tag_label = pet_tag_status_label(@pet_tag) %>
<% tag_active = @pet_tag&.persisted? && @pet_tag.enabled? %>

<div class="pj-pets-page pj-pet-profile-page">
  <header class="pj-workspace-topbar pj-workspace-topbar--profile">
    <%= link_to pets_path, class: "pj-workspace-back" do %>
      <%= pj_icon(:chevron) %><span>К списку питомцев</span>
    <% end %>

    <div class="pj-desktop-detail-actions" aria-label="Действия с питомцем">
      <%= link_to edit_pet_path(@pet),
                  class: "pj-desktop-detail-action",
                  aria: { label: "Редактировать питомца" },
                  title: "Редактировать" do %>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4.5 19.5 5.7 15l9.9-9.9a2.15 2.15 0 0 1 3 0l.3.3a2.15 2.15 0 0 1 0 3L9 18.3l-4.5 1.2Z"/>
          <path d="m14.3 6.4 3.3 3.3"/>
        </svg>
      <% end %>
    </div>
  </header>

  <div class="pj-pets-content pj-pet-profile-content">
    <div class="pj-mobile-detail-nav">
      <%= link_to pets_path, class: "pj-mobile-context-back" do %>
        <%= pj_icon(:chevron) %><span>К питомцам</span>
      <% end %>

      <div class="pj-mobile-detail-actions" aria-label="Действия с питомцем">
        <%= link_to edit_pet_path(@pet),
                    class: "pj-mobile-detail-action",
                    aria: { label: "Редактировать питомца" },
                    title: "Редактировать" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.5 19.5 5.7 15l9.9-9.9a2.15 2.15 0 0 1 3 0l.3.3a2.15 2.15 0 0 1 0 3L9 18.3l-4.5 1.2Z"/>
            <path d="m14.3 6.4 3.3 3.3"/>
          </svg>
        <% end %>
      </div>
    </div>

    <div class="pj-pet-profile-layout">
      <section class="pj-pet-profile-main">
        <div class="pj-pet-profile-hero">
          <span class="pj-pet-profile-avatar">
            <% if @pet.photo.attached? %>
              <%= image_tag @pet.photo, alt: @pet.name %>
            <% else %>
              <span><%= @pet.name.to_s.first.to_s.upcase.presence || "P" %></span>
            <% end %>
          </span>

          <div class="pj-pet-profile-identity">
            <div class="pj-pet-profile-name-row">
              <h1><%= @pet.name %></h1>
            </div>
            <span class="pj-pet-profile-tag <%= "is-muted" unless tag_active %>">
              <span>●</span> PetTag <%= tag_label.downcase %>
            </span>
          </div>
        </div>

        <dl class="pj-pet-profile-details">
          <div><dt>Вид</dt><dd><%= @pet.species.presence || "—" %></dd></div>
          <div><dt>Пол</dt><dd><%= pet_sex_label(@pet) %></dd></div>
          <div><dt>Порода</dt><dd><%= @pet.breed.presence || "—" %></dd></div>
          <div><dt>Возраст</dt><dd><%= pet_age(@pet) %></dd></div>
          <div><dt>Дата рождения</dt><dd><%= @pet.birth_date.present? ? @pet.birth_date.strftime("%d.%m.%Y") : "—" %></dd></div>
          <div><dt>Вес</dt><dd><%= pet_weight_label(@pet.weight) %></dd></div>
        </dl>

        <details class="pj-pet-extra-details" open>
          <summary>Дополнительные данные</summary>
          <div class="pj-pet-extra-details__grid">
            <div><span>Окрас</span><strong><%= @pet.color.presence || "—" %></strong></div>
            <div><span>Номер чипа</span><strong><%= @pet.chip_number.presence || "—" %></strong></div>
            <div><span>Ветпаспорт</span><strong><%= @pet.passport_number.presence || "—" %></strong></div>
            <div><span>Стерилизация</span><strong><%= @pet.neutered.nil? ? "—" : (@pet.neutered ? "Да" : "Нет") %></strong></div>
          </div>
          <% if @pet.notes.present? %>
            <div class="pj-pet-extra-details__notes"><span>Особые приметы и заметки</span><p><%= simple_format(@pet.notes) %></p></div>
          <% end %>
        </details>
      </section>

      <aside class="pj-pet-profile-side">
        <article class="pj-pet-summary-card">
          <div class="pj-pet-summary-card__label">Ближайшее действие</div>
          <% if @next_reminder.present? %>
            <div class="pj-pet-summary-card__row">
              <span class="pj-pet-summary-card__icon"><%= pj_icon(:bell) %></span>
              <div>
                <strong><%= @next_reminder.title %></strong>
                <small><%= @next_reminder.next_run_at.strftime("%d.%m.%Y, %H:%M") %></small>
              </div>
            </div>
            <span class="pj-pet-summary-status <%= "is-danger" if @next_reminder.overdue? %>"><%= @next_reminder.overdue? ? "Просрочено" : "Запланировано" %></span>
            <%= link_to "Перейти к напоминаниям", pet_reminders_path(@pet), class: "pj-pet-summary-card__button" %>
          <% else %>
            <div class="pj-pet-summary-card__empty">Ничего не запланировано</div>
            <%= link_to "Добавить напоминание", new_pet_reminder_path(@pet), class: "pj-pet-summary-card__button" %>
          <% end %>
        </article>

        <article class="pj-pet-summary-card">
          <div class="pj-pet-summary-card__label">Последнее событие</div>
          <% if latest_event.present? %>
            <div class="pj-pet-summary-card__row">
              <span class="pj-pet-summary-card__icon"><%= pj_icon(:journal) %></span>
              <div>
                <div class="pj-pet-summary-card__title-line">
                  <strong><%= latest_event.title.presence || latest_event.event_type_label %></strong>
                  <span class="pj-pet-summary-status pj-pet-summary-status--inline">В журнале</span>
                </div>
                <small><%= latest_event.event_date.strftime("%d.%m.%Y") %></small>
              </div>
            </div>
            <%= link_to "Открыть журнал", pet_pet_events_path(@pet), class: "pj-pet-summary-card__button pj-pet-summary-card__button--compact" %>
          <% else %>
            <div class="pj-pet-summary-card__empty">Событий пока нет</div>
            <%= link_to "Добавить запись", new_pet_pet_event_path(@pet), class: "pj-pet-summary-card__button" %>
          <% end %>
        </article>
      </aside>
    </div>

    <section class="pj-pet-quick-section">
      <h2>Быстрые разделы</h2>
      <div class="pj-pet-quick-grid">
        <%= link_to pet_pet_events_path(@pet), class: "pj-pet-quick-card" do %>
          <span><%= pj_icon(:journal) %></span><strong>Журнал</strong><small><%= @events_count %> <%= russian_plural(@events_count, "запись", "записи", "записей") %></small>
        <% end %>
        <%= link_to pet_reminders_path(@pet), class: "pj-pet-quick-card" do %>
          <span><%= pj_icon(:bell) %></span><strong>Напоминания</strong><small><%= @active_reminders_count %> активно</small>
        <% end %>
        <%= link_to pet_pet_documents_path(@pet), class: "pj-pet-quick-card" do %>
          <span><%= pj_icon(:file) %></span><strong>Документы</strong><small><%= @documents_count %> <%= russian_plural(@documents_count, "файл", "файла", "файлов") %></small>
        <% end %>
        <%= link_to pet_pet_tag_path(@pet), class: "pj-pet-quick-card" do %>
          <span><%= pj_icon(:tag) %></span><strong>PetTag</strong><small><%= tag_label %></small>
        <% end %>
        <%= link_to pet_profile_shares_path(@pet), class: "pj-pet-quick-card" do %>
          <span><%= pj_icon(:user) %></span><strong>Доступ</strong><small><%= @active_profile_shares_count %> активно</small>
        <% end %>
      </div>
    </section>
  </div>
</div>