<% content_for :title, "Добавить канал — PetJournal" %>

<div class="pj-notifications-page pj-notifications-form-page">
  <header class="pj-workspace-topbar">
    <%= link_to notification_channels_path, class: "pj-workspace-icon pj-notifications-back", aria: { label: "Назад к уведомлениям" }, title: "Назад" do %>
      <span aria-hidden="true">←</span>
    <% end %>
    <h1>Добавить канал</h1>
  </header>

  <div class="pj-notifications-form-content">
    <div class="pj-notifications-form-heading">
      <span class="pj-notifications-eyebrow">Уведомления</span>
      <h1>Добавление канала</h1>
      <p>Подключите Email, Telegram или VK. Push для текущего устройства включается на странице уведомлений.</p>
    </div>

    <%= render "form", channel: @channel %>
  </div>
</div>
