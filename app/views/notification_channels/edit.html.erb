<% content_for :title, "Редактировать канал — PetJournal" %>

<div class="pj-notifications-page pj-notifications-form-page">
  <header class="pj-workspace-topbar pj-workspace-topbar--form">
    <%= link_to notification_channels_path, class: "pj-workspace-back" do %>
      <%= pj_icon(:chevron) %><span>Назад к уведомлениям</span>
    <% end %>
  </header>

  <div class="pj-notifications-form-content">
    <div class="pj-mobile-detail-nav pj-mobile-form-nav">
      <%= link_to notification_channels_path, class: "pj-mobile-context-back" do %>
        <%= pj_icon(:chevron) %><span>К уведомлениям</span>
      <% end %>
    </div>

    <div class="pj-notifications-form-heading">
      <h1><%= @channel.name %></h1>
      <p>Измените название, получателя или временно отключите этот способ доставки.</p>
    </div>

    <%= render "form", channel: @channel %>
  </div>
</div>
