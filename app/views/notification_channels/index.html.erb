<div class="notifications-page py-4">
  <section class="journal-workspace-hero notification-hero mb-4">
    <div class="journal-hero-main">
      <div>
        <div class="text-muted small mb-1">Настройки</div>
        <h1 class="h3 mb-2">Уведомления</h1>
        <p class="text-muted mb-0">Каналы доставки для напоминаний: эл. почта, Telegram, VK и браузерные push-уведомления.</p>
      </div>

      <div class="journal-metrics notification-hero-stats">
        <div>
          <span><%= @channels.count %></span>
          <small>каналов</small>
        </div>
        <div>
          <span><%= @channels.count(&:enabled?) %></span>
          <small>включено</small>
        </div>
      </div>
    </div>

    <div class="journal-quick-actions">
      <%= link_to "Добавить канал", new_notification_channel_path, class: "btn btn-primary" %>
    </div>
  </section>

  <div class="row g-4">
    <section class="col-lg-8">
      <div class="workspace-section">
        <div class="section-heading">
          <div>
            <div class="text-muted small mb-1">Доставка</div>
            <h2 class="h4 mb-0">Подключенные каналы</h2>
          </div>
        </div>

        <% if @channels.any? %>
          <div class="channel-grid">
            <% @channels.each do |channel| %>
              <article class="channel-card">
                <div class="d-flex justify-content-between gap-3 align-items-start mb-3">
                  <div>
                    <div class="text-muted small mb-1"><%= channel.channel_type_label %></div>
                    <h3 class="h5 mb-1"><%= channel.name %></h3>
                    <p class="text-muted mb-0"><%= channel.channel_web_push? ? "Браузерная подписка" : channel.address %></p>
                    <p class="<%= channel.ready_for_delivery? ? "text-muted" : "text-danger" %> small mt-2 mb-0">
                      <%= notification_channel_configuration_label(channel) %>
                    </p>
                  </div>
                  <span class="<%= notification_channel_status_class(channel) %>"><%= notification_channel_status_label(channel) %></span>
                </div>

                <div class="d-flex flex-wrap gap-2">
                  <%= link_to "Изменить", edit_notification_channel_path(channel), class: "btn btn-outline-secondary btn-sm" %>
                  <%= button_to "Тест",
                                test_notification_channel_path(channel),
                                method: :post,
                                class: "btn btn-outline-primary btn-sm" %>
                  <%= button_to "Удалить",
                                notification_channel_path(channel),
                                method: :delete,
                                class: "btn btn-outline-danger btn-sm",
                                form: { onsubmit: "return confirm('Удалить канал уведомлений?')" } %>
                </div>
              </article>
            <% end %>
          </div>
        <% else %>
          <div class="empty-state-inline">
            <h3 class="h5 mb-2">Каналы не настроены</h3>
            <p class="text-muted mb-3">Без настройки PetJournal отправит напоминания на эл. почту аккаунта. Добавьте Telegram, VK или push, если нужен другой канал.</p>
            <%= link_to "Добавить канал", new_notification_channel_path, class: "btn btn-primary btn-sm" %>
          </div>
        <% end %>
      </div>

      <div class="workspace-section mt-4">
        <div class="section-heading">
          <div>
            <div class="text-muted small mb-1">Журнал</div>
            <h2 class="h4 mb-0">Последние отправки</h2>
          </div>
        </div>

        <%= form_with url: notification_channels_path, method: :get, class: "journal-filter-form mb-3" do |form| %>
          <div class="journal-filter-fields">
            <div class="journal-filter-field">
              <%= label_tag :delivery_status, "Статус отправки" %>
              <%= select_tag :delivery_status,
                             options_for_select(
                               notification_delivery_filter_options(@delivery_counts).map { |label, value, count| ["#{label} (#{count})", value] },
                               @selected_delivery_status
                             ),
                             class: "form-select" %>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-2 align-items-center">
            <%= form.submit "Применить", class: "btn btn-outline-primary" %>
            <% if @selected_delivery_status != "all" %>
              <%= link_to "Сбросить фильтры", notification_channels_path, class: "journal-filter-reset" %>
            <% end %>
          </div>
        <% end %>

        <% if @deliveries.any? %>
          <div class="delivery-list">
            <% @deliveries.each do |delivery| %>
              <div class="delivery-row">
                <div>
                  <div class="fw-semibold"><%= delivery.reminder.pet.name %> · <%= delivery.reminder.title %></div>
                  <div class="text-muted small"><%= delivery.notification_channel.channel_type_label %> · <%= l(delivery.created_at) %></div>
                  <div class="text-muted small">Попытки: <%= delivery.attempts_label %></div>
                  <% if delivery.next_attempt_at.present? %>
                    <div class="text-muted small">Повтор: <%= l(delivery.next_attempt_at) %></div>
                  <% end %>
                  <% if delivery.error_message.present? %>
                    <div class="text-danger small"><%= delivery.error_message %></div>
                  <% end %>
                </div>
                <div class="d-flex flex-column align-items-end gap-2">
                  <span class="<%= notification_delivery_status_class(delivery) %>"><%= notification_delivery_status_label(delivery) %></span>
                  <% if delivery.status_failed? || delivery.status_skipped? %>
                    <%= button_to "Повторить",
                                  retry_delivery_notification_channels_path(delivery_id: delivery),
                                  method: :post,
                                  class: "btn btn-outline-primary btn-sm" %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted mb-0">История появится после первой отправки или теста канала.</p>
        <% end %>
      </div>
    </section>

    <aside class="col-lg-4">
      <div class="action-panel mb-4">
        <div class="text-muted small mb-1">Тихие часы</div>
        <h2 class="h4 mb-3">Пауза на ночь</h2>
        <%= form_with model: current_user,
                      url: settings_notification_channels_path,
                      method: :patch,
                      class: "quiet-hours-form" do |form| %>
          <div class="form-check form-switch mb-3">
            <%= form.check_box :notifications_quiet_hours_enabled, class: "form-check-input", role: "switch" %>
            <%= form.label :notifications_quiet_hours_enabled, "Не отправлять в тихие часы", class: "form-check-label" %>
          </div>

          <div class="row g-2">
            <div class="col-6">
              <%= form.label :notifications_quiet_hours_start, "С", class: "form-label" %>
              <%= form.time_field :notifications_quiet_hours_start, class: "form-control" %>
            </div>
            <div class="col-6">
              <%= form.label :notifications_quiet_hours_end, "До", class: "form-label" %>
              <%= form.time_field :notifications_quiet_hours_end, class: "form-control" %>
            </div>
            <div class="col-12">
              <%= form.label :notifications_time_zone, "Часовой пояс", class: "form-label" %>
              <%= form.time_zone_select :notifications_time_zone, nil, {}, class: "form-select" %>
            </div>
          </div>

          <%= form.submit "Сохранить", class: "btn btn-outline-primary btn-sm mt-3" %>
        <% end %>
      </div>

      <div class="action-panel mb-4" data-web-push-panel data-vapid-public-key="<%= @vapid_public_key %>">
        <div class="text-muted small mb-1">Push</div>
        <h2 class="h4 mb-3">Уведомления в браузере</h2>
        <% if @vapid_public_key.present? %>
          <p class="text-muted mb-3">Включите уведомления в этом браузере. Подписка сохранится как отдельный канал.</p>
          <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-primary btn-sm" data-web-push-enable>Включить push</button>
            <button type="button" class="btn btn-outline-danger btn-sm" data-web-push-disable>Отключить push</button>
          </div>
          <p class="form-text mt-2 mb-0" data-web-push-status></p>
        <% else %>
          <p class="text-muted mb-0">Push-уведомления пока недоступны. Вы можете использовать email, Telegram или VK.</p>
        <% end %>
      </div>

      <div class="action-panel">
        <div class="text-muted small mb-1">Подключение</div>
        <h2 class="h4 mb-3">Как включить каналы</h2>
        <div class="compact-list">
          <% notification_channel_onboarding_steps.each do |title, body| %>
            <div class="onboarding-row">
              <span><%= title %></span>
              <strong><%= body %></strong>
            </div>
          <% end %>
        </div>
      </div>
    </aside>
  </div>
</div>
