<% content_for :title, "Уведомления — PetJournal" %>

<div class="pj-notifications-page">
  <header class="pj-workspace-topbar">
    <h1>Уведомления</h1>
  </header>

  <div class="pj-notifications-content">
    <div class="pj-notifications-heading">
      <div>
        <h1>Каналы уведомлений</h1>
        <p>Выберите, куда PetJournal будет отправлять напоминания и важные сигналы.</p>
      </div>
      <%= link_to new_notification_channel_path, class: "pj-notifications-primary-button" do %>
        <%= pj_icon(:plus) %><span>Добавить канал</span>
      <% end %>
    </div>

    <section class="pj-notifications-section" aria-labelledby="notification-channels-title">
      <div class="pj-notifications-section__head">
        <div>
          <span class="pj-notifications-eyebrow">Доставка</span>
          <h2 id="notification-channels-title">Подключённые каналы</h2>
        </div>
        <div class="pj-notifications-summary" aria-label="Сводка по каналам">
          <span><strong><%= @channels.count %></strong> всего</span>
          <span><strong><%= @channels.count(&:enabled?) %></strong> включено</span>
        </div>
      </div>

      <% if @channels.any? %>
        <div class="pj-notifications-channel-grid">
          <% @channels.each do |channel| %>
            <article class="pj-notifications-channel-card">
              <div class="pj-notifications-channel-card__icon pj-notifications-channel-card__icon--<%= channel.channel_type %>">
                <%= notification_channel_icon(channel) %>
              </div>

              <div class="pj-notifications-channel-card__body">
                <div class="pj-notifications-channel-card__title-row">
                  <div>
                    <span><%= channel.channel_type_label %></span>
                    <h3><%= channel.name %></h3>
                  </div>
                  <span class="pj-notifications-status <%= channel.enabled? && channel.ready_for_delivery? ? "is-success" : channel.enabled? ? "is-warning" : "is-muted" %>">
                    <%= notification_channel_status_label(channel) %>
                  </span>
                </div>

                <p class="pj-notifications-channel-card__address"><%= notification_channel_display_address(channel) %></p>
                <p class="pj-notifications-channel-card__config <%= "is-problem" unless channel.ready_for_delivery? %>">
                  <%= notification_channel_configuration_label(channel) %>
                </p>
              </div>

              <details class="pj-notifications-channel-actions">
                <summary aria-label="Действия с каналом <%= channel.name %>" title="Действия">•••</summary>
                <div class="pj-notifications-channel-actions__menu">
                  <%= link_to edit_notification_channel_path(channel) do %>
                    <span>Изменить</span>
                  <% end %>
                  <%= button_to test_notification_channel_path(channel), method: :post do %>
                    <span>Тестовая отправка</span>
                  <% end %>
                  <div class="pj-notifications-channel-actions__separator" aria-hidden="true"></div>
                  <%= button_to notification_channel_path(channel),
                                method: :delete,
                                class: "is-danger",
                                form: { data: { turbo_confirm: "Удалить канал уведомлений?" } } do %>
                    <span>Удалить</span>
                  <% end %>
                </div>
              </details>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="pj-notifications-empty">
          <span class="pj-notifications-empty__icon"><%= pj_icon(:bell) %></span>
          <div>
            <h3>Каналы ещё не настроены</h3>
            <p>Без дополнительных настроек PetJournal использует эл. почту аккаунта. Telegram, VK и push можно подключить в любой момент.</p>
          </div>
          <%= link_to "Добавить канал", new_notification_channel_path, class: "pj-notifications-secondary-button" %>
        </div>
      <% end %>
    </section>

    <div class="pj-notifications-settings-grid">
      <section class="pj-notifications-panel" aria-labelledby="quiet-hours-title">
        <div class="pj-notifications-panel__heading">
          <span class="pj-notifications-panel__icon"><%= pj_icon(:clock) %></span>
          <div>
            <span class="pj-notifications-eyebrow">Спокойствие</span>
            <h2 id="quiet-hours-title">Тихие часы</h2>
            <p>PetJournal не будет отправлять напоминания в выбранный период.</p>
          </div>
        </div>

        <%= form_with model: current_user,
                      url: settings_notification_channels_path,
                      method: :patch,
                      class: "pj-notifications-quiet-form" do |form| %>
          <label class="pj-notifications-toggle-row">
            <span>
              <strong>Не отправлять в тихие часы</strong>
              <small>Отложенные отправки продолжатся после окончания периода.</small>
            </span>
            <span class="pj-notifications-switch">
              <%= form.check_box :notifications_quiet_hours_enabled %>
              <span aria-hidden="true"></span>
            </span>
          </label>

          <div class="pj-notifications-quiet-fields">
            <div class="pj-notifications-field">
              <%= form.label :notifications_quiet_hours_start, "С" %>
              <%= form.time_field :notifications_quiet_hours_start %>
            </div>
            <div class="pj-notifications-field">
              <%= form.label :notifications_quiet_hours_end, "До" %>
              <%= form.time_field :notifications_quiet_hours_end %>
            </div>
            <div class="pj-notifications-field pj-notifications-field--wide">
              <%= form.label :notifications_time_zone, "Часовой пояс" %>
              <%= form.time_zone_select :notifications_time_zone %>
            </div>
          </div>

          <div class="pj-notifications-panel__actions">
            <%= form.submit "Сохранить тихие часы", class: "pj-notifications-secondary-button" %>
          </div>
        <% end %>
      </section>

      <section class="pj-notifications-panel" data-web-push-panel data-vapid-public-key="<%= @vapid_public_key %>" aria-labelledby="web-push-title">
        <div class="pj-notifications-panel__heading">
          <span class="pj-notifications-panel__icon"><%= notification_channel_icon(:web_push) %></span>
          <div>
            <span class="pj-notifications-eyebrow">Этот браузер</span>
            <h2 id="web-push-title">Web Push</h2>
            <p>Получайте быстрые уведомления прямо на этом устройстве.</p>
          </div>
        </div>

        <% if @vapid_public_key.present? %>
          <div class="pj-notifications-push-actions">
            <button type="button" class="pj-notifications-primary-button" data-web-push-enable>Включить push</button>
            <button type="button" class="pj-notifications-secondary-button" data-web-push-disable>Отключить</button>
          </div>
          <p class="pj-notifications-push-status" data-web-push-status>Браузер запросит разрешение только после нажатия «Включить push».</p>
        <% else %>
          <div class="pj-notifications-inline-note is-warning">
            Push пока недоступен: на сервере не настроены VAPID-ключи. Email, Telegram и VK продолжают работать.
          </div>
        <% end %>
      </section>
    </div>

    <section class="pj-notifications-section pj-notifications-history" aria-labelledby="delivery-history-title">
      <div class="pj-notifications-section__head pj-notifications-history__head">
        <div>
          <span class="pj-notifications-eyebrow">Журнал</span>
          <h2 id="delivery-history-title">История отправок</h2>
          <p>Последние 50 доставок напоминаний, включая ошибки и повторные попытки.</p>
        </div>

        <%= form_with url: notification_channels_path, method: :get, class: "pj-notifications-history-filter" do |form| %>
          <%= label_tag :delivery_status, "Статус", class: "visually-hidden" %>
          <%= select_tag :delivery_status,
                         options_for_select(
                           notification_delivery_filter_options(@delivery_counts).map { |label, value, count| ["#{label} · #{count}", value] },
                           @selected_delivery_status
                         ) %>
          <%= form.submit "Применить", class: "pj-notifications-secondary-button" %>
          <% if @selected_delivery_status != "all" %>
            <%= link_to "Сбросить", notification_channels_path, class: "pj-notifications-filter-reset" %>
          <% end %>
        <% end %>
      </div>

      <% if @deliveries.any? %>
        <div class="pj-notifications-delivery-table">
          <div class="pj-notifications-delivery-table__head" aria-hidden="true">
            <span>Дата и время</span>
            <span>Канал</span>
            <span>Напоминание</span>
            <span>Попытки</span>
            <span>Статус</span>
            <span></span>
          </div>

          <% @deliveries.each do |delivery| %>
            <article class="pj-notifications-delivery-row">
              <div class="pj-notifications-delivery-row__date">
                <strong><%= l(delivery.created_at, format: :short) %></strong>
                <% if delivery.next_attempt_at.present? %>
                  <small>Повтор: <%= l(delivery.next_attempt_at, format: :short) %></small>
                <% end %>
              </div>

              <div class="pj-notifications-delivery-row__channel">
                <span class="pj-notifications-delivery-row__icon"><%= notification_channel_icon(delivery.notification_channel) %></span>
                <span>
                  <strong><%= delivery.notification_channel.channel_type_label %></strong>
                  <small><%= notification_channel_display_address(delivery.notification_channel) %></small>
                </span>
              </div>

              <div class="pj-notifications-delivery-row__reminder">
                <strong><%= delivery.reminder.title %></strong>
                <small><%= delivery.reminder.pet.name %></small>
                <% if delivery.error_message.present? %>
                  <small class="is-error"><%= delivery.error_message %></small>
                <% end %>
              </div>

              <div class="pj-notifications-delivery-row__attempts"><%= delivery.attempts_label %></div>

              <div>
                <span class="pj-notifications-status <%= delivery.status_sent? ? "is-success" : delivery.status_failed? ? "is-error" : delivery.status_skipped? ? "is-muted" : "is-warning" %>">
                  <%= notification_delivery_status_label(delivery) %>
                </span>
              </div>

              <div class="pj-notifications-delivery-row__action">
                <% if delivery.status_failed? || delivery.status_skipped? %>
                  <%= button_to "Повторить",
                                retry_delivery_notification_channels_path(delivery_id: delivery),
                                method: :post,
                                class: "pj-notifications-text-button" %>
                <% end %>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="pj-notifications-history-empty">
          <span><%= pj_icon(:bell) %></span>
          <div><strong>История пока пустая</strong><small>Здесь появятся отправки после первого напоминания или теста канала.</small></div>
        </div>
      <% end %>
    </section>

    <section class="pj-notifications-help" aria-labelledby="notification-help-title">
      <div>
        <span class="pj-notifications-eyebrow">Подключение</span>
        <h2 id="notification-help-title">Как работают каналы</h2>
      </div>
      <div class="pj-notifications-help__grid">
        <% notification_channel_onboarding_steps.each do |title, body| %>
          <div><strong><%= title %></strong><span><%= body %></span></div>
        <% end %>
      </div>
    </section>
  </div>
</div>
